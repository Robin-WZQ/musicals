      "timing": {
        "method": "matched-transcript-anchor",
        "anchorStart": 5852,
        "similarity": 0.747,
        "groupSize": 4
      }
    },
    {
      "start": 5854.143,
      "sourceText": "N'étais pas le même",
      "ipa": "[netɛ pa lə mɛm]",
      "ear": "内泰 帕 勒 梅姆",
      "meaning": "是昨日的我",
      "sourceIPA": "/netɛ pa lə mɛm/",
      "sourceLineId": "notre-dame-de-paris-39-007",
      "speaker": "",
      "timing": {
        "method": "matched-transcript-anchor",
        "anchorStart": 5852,
        "similarity": 0.747,
        "groupSize": 4
      }
    },
    {
      "start": 5856.286,
      "sourceText": "Qu'aujourd'hui celui",
      "ipa": "[koʒuʁdɥi səlɥi]",
      "ear": "科茹赫德于伊 瑟勒于伊",
      "meaning": "今日的我",
      "sourceIPA": "/kwɔdʒədhjui səlɥi/",
      "sourceLineId": "notre-dame-de-paris-39-008",
      "speaker": "",
      "timing": {
        "method": "matched-transcript-anchor",
        "anchorStart": 5852,
        "similarity": 0.747,
        "groupSize": 4
      }
    },
    {
      "start": 5858.857,
      "sourceText": "Qui te dit \"Je t'aime\"",
      "ipa": "[ki tə di ʒə tɛm]",
      "ear": "基 特 迪 热 泰姆",
      "meaning": "对你倾诉衷肠",
      "sourceIPA": "/ki tə di ʒə tɛm/",
      "sourceLineId": "notre-dame-de-paris-39-009",
      "speaker": "",
      "timing": {
        "method": "matched-transcript-anchor",
        "anchorStart": 5852,
        "similarity": 0.747,
        "groupSize": 4
      }
    },
    {
      "start": 5861,
      "sourceText": "Je me suis guéri le cœur et l'esprit",
      "ipa": "[ʒə mə sɥi ɡeʁi lə kœʁ e lɛspʁi]",
      "ear": "热 默 斯于伊 格希 勒 克厄赫 诶 莱斯普希",
      "meaning": "我的心神已然痊愈",
      "sourceIPA": "/ʒə mə sɥi ɡeʁi lə kœʁ e lɛspʁi/",
      "sourceLineId": "notre-dame-de-paris-39-010",
      "speaker": "",
      "timing": {
        "method": "matched-transcript-anchor",
        "anchorStart": 5861,
        "similarity": 0.69,
        "groupSize": 3
      }
    },
    {
      "start": 5866.0,
      "sourceText": "Si tu veux de moi",
      "ipa": "[si ty vø də mwa]",
      "ear": "西 蒂于 弗厄 德 姆乌阿",
      "meaning": "若你还能接纳我",
