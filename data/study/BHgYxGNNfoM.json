        "similarity": 0.224,
        "groupSize": 3
      }
    },
    {
      "start": 5847.909,
      "sourceText": "Dans ces méandres où j'ai frôlé la mort",
      "ipa": "[dɑ̃ se meɑ̃dʁ‿u ʒe fʁole la mɔʁ]",
      "ear": "当 塞 梅昂德赫 乌 热 弗霍莱 拉 莫赫",
      "meaning": "在迷宫里与死亡擦肩而过",
      "sourceIPA": "/dɑ̃ se meɑ̃dʁz u ʒe fʁole la mɔʁ/",
      "sourceLineId": "notre-dame-de-paris-39-005",
      "speaker": "",
      "timing": {
        "method": "matched-transcript-anchor",
        "anchorStart": 5843,
        "similarity": 0.224,
        "groupSize": 3
      }
    },
    {
      "start": 5852,
      "sourceText": "L'homme qui te trompait",
      "ipa": "[lɔm ki tə tʁɔ̃pɛ]",
      "ear": "洛姆 基 特 特洪佩",
      "meaning": "欺骗你的",
      "sourceIPA": "/lɔm ki tə tʁɔ̃pɛ/",
      "sourceLineId": "notre-dame-de-paris-39-006",
