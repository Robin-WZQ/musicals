      "sourceLineId": "mozart-timed-343-2",
      "suppliedText": "Mais tiens bon. Comment, monsieur Mozart, vous annulez nos répétitions? Je vous parle, Herr Mozart, est-il sourd?",
      "kind": "lyric-or-dialogue",
      "timing": {
        "method": "user-supplied-anchor-subdivision",
