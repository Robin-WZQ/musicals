      "timing": {
        "method": "supplied-timestamp-subdivision",
        "anchorStart": 8343,
        "sourceLineNumber": 792,
        "precision": "approximate"
      }
    },
    {
      "start": 8348.238,
      "sourceText": "Nous ont laissé leur faire",
      "ipa": "[nuz‿ɔ̃ lɛse lœʁ fɛʁ]",
      "ear": "努兹 翁 莱塞 勒厄赫 费赫",
      "meaning": "任由我们加在他们身上的伤害。",
      "suppliedText": "Nous ont laissé leur faire",
