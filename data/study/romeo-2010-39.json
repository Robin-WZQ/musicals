        "precision": "approximate"
      }
    },
    {
      "start": 8316.471,
      "sourceText": "Quand nos enfants sont morts",
      "ipa": "[kɑ̃ noz‿ɑ̃fɑ̃ sɔ̃ mɔʁ]",
      "ear": "康 诺兹 昂芳 松 莫赫",
      "meaning": "当我们的孩子已经死去。",
      "suppliedText": "Quand nos enfants sont morts",
      "sourceLineId": "romeo-timed-789-4",
      "speaker": "Lady Montaigu",
      "timing": {
        "method": "supplied-timestamp-subdivision",
        "anchorStart": 8310,
        "sourceLineNumber": 789,
        "precision": "approximate"
      }
    },
    {
      "start": 8321,
      "sourceText": "Et que Dieu et les hommes",
      "ipa": "[e kə djø e lez‿ɔm]",
      "ear": "诶 克 德耶厄 诶 莱兹 哦姆",
      "meaning": "愿上帝，愿世人。",
      "suppliedText": "Et que Dieu et les hommes",
      "sourceLineId": "romeo-timed-790-5",
      "speaker": "Lady Montaigu",
      "timing": {
        "method": "supplied-timestamp-subdivision",
        "anchorStart": 8321,
        "sourceLineNumber": 790,
        "precision": "approximate"
      }
    },
    {
      "start": 8326.5,
      "sourceText": "Voient ce que nous sommes",
      "ipa": "[vwa sə kə nu sɔm]",
      "ear": "弗乌阿 瑟 克 努 索姆",
      "meaning": "看清我们是什么样的人。",
      "suppliedText": "Voient ce que nous sommes",
      "sourceLineId": "romeo-timed-790-6",
      "speaker": "Lady Montaigu",
      "timing": {
        "method": "supplied-timestamp-subdivision",
        "anchorStart": 8321,
        "sourceLineNumber": 790,
        "precision": "approximate"
      }
    },
    {
      "start": 8332,
      "sourceText": "Que leurs âmes de cristal",
      "ipa": "[kə lœʁz‿am də kʁistal]",
      "ear": "克 勒厄赫兹 阿姆 德 克希斯塔勒",
      "meaning": "愿他们水晶般的灵魂。",
      "suppliedText": "Que leurs âmes de cristal",
      "sourceLineId": "romeo-timed-791-7",
