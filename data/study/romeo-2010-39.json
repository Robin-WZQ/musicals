      "timing": {
        "method": "supplied-timestamp-subdivision",
        "anchorStart": 8332,
        "sourceLineNumber": 791,
        "precision": "approximate"
      }
    },
    {
      "start": 8337.5,
      "sourceText": "Nous pardonnent pour le mal",
      "ipa": "[nu paʁdɔn puʁ lə mal]",
      "ear": "努 帕赫多恩 普赫 勒 玛勒",
      "meaning": "宽恕我们犯下的伤害。",
      "suppliedText": "Nous pardonnent pour le mal",
      "sourceLineId": "romeo-timed-791-8",
      "speaker": "Lady Capulet",
      "timing": {
        "method": "supplied-timestamp-subdivision",
        "anchorStart": 8332,
        "sourceLineNumber": 791,
        "precision": "approximate"
      }
    },
    {
      "start": 8343,
      "sourceText": "Que nos dieux en colère",
      "ipa": "[kə no djø ɑ̃ kolɛʁ]",
      "ear": "克 诺 德耶厄 昂 科莱赫",
      "meaning": "那些愤怒的神。",
      "suppliedText": "Que nos dieux en colère",
