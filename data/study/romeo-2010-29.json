      "timing": {
        "method": "supplied-timestamp-subdivision",
        "anchorStart": 6080,
        "sourceLineNumber": 576,
        "precision": "approximate"
      }
    },
    {
      "start": 6094,
      "sourceText": "Demain, demain, demain,",
