        "method": "user-supplied-anchor-subdivision",
        "anchorStart": 5365,
        "anchorEnd": 5373,
        "sourceLineNumber": 582,
        "precision": "approximate"
      }
    },
    {
      "start": 5366.778,
      "sourceText": "Je voue mes nuits",
