      }
    },
    {
      "start": 5334,
      "sourceText": "La folie me guette",
      "ipa": "[la foli mə ɡɛt]",
      "ear": "拉 佛利 默 盖特",
      "meaning": "疯狂正等着我。",
      "sourceLineId": "mozart-timed-578-1",
      "suppliedText": "La folie me guette Je suis ce que je fuis",
      "kind": "lyric-or-dialogue",
      "timing": {
