        "precision": "approximate"
      }
    },
    {
      "start": 5365,
      "sourceText": "Ses peines",
      "ipa": "[se pɛn]",
      "ear": "塞 佩恩",
      "meaning": "自己的痛苦。",
      "sourceLineId": "mozart-timed-582-1",
      "suppliedText": "Ses peines Je voue mes nuits À l'Assasymphonie",
      "kind": "lyric-or-dialogue",
