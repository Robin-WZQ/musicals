        "anchorStart": 5373,
        "anchorEnd": 5383,
        "sourceLineNumber": 583,
        "precision": "approximate"
      }
    },
    {
      "start": 5376.529,
      "sourceText": "Tuant par dépit",
      "ipa": "[tyɑ̃ paʁ depi]",
      "ear": "蒂于昂 帕赫 德皮",
      "meaning": "在愤恨中杀死——",
      "sourceLineId": "mozart-timed-583-2",
      "suppliedText": "Aux requiems Tuant par dépit Ce que je sème",
