        "anchorEnd": 5341,
        "sourceLineNumber": 578,
        "precision": "approximate"
      }
    },
    {
      "start": 5341,
      "sourceText": "Je subis cette cacophonie",
      "ipa": "[ʒə sybi sɛt kakofoni]",
      "ear": "热 西于比 塞特 卡科佛尼",
      "meaning": "我忍受着这刺耳的喧响。",
      "sourceLineId": "mozart-timed-579-1",
      "suppliedText": "Je subis cette cacophonie Qui me scie la tête",
      "kind": "lyric-or-dialogue",
      "timing": {
        "method": "user-supplied-anchor-subdivision",
        "anchorStart": 5341,
        "anchorEnd": 5348,
        "sourceLineNumber": 579,
        "precision": "approximate"
      }
    },
    {
      "start": 5344.889,
      "sourceText": "Qui me scie la tête",
      "ipa": "[ki mə si la tɛt]",
      "ear": "基 默 西 拉 泰特",
      "meaning": "它把我的脑袋锯得生疼。",
      "sourceLineId": "mozart-timed-579-2",
      "suppliedText": "Je subis cette cacophonie Qui me scie la tête",
      "kind": "lyric-or-dialogue",
      "timing": {
        "method": "user-supplied-anchor-subdivision",
        "anchorStart": 5341,
        "anchorEnd": 5348,
        "sourceLineNumber": 579,
        "precision": "approximate"
      }
    },
    {
      "start": 5348,
      "sourceText": "Assommante harmonie",
      "ipa": "[asɔmɑ̃t‿aʁmoni]",
      "ear": "阿索芒特 阿赫莫尼",
      "meaning": "令人昏沉的和声。",
      "sourceLineId": "mozart-timed-580-1",
      "suppliedText": "Assommante harmonie Elle me dit tu paieras tes délits",
      "kind": "lyric-or-dialogue",
      "timing": {
        "method": "user-supplied-anchor-subdivision",
        "anchorStart": 5348,
        "anchorEnd": 5356,
        "sourceLineNumber": 580,
        "precision": "approximate"
      }
    },
    {
      "start": 5351.2,
      "sourceText": "Elle me dit tu paieras tes délits",
      "ipa": "[ɛl mə di ty pɛʁa te deli]",
      "ear": "艾勒 默 迪 蒂于 佩哈 特 德利",
