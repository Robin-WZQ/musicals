        "precision": "approximate"
      }
    },
    {
      "start": 5373,
      "sourceText": "Aux requiems",
      "ipa": "[o ʁekɥijɛm]",
      "ear": "奥 赫克于伊耶艾姆",
      "meaning": "献给那些安魂曲。",
      "sourceLineId": "mozart-timed-583-1",
      "suppliedText": "Aux requiems Tuant par dépit Ce que je sème",
