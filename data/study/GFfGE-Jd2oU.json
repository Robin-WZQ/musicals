        "similarity": 0.584,
        "groupSize": 2
      }
    },
    {
      "start": 4156.9,
      "sourceText": "Que le terre serait ronde",
      "ipa": "[kə lə tɛʁ səʁɛ ʁɔ̃d]",
      "ear": "克 勒 泰赫 瑟赫 洪德",
      "meaning": "地球是圆的",
      "sourceIPA": "/kə lə tɛʁ səʁɛ ʁɔ̃d/",
      "sourceLineId": "notre-dame-de-paris-29-006",
      "speaker": "",
      "timing": {
        "method": "matched-transcript-anchor",
        "anchorStart": 4153,
        "similarity": 0.584,
        "groupSize": 2
      }
    },
    {
      "start": 4161,
      "sourceText": "Et qu'il y aurait un autre",
      "ipa": "[e kil‿i oʁɛ œ̃n‿otʁ]",
      "ear": "诶 基勒 伊 奥赫 恩恩 奥特赫",
      "meaning": "还有其他的大陆",
      "sourceIPA": "/e kil i oʁɛt œ̃n otʁ/",
      "sourceLineId": "notre-dame-de-paris-29-007",
      "speaker": "",
      "timing": {
        "method": "matched-transcript-anchor",
        "anchorStart": 4161,
        "similarity": 0.545,
        "groupSize": 2
      }
    },
    {
      "start": 4165.55,
      "sourceText": "Continent en ce monde",
