    {
      "start": 4153,
      "sourceText": "A Florence on raconte",
      "ipa": "[a floʁɑ̃s‿ɔ̃ ʁakɔ̃t]",
      "ear": "阿 弗洛杭斯 翁 哈孔特",
      "meaning": "佛罗伦斯有人说",
      "sourceIPA": "/a floʁɑ̃s ɔ̃ ʁakɔ̃t/",
      "sourceLineId": "notre-dame-de-paris-29-005",
