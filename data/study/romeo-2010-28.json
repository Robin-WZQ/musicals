        "anchorStart": 5920,
        "sourceLineNumber": 559,
        "precision": "approximate"
      }
    },
    {
      "start": 5926.0,
      "sourceText": "Vivre sans toi",
      "ipa": "[vivʁ sɑ̃ twa]",
      "ear": "维弗赫 桑 特乌阿",
      "meaning": "没有你，独自活着。",
