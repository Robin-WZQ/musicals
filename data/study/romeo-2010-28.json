      "suppliedText": "Voilà ce que vous êtes !",
      "sourceLineId": "romeo-timed-570-31",
      "speaker": "Nourrice",
      "timing": {
        "method": "supplied-timestamp-subdivision",
        "anchorStart": 6038,
        "sourceLineNumber": 570,
        "precision": "approximate"
      }
    },
    {
      "start": 6039.667,
      "sourceText": "Et moi, moi je me perds avec vous !",
      "ipa": "[e mwa mwa ʒə mə pɛʁ‿avɛk vu]",
      "ear": "诶 姆乌阿 姆乌阿 热 默 佩赫 阿韦克 乌",
