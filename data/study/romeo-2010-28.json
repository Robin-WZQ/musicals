      "speaker": "Juliette",
      "timing": {
        "method": "supplied-timestamp-subdivision",
        "anchorStart": 5920,
        "sourceLineNumber": 559,
        "precision": "approximate"
      }
    },
    {
      "start": 5929,
      "sourceText": "T'aimer, t'aimer",
      "ipa": "[tɛme tɛme]",
      "ear": "泰梅 泰梅",
