        "anchorStart": 5910,
        "sourceLineNumber": 558,
        "precision": "approximate"
      }
    },
    {
      "start": 5920,
      "sourceText": "Je ne veux pas",
      "ipa": "[ʒə nə vø pa]",
      "ear": "热 讷 弗厄 帕",
