      }
    },
    {
      "start": 6041.833,
      "sourceText": "Nourrice, pourquoi ?",
      "ipa": "[nuʁis puʁkwa]",
      "ear": "努希斯 普赫克乌阿",
      "meaning": "奶妈，为什么？",
      "suppliedText": "Nourrice, pourquoi ?",
      "sourceLineId": "romeo-timed-570-34",
      "speaker": "Juliette",
      "timing": {
        "method": "supplied-timestamp-subdivision",
        "anchorStart": 6038,
        "sourceLineNumber": 570,
        "precision": "approximate"
      }
    },
    {
      "start": 6043.333,
      "sourceText": "Pourquoi on nous laisse pas nous aimer, pourquoi ?!",
      "ipa": "[puʁkwa ɔ̃ nu lɛs pa nuz‿ɛme puʁkwa]",
      "ear": "普赫克乌阿 翁 努 莱斯 帕 努兹 艾梅 普赫克乌阿",
      "meaning": "为什么不让我们相爱，为什么？！",
      "suppliedText": "Pourquoi on nous laisse pas nous aimer, pourquoi ?!",
      "sourceLineId": "romeo-timed-570-35",
      "speaker": "Juliette",
      "timing": {
        "method": "supplied-timestamp-subdivision",
        "anchorStart": 6038,
        "sourceLineNumber": 570,
        "precision": "approximate"
      }
    },
    {
      "start": 6047,
      "sourceText": "C’est cette ville, ma reine, elle nous tuera tous.",
