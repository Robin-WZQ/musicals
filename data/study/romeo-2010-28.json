        "anchorStart": 5920,
        "sourceLineNumber": 559,
        "precision": "approximate"
      }
    },
    {
      "start": 5923.0,
      "sourceText": "Je ne peux pas",
      "ipa": "[ʒə nə pø pa]",
      "ear": "热 讷 珀厄 帕",
