      "timing": {
        "method": "supplied-timestamp-subdivision",
        "anchorStart": 6029,
        "sourceLineNumber": 569,
        "precision": "approximate"
      }
    },
    {
      "start": 6029.837,
      "sourceText": "Juliette, vite, dépêche-toi, ta mère arrive !",
      "ipa": "[ʒyljɛt vit depɛʃtwa ta mɛʁ‿aʁiv]",
      "ear": "日于勒耶艾特 维特 德佩什特乌阿 塔 梅赫 阿希弗",
      "meaning": "朱丽叶，快点，你母亲来了！",
      "suppliedText": "Juliette, vite, dépêche-toi, ta mère arrive !",
      "sourceLineId": "romeo-timed-569-28",
      "speaker": "Nourrice",
      "timing": {
        "method": "supplied-timestamp-subdivision",
        "anchorStart": 6029,
        "sourceLineNumber": 569,
        "precision": "approximate"
      }
    },
    {
      "start": 6033.395,
      "sourceText": "Et si elle vous trouve ici, vous êtes perdus !",
      "ipa": "[e si ɛl vu tʁuv‿isi vuz‿ɛt pɛʁdy]",
      "ear": "诶 西 艾勒 乌 特胡弗 伊西 乌兹 艾特 佩赫迪于",
      "meaning": "她若看见你们在这里，你们就完了！",
      "suppliedText": "Et si elle vous trouve ici, vous êtes perdus !",
      "sourceLineId": "romeo-timed-569-29",
      "speaker": "Nourrice",
      "timing": {
        "method": "supplied-timestamp-subdivision",
        "anchorStart": 6029,
        "sourceLineNumber": 569,
        "precision": "approximate"
      }
    },
    {
      "start": 6036.953,
      "sourceText": "Des enfants perdus !",
      "ipa": "[dez‿ɑ̃fɑ̃ pɛʁdy]",
      "ear": "德兹 昂芳 佩赫迪于",
      "meaning": "迷失的孩子！",
      "suppliedText": "Des enfants perdus !",
      "sourceLineId": "romeo-timed-569-30",
      "speaker": "Nourrice",
      "timing": {
        "method": "supplied-timestamp-subdivision",
        "anchorStart": 6029,
        "sourceLineNumber": 569,
        "precision": "approximate"
      }
    },
    {
      "start": 6038,
      "sourceText": "Voilà ce que vous êtes !",
