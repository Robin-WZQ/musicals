    {
      "start": 7010.581,
      "sourceText": "Soldat du roi, je vous exhorte",
      "ipa": "[sɔlda dy ʁwa ʒə vuz‿ɛɡzɔʁt]",
      "ear": "索勒达 迪于 赫乌阿 热 乌兹 艾格佐赫特",
      "meaning": "国王的军人 我敦促你们",
      "sourceIPA": "/sɔlda dy ʁwa ʒə vuz ɛɡzɔʁt/",
      "sourceLineId": "notre-dame-de-paris-47-006",
      "speaker": "Frollo",
      "timing": {
        "method": "matched-transcript-anchor",
        "anchorStart": 7010,
        "similarity": 0.666,
        "groupSize": 5
      }
    },
    {
      "start": 7012.903,
      "sourceText": "A franchir cette porte (Asile!)",
      "ipa": "[a fʁɑ̃ʃiʁ sɛt pɔʁt‿azil]",
      "ear": "阿 弗杭希赫 塞特 珀赫特 阿齐勒",
      "meaning": "进入此门",
      "sourceIPA": "/a fʁɑ̃ʃiʁ sɛt pɔʁt azil/",
      "sourceLineId": "notre-dame-de-paris-47-007",
      "speaker": "",
      "timing": {
        "method": "matched-transcript-anchor",
        "anchorStart": 7010,
        "similarity": 0.666,
        "groupSize": 5
      }
    },
    {
      "start": 7014.935,
      "sourceText": "En votre âme et conscience",
      "ipa": "[ɑ̃ votʁ‿am e kɔ̃sjɑ̃s]",
      "ear": "昂 沃特赫 阿姆 诶 孔斯耶昂斯",
      "meaning": "以各位的灵魂与良知",
      "sourceIPA": "/ɑ̃ votʁ am e kɔ̃sjɑ̃s/",
      "sourceLineId": "notre-dame-de-paris-47-008",
      "speaker": "",
      "timing": {
        "method": "matched-transcript-anchor",
        "anchorStart": 7010,
        "similarity": 0.666,
        "groupSize": 5
      }
    },
    {
      "start": 7016.677,
      "sourceText": "Au nom de la décence (Asile!)",
      "ipa": "[o nɔ̃ də la desɑ̃s‿azil]",
      "ear": "奥 农 德 拉 德桑斯 阿齐勒",
      "meaning": "以正义之名义（收容！）",
      "sourceIPA": "/o nɔ̃ də la desɑ̃s azil/",
      "sourceLineId": "notre-dame-de-paris-47-009",
      "speaker": "",
      "timing": {
        "method": "matched-transcript-anchor",
        "anchorStart": 7010,
        "similarity": 0.666,
        "groupSize": 5
      }
    },
    {
      "start": 7019,
      "sourceText": "Je vous donne le droit",
      "ipa": "[ʒə vu dɔn lə dʁwa]",
      "ear": "热 乌 多恩 勒 德赫乌阿",
      "meaning": "我给予各位权力",
      "sourceIPA": "/ʒə vu dɔn lə dʁwa/",
      "sourceLineId": "notre-dame-de-paris-47-010",
      "speaker": "",
      "timing": {
        "method": "matched-transcript-anchor",
        "anchorStart": 7019,
        "similarity": 0.802,
        "groupSize": 2
      }
    },
    {
      "start": 7022.25,
      "sourceText": "D'enfreindre le droit (Asile!)",
      "ipa": "[dɑ̃fʁɛ̃dʁ lə dʁwa azil]",
      "ear": "当弗汉德赫 勒 德赫乌阿 阿齐勒",
      "meaning": "剥夺他们的权利（收容！）",
      "sourceIPA": "/dɑ̃fʁɛ̃dʁ lə dʁwa azil/",
      "sourceLineId": "notre-dame-de-paris-47-011",
      "speaker": "",
      "timing": {
        "method": "matched-transcript-anchor",
        "anchorStart": 7019,
        "similarity": 0.802,
        "groupSize": 2
      }
    },
    {
      "start": 7031,
      "sourceText": "D'asile! (Asile!)",
      "ipa": "[dazil azil]",
      "ear": "达齐勒 阿齐勒",
      "meaning": "他们要求的收容（收容！）",
