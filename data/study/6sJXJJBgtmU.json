        "anchorStart": 606,
        "similarity": 0.697,
        "groupSize": 2
      }
    },
    {
      "start": 614,
      "sourceText": "Et des brigands dans les montagnes",
      "ipa": "[e de bʁiɡɑ̃ dɑ̃ le mɔ̃tanj]",
