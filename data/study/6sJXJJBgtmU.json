        "method": "matched-transcript-anchor",
        "anchorStart": 606,
        "similarity": 0.697,
        "groupSize": 2
      }
    },
    {
      "start": 610.267,
      "sourceText": "Comme si c'était son pays",
      "ipa": "[kɔm si setɛ sɔ̃ pɛi]",
      "ear": "科姆 西 塞泰 松 佩伊",
      "meaning": "好像那里就是她的故乡",
      "sourceIPA": "/kɔm si setɛ sɔ̃ pɛi/",
      "sourceLineId": "notre-dame-de-paris-05-016",
      "speaker": "",
      "timing": {
