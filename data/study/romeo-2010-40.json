      "timing": {
        "method": "supplied-timestamp-subdivision",
        "anchorStart": 8679,
        "sourceLineNumber": 824,
        "precision": "approximate"
      }
    },
    {
      "start": 8681.4,
      "sourceText": "La vie devant nous,",
      "ipa": "[la vi dəvɑ̃ nu]",
      "ear": "拉 维 德旺 努",
      "meaning": "人生却还在前方。",
      "suppliedText": "La vie devant nous,",
