      "timing": {
        "method": "supplied-timestamp-subdivision",
        "anchorStart": 8679,
        "sourceLineNumber": 824,
        "precision": "approximate"
      }
    },
    {
      "start": 8687,
      "sourceText": "Nous, on veut pas d'médailles,",
      "ipa": "[nu ɔ̃ vø pa də medaj]",
      "ear": "努 翁 弗厄 帕 德 梅达耶",
      "meaning": "我们不想要勋章。",
