      "speaker": "",
      "timing": {
        "method": "supplied-timestamp-subdivision",
        "anchorStart": 8687,
        "sourceLineNumber": 825,
        "precision": "approximate"
      }
    },
    {
      "start": 8695.069,
      "sourceText": "On s'battra",
      "ipa": "[ɔ̃ sbatʁa]",
      "ear": "翁 斯巴特哈",
      "meaning": "我们会去战斗。",
      "suppliedText": "On s'battra",
      "sourceLineId": "romeo-timed-825-19",
      "speaker": "",
      "timing": {
        "method": "supplied-timestamp-subdivision",
        "anchorStart": 8687,
        "sourceLineNumber": 825,
        "precision": "approximate"
      }
    },
    {
      "start": 8696,
      "sourceText": "A 20 ans, rien ne vous tue, mais tout vous blesse",
      "ipa": "[a vɛ̃ ɑ̃ ʁjɛ̃ nə vu ty mɛ tu vu blɛs]",
      "ear": "阿 万 昂 赫耶安 讷 乌 蒂于 梅 图 乌 布莱斯",
      "meaning": "二十岁，什么都杀不了你，却什么都能伤到你。",
      "suppliedText": "A 20 ans, rien ne vous tue, mais tout vous blesse",
      "sourceLineId": "romeo-timed-826-20",
      "speaker": "",
      "timing": {
        "method": "supplied-timestamp-subdivision",
        "anchorStart": 8696,
        "sourceLineNumber": 826,
        "precision": "approximate"
      }
    },
    {
