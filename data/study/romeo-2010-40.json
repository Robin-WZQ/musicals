      "timing": {
        "method": "supplied-timestamp-subdivision",
        "anchorStart": 8687,
        "sourceLineNumber": 825,
        "precision": "approximate"
      }
    },
    {
      "start": 8690.103,
      "sourceText": "Pas gagner d'batailles,",
      "ipa": "[pa ɡanje də bataj]",
      "ear": "帕 嘎恩耶诶 德 巴塔耶",
      "meaning": "不想打赢战争。",
      "suppliedText": "Pas gagner d'batailles,",
