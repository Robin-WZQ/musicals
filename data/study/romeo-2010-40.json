        "anchorStart": 8687,
        "sourceLineNumber": 825,
        "precision": "approximate"
      }
    },
    {
      "start": 8692.276,
      "sourceText": "Mais pour ce qu'on croit",
      "ipa": "[mɛ puʁ sə kɔ̃ kʁwa]",
      "ear": "梅 普赫 瑟 孔 克赫乌阿",
      "meaning": "但为了自己相信的事。",
      "suppliedText": "Mais pour ce qu'on croit",
