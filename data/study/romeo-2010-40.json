      "timing": {
        "method": "supplied-timestamp-subdivision",
        "anchorStart": 8679,
        "sourceLineNumber": 824,
        "precision": "approximate"
      }
    },
    {
      "start": 8685.933,
      "sourceText": "On s'en fout",
      "ipa": "[ɔ̃ sɑ̃ fu]",
      "ear": "翁 桑 富",
      "meaning": "我们才不在乎。",
      "suppliedText": "On s'en fout",
      "sourceLineId": "romeo-timed-824-15",
