      "timing": {
        "method": "supplied-timestamp-subdivision",
        "anchorStart": 8671,
        "sourceLineNumber": 823,
        "precision": "approximate"
      }
    },
    {
      "start": 8679,
      "sourceText": "Nous, on n'a rien du tout,",
      "ipa": "[nu ɔ̃ na ʁjɛ̃ dy tu]",
      "ear": "努 翁 纳 赫耶安 迪于 图",
