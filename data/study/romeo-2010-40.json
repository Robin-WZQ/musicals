        "sourceLineNumber": 824,
        "precision": "approximate"
      }
    },
    {
      "start": 8683.267,
      "sourceText": "Oui mais on l'avoue,",
      "ipa": "[wi mɛ ɔ̃ lavu]",
      "ear": "乌伊 梅 翁 拉乌",
      "meaning": "是的，我们承认。",
      "suppliedText": "Oui mais on l'avoue,",
