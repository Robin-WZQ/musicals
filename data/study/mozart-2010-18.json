        "precision": "approximate"
      }
    },
    {
      "start": 5943.407,
      "sourceText": "Voici 100 ducats.",
      "ipa": "[vwasi sɑ̃ dyka]",
      "ear": "弗乌阿西 桑 迪于卡",
