      "sourceLineId": "mozart-timed-650-3",
      "suppliedText": "Un requiem? Mais pour qui? Ça n'est pas votre affaire. Voici 100 ducats.",
      "kind": "lyric-or-dialogue",
      "timing": {
        "method": "user-supplied-anchor-subdivision",
        "anchorStart": 5936,
        "anchorEnd": 5945.259,
