    },
    {
      "start": 5908,
      "sourceText": "Monsieur Mozart?",
      "ipa": "[məsjø mɔtsaʁ]",
      "ear": "默斯耶厄 莫特萨赫",
      "meaning": "莫扎特先生？",
      "sourceLineId": "mozart-timed-646-1",
      "suppliedText": "Monsieur Mozart? Que me voulez-vous?",
      "kind": "lyric-or-dialogue",
      "timing": {
        "method": "user-supplied-anchor-subdivision",
        "anchorStart": 5908,
        "anchorEnd": 5916,
        "sourceLineNumber": 646,
        "precision": "approximate"
      }
    },
    {
      "start": 5911.429,
      "sourceText": "Que me voulez-vous?",
      "ipa": "[kə mə vulevu]",
      "ear": "克 默 乌莱乌",
      "meaning": "找我有什么事？",
      "sourceLineId": "mozart-timed-646-2",
      "suppliedText": "Monsieur Mozart? Que me voulez-vous?",
      "kind": "lyric-or-dialogue",
      "timing": {
        "method": "user-supplied-anchor-subdivision",
        "anchorStart": 5908,
        "anchorEnd": 5916,
        "sourceLineNumber": 646,
        "precision": "approximate"
      }
    },
    {
      "start": 5916,
      "sourceText": "Ne posez pas de questions.",
      "ipa": "[nə poze pa də kɛstjɔ̃]",
      "ear": "讷 波泽 帕 德 凯斯特耶翁",
      "meaning": "别问。",
      "sourceLineId": "mozart-timed-647-1",
      "suppliedText": "Ne posez pas de questions. L'homme qui m'envoie vous tient pour le plus talentueux des compositeurs.",
      "kind": "lyric-or-dialogue",
      "timing": {
        "method": "user-supplied-anchor-subdivision",
        "anchorStart": 5916,
        "anchorEnd": 5926,
        "sourceLineNumber": 647,
        "precision": "approximate"
      }
    },
    {
      "start": 5918.5,
      "sourceText": "L'homme qui m'envoie vous tient pour le plus talentueux des compositeurs.",
      "ipa": "[lɔm ki mɑ̃vwa vu tjɛ̃ puʁ lə ply talɑ̃tyø de kɔ̃pozitœʁ]",
      "ear": "洛姆 基 芒弗乌阿 乌 特耶安 普赫 勒 普吕 塔朗蒂于厄 德 孔波齐特厄赫",
      "meaning": "派我来的人认为您是最有才华的作曲家。",
      "sourceLineId": "mozart-timed-647-2",
      "suppliedText": "Ne posez pas de questions. L'homme qui m'envoie vous tient pour le plus talentueux des compositeurs.",
      "kind": "lyric-or-dialogue",
      "timing": {
        "method": "user-supplied-anchor-subdivision",
        "anchorStart": 5916,
        "anchorEnd": 5926,
        "sourceLineNumber": 647,
        "precision": "approximate"
      }
    },
    {
      "start": 5926,
      "sourceText": "Qu'attend-il de moi?",
      "ipa": "[katɑ̃til də mwa]",
      "ear": "卡唐蒂勒 德 姆乌阿",
      "meaning": "他想让我做什么？",
      "sourceLineId": "mozart-timed-648-1",
      "suppliedText": "Qu'attend-il de moi?",
      "kind": "lyric-or-dialogue",
      "timing": {
        "method": "user-supplied-anchor",
        "anchorStart": 5926,
        "anchorEnd": 5928,
        "sourceLineNumber": 648,
        "precision": "approximate"
      }
    },
    {
      "start": 5928,
      "sourceText": "Que vous composiez une messe des morts.",
      "ipa": "[kə vu kɔ̃pozje yn mɛs de mɔʁ]",
      "ear": "克 乌 孔波兹耶诶 于恩 梅斯 德 莫赫",
      "meaning": "请您写一部追思弥撒。",
      "sourceLineId": "mozart-timed-649-1",
      "suppliedText": "Que vous composiez une messe des morts.",
      "kind": "lyric-or-dialogue",
      "timing": {
        "method": "user-supplied-anchor",
        "anchorStart": 5928,
        "anchorEnd": 5934.54,
        "sourceLineNumber": 649,
        "precision": "approximate"
      }
    },
    {
      "start": 5936,
      "sourceText": "Un requiem?",
      "ipa": "[œ̃ ʁekɥijɛm]",
      "ear": "恩 赫克于伊耶艾姆",
      "meaning": "一部安魂曲？",
      "sourceLineId": "mozart-timed-650-1",
      "suppliedText": "Un requiem? Mais pour qui? Ça n'est pas votre affaire. Voici 100 ducats.",
      "kind": "lyric-or-dialogue",
      "timing": {
        "method": "user-supplied-anchor-subdivision",
        "anchorStart": 5936,
        "anchorEnd": 5945.259,
        "sourceLineNumber": 650,
        "precision": "approximate"
      }
    },
    {
      "start": 5937.852,
      "sourceText": "Mais pour qui?",
      "ipa": "[mɛ puʁ ki]",
      "ear": "梅 普赫 基",
      "meaning": "为谁写？",
      "sourceLineId": "mozart-timed-650-2",
      "suppliedText": "Un requiem? Mais pour qui? Ça n'est pas votre affaire. Voici 100 ducats.",
      "kind": "lyric-or-dialogue",
      "timing": {
        "method": "user-supplied-anchor-subdivision",
        "anchorStart": 5936,
        "anchorEnd": 5945.259,
        "sourceLineNumber": 650,
        "precision": "approximate"
      }
    },
    {
