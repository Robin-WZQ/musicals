        "sourceLineNumber": 650,
        "precision": "approximate"
      }
    },
    {
      "start": 5946,
      "sourceText": "Vous en aurez autant à l'achèvement de la partition.",
      "ipa": "[vuz‿ɑ̃n‿oʁe otɑ̃ a laʃɛvmɑ̃ də la paʁtisjɔ̃]",
      "ear": "乌兹 昂恩 奥赫 奥唐 阿 拉谢弗芒 德 拉 帕赫蒂斯耶翁",
      "meaning": "完成乐谱后，还会付您同样的数目。",
      "sourceLineId": "mozart-timed-651-1",
      "suppliedText": "Vous en aurez autant à l'achèvement de la partition. Travaillez avec tout le soin possible.",
      "kind": "lyric-or-dialogue",
      "timing": {
        "method": "user-supplied-anchor-subdivision",
        "anchorStart": 5946,
        "anchorEnd": 5954.39,
