        "groupSize": 3
      }
    },
    {
      "start": 972.0,
      "sourceText": "Celui que mon cœur aime",
      "ipa": "[səlɥi kə mɔ̃ kœʁ‿ɛm]",
      "ear": "瑟勒于伊 克 蒙 克厄赫 艾姆",
