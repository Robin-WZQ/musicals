        "anchorStart": 974,
        "similarity": 0.465,
        "groupSize": 3
      }
    },
    {
      "start": 977.333,
      "sourceText": "Qui ne sait pas lui-même",
      "ipa": "[ki nə sɛ pa lɥimɛm]",
      "ear": "基 讷 塞 帕 勒于伊梅姆",
