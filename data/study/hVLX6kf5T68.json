      "timing": {
        "method": "matched-transcript-anchor",
        "anchorStart": 967,
        "similarity": 0.588,
        "groupSize": 3
      }
    },
    {
      "start": 974,
      "sourceText": "Est un beau chevalier",
      "ipa": "[ɛt‿œ̃ bo ʃəvalje]",
      "ear": "艾特 恩 博 舍瓦勒耶诶",
      "meaning": "是一位俊美的骑士",
