    {
      "start": 3062,
      "sourceText": "C'est ma maison mon nid",
      "ipa": "[sɛ ma mɛzɔ̃ mɔ̃ ni]",
      "ear": "塞 玛 梅宗 蒙 尼",
      "meaning": "是我的家，我的巢穴",
      "sourceIPA": "/sɛ ma mɛzɔ̃ mɔ̃ ni/",
