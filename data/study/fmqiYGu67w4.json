        "anchorStart": 3062,
        "similarity": 0.851,
        "groupSize": 2
      }
    },
    {
      "start": 3065.9,
      "sourceText": "C'est ma ville c'est ma vie",
      "ipa": "[sɛ ma vil sɛ ma vi]",
      "ear": "塞 玛 维勒 塞 玛 维",
      "meaning": "是我的城堡，我的生命",
      "sourceIPA": "/sɛ ma vil sɛ ma vi/",
