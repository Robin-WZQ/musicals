      "timing": {
        "method": "matched-transcript-anchor",
        "anchorStart": 3092,
        "similarity": 0.673,
        "groupSize": 1
      }
    },
    {
      "start": 3100,
      "sourceText": "Et toi tu leur ressembles et tu me plais pour ça",
      "ipa": "[e twa ty lœʁ ʁəsɑ̃bl e ty mə plɛ puʁ sa]",
      "ear": "诶 特乌阿 蒂于 勒厄赫 赫桑布勒 诶 蒂于 默 普莱 普赫 萨",
      "meaning": "你和他们很像，让我很开心",
      "sourceIPA": "/e twa ty lœʁ ʁəsɑ̃blz e ty mə plɛ puʁ sa/",
      "sourceLineId": "notre-dame-de-paris-21-015",
