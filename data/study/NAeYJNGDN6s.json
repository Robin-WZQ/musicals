      }
    },
    {
      "start": 3464.2,
      "sourceText": "Qui cause ma déraison",
      "ipa": "[ki koz ma deʁɛzɔ̃]",
      "ear": "基 科兹 玛 德赫宗",
      "meaning": "导致我的疯狂、",
