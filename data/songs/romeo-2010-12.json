    },
    {
      "text": "Jusqu'à la fin jusqu'à la mort",
      "start": 2284.0,
      "duration": 5.0
    },
    {
      "text": "Est-ce que tu m'aimeras un jour mon amour",
      "start": 2289,
      "duration": 8.0
    },
    {
      "text": "Est-ce que tu m'aimeras toujours mon amour",
      "start": 2297,
