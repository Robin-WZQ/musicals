  "cues": [
    {
      "text": "Je t'aime",
      "start": 1160,
      "duration": 8.18
    },
    {
      "text": "Plus que personne au monde ne pourra t'aimer",
      "start": 1173,
      "duration": 6.165
    },
    {
      "text": "Mon fils, pour qui je donnerais mes bras",
      "start": 1179.165,
      "duration": 4.715
    },
    {
      "text": "Pour qui je donnerais mes yeux, je crois",
      "start": 1184,
      "duration": 3.796
    },
    {
      "text": "Pour qui un jour ma femme a pleuré",
      "start": 1187.796,
      "duration": 3.322
    },
    {
      "text": "De douleur et de joie",
      "start": 1191.118,
      "duration": 2.372
    },
    {
      "text": "Si au fond je ne te connais pas",
      "start": 1195,
      "duration": 2.26
    },
    {
      "text": "Ne deviens pas le traître pour moi",
      "start": 1197.26,
      "duration": 2.67
    },
    {
      "text": "Mon fils, je ne me battrai pas",
      "start": 1200,
      "duration": 4.714
    },
    {
      "text": "Personne ne vit ta vie pour toi",
      "start": 1204.714,
      "duration": 6.286
    },
    {
      "text": "C'est que ton reflet dans la glace",
      "start": 1211,
      "duration": 3.14
    },
    {
      "text": "Personne ne te pardonnera",
      "start": 1214.14,
      "duration": 2.826
    },
    {
      "text": "Personne n'aura mal à ta place",
      "start": 1216.966,
      "duration": 3.454
    },
    {
      "text": "Personne ne sentira le froid",
      "start": 1221,
      "duration": 2.741
    },
    {
      "text": "Au fond de ton cœur quand tu passes",
      "start": 1223.741,
      "duration": 3.29
    },
    {
      "text": "Personne ne vit ta vie pour toi",
      "start": 1227.031,
      "duration": 3.289
    },
    {
      "text": "Mon fils, toi qui devras porter mon nom,",
      "start": 1232,
      "duration": 4.33
    },
    {
      "text": "Fasse que ce soit pour le bien",
      "start": 1236.33,
      "duration": 4.33
    },
    {
      "text": "Et qu'un jour ce soit ma raison",
      "start": 1242,
      "duration": 2.684
    },
    {
      "text": "D'être fier de porter le tien",
      "start": 1244.684,
      "duration": 2.236
    },
    {
      "text": "Si les chemins que tu choisis ne sont pas ceux",
      "start": 1248,
      "duration": 3.907
    },
    {
      "text": "Que j'aurais pris",
      "start": 1251.907,
      "duration": 1.823
    },
    {
      "text": "Mon fils, écoute je t'en prie",
      "start": 1254,
      "duration": 7.39
    },
    {
