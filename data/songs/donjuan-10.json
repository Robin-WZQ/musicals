    {
      "text": "Au fond de ton cœur quand tu passes",
      "start": 1276.963,
      "duration": 3.407
    },
    {
      "text": "Personne ne vit ta vie pour toi",
      "start": 1281,
      "duration": 2.595
    },
    {
      "text": "Même ces femmes qui t'ont aimé",
      "start": 1283.595,
      "duration": 2.378
    },
    {
      "text": "N'ont mal que pour elles quelque fois",
      "start": 1285.973,
      "duration": 3.027
    },
    {
      "text": "Personne ne pourra oublier",
      "start": 1289,
      "duration": 2.837
    },
    {
      "text": "Ce que tu auras fait de toi",
      "start": 1291.837,
      "duration": 3.094
    },
    {
      "text": "Ce que tu auras mérité",
