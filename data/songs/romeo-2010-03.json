  "cues": [
    {
      "text": "Dieu qui voit tout, regarde-nous, regardez-vous",
      "start": 481,
      "duration": 14.25
    },
    {
      "text": "Dans nos maisons coule un poison qui a un nom",
      "start": 495.25,
      "duration": 12.75
    },
    {
      "text": "La haine, la haine...",
      "start": 508,
      "duration": 3.294
    },
    {
      "text": "Comme un serpent dans vos âmes",
      "start": 511.294,
      "duration": 3.706
    },
    {
      "text": "La haine, la haine...",
      "start": 515,
      "duration": 2.435
    },
    {
      "text": "Qui vous fait juge mais vous condamne",
      "start": 517.435,
      "duration": 4.565
    },
    {
      "text": "La haine, la haine...",
      "start": 522,
      "duration": 3.368
    },
    {
      "text": "Je la vois brûler dans vos yeux",
      "start": 525.368,
      "duration": 4.632
    },
    {
      "text": "La haine, la haine...",
      "start": 530,
      "duration": 2.667
    },
    {
      "text": "Qui fait de vous des malheureux",
      "start": 532.667,
      "duration": 4.333
    },
    {
      "text": "Je hais la haine",
      "start": 537,
      "duration": 4.0
    },
    {
      "text": "Je vous l'avoue, je n'ai pour vous que du dégoût",
      "start": 541,
      "duration": 12.381
    },
    {
      "text": "Pourquoi faut-il que dans cette ville on aime autant",
      "start": 553.381,
      "duration": 13.619
    },
    {
      "text": "La haine, la haine...",
      "start": 567,
      "duration": 2.947
    },
    {
      "text": "Au nom du père, au nom du fils",
      "start": 569.947,
      "duration": 4.053
    },
    {
      "text": "La haine, la haine...",
      "start": 574,
      "duration": 3.368
    },
    {
      "text": "Qui fait de nous vos complices",
      "start": 577.368,
      "duration": 4.632
    },
    {
      "text": "La haine, la haine...",
      "start": 582,
      "duration": 2.435
    },
    {
      "text": "C'est le courage qui manque aux lâches",
      "start": 584.435,
      "duration": 4.565
    },
    {
      "text": "La haine, la haine...",
      "start": 589,
      "duration": 3.048
    },
    {
      "text": "La sœur de l'amour mais qu'on cache",
      "start": 592.048,
      "duration": 4.952
    },
    {
      "text": "Je vous maudis pour toutes ces nuits",
      "start": 597,
      "duration": 4.308
    },
    {
      "text": "À vous entendre sans vous comprendre",
      "start": 601.308,
      "duration": 3.692
    },
    {
      "text": "Vous en oubliez même le plaisir",
      "start": 605,
      "duration": 3.792
    },
    {
      "text": "Le seul qui compte, c'est de haïr",
      "start": 608.792,
      "duration": 3.208
    },
    {
      "text": "Regardez-vous elle vous enchaîne",
      "start": 612,
      "duration": 3.586
    },
    {
      "text": "Cette putain de haine qui vous prend tout",
      "start": 615.586,
      "duration": 4.414
    },
    {
      "text": "Regardez-vous vous n'êtes rien",
      "start": 620,
      "duration": 3.667
    },
    {
      "text": "Que des pantins entre ses mains",
      "start": 623.667,
      "duration": 3.333
    },
    {
      "text": "Comment peut-on faire en son nom",
      "start": 627,
      "duration": 3.5
    },
    {
      "text": "Autant de crimes et de victimes",
      "start": 630.5,
      "duration": 3.5
    },
    {
      "text": "La haine, elle vient pondre dans vos âmes",
      "start": 634,
      "duration": 4.0
    },
    {
      "text": "Alors écoutez la voix des femmes",
      "start": 638,
      "duration": 11.0
    },
    {
      "text": "La haine, la haine, la haine...",
      "start": 649,
      "duration": 15.0
    },
    {
      "text": "La haine, elle vient pondre dans vos âmes",
      "start": 664,
      "duration": 7.538
    },
    {
      "text": "Alors écoutez la voix des femmes",
      "start": 671.538,
      "duration": 6.462
    },
    {
      "text": "La haine, la haine, la haine, la haine…",
      "start": 678,
      "duration": 3.13
    },
    {
      "text": "Tout le monde pense ici qu’on se déteste.",
      "start": 681.13,
      "duration": 2.935
    },
    {
      "text": "Ce qui est complètement et absolument… vrai !",
      "start": 684.065,
      "duration": 2.935
    },
    {
      "text": "Je me présente, Benvolio, 20 ans, Montaigu.",
      "start": 687,
      "duration": 3.5
    },
    {
      "text": "J’ai deux amis : Roméo, et Mercutio.",
      "start": 690.5,
      "duration": 3.5
    },
    {
      "text": "J’aime les femmes, non !",
      "start": 694,
      "duration": 1.697
    },
    {
      "text": "J’adore les femmes !",
      "start": 695.697,
      "duration": 1.455
    },
    {
      "text": "Impossible de vivre sans elles.",
      "start": 697.152,
      "duration": 2.424
    },
    {
      "text": "Et encore moins sans mes amis.",
      "start": 699.576,
      "duration": 2.424
    },
    {
      "text": "Mercutio...",
      "start": 702,
      "duration": 1.778
    },
    {
      "text": "est bizarre.",
      "start": 703.778,
      "duration": 1.778
    },
    {
      "text": "Tourmenté.",
      "start": 705.556,
      "duration": 1.777
    },
    {
      "text": "Complètement fou.",
      "start": 707.333,
      "duration": 2.667
    },
    {
      "text": "Et Roméo, bah Roméo c’est Roméo…",
      "start": 710,
      "duration": 5.0
    },
    {
      "text": "Bizarre », « tourmenté », « complètement fou »...",
      "start": 715,
      "duration": 7.0
    },
    {
      "text": "Mais quel portrait !",
      "start": 722,
      "duration": 1.302
    },
    {
      "text": "C’est comme ça que tu me vois ?",
      "start": 723.302,
      "duration": 1.861
    },
    {
      "text": "Un peu !",
      "start": 725.163,
      "duration": 0.558
    },
    {
      "text": "Vilaines pensées, tu vas faire pleurer Mercutio !",
      "start": 725.721,
      "duration": 3.535
    },
    {
      "text": "Pardon ami.",
      "start": 729.256,
      "duration": 0.744
    },
    {
      "text": "Frère ?",
      "start": 730,
      "duration": 2.5
    },
    {
      "text": "Frère !",
      "start": 732.5,
      "duration": 2.5
    }
