    {
      "text": "Bim bam bim boum",
      "start": 1256.283,
      "duration": 2.856
    },
    {
      "text": "Tout mon être se fissure",
      "start": 1260,
      "duration": 5.34
    },
    {
      "text": "Je suis un songe",
      "start": 1265.34,
      "duration": 3.56
    },
    {
      "text": "Un ectoplasme",
      "start": 1269,
      "duration": 2.619
    },
    {
      "text": "Juste un mensonge, un pléonasme",
      "start": 1271.619,
      "duration": 5.761
    },
    {
      "text": "Je reste de glace face à vos spasmes",
      "start": 1278,
      "duration": 4.903
    },
    {
      "text": "Je ne trouve pas ma place",
      "start": 1282.903,
      "duration": 3.677
    },
    {
      "text": "Dans vos fantasmes",
      "start": 1287,
      "duration": 1.905
    },
    {
      "text": "Sous mon masque de fer",
      "start": 1288.905,
      "duration": 3.047
    },
    {
      "text": "Des larmes qui lacèrent",
      "start": 1291.952,
      "duration": 3.048
    },
    {
      "text": "Mes anciennes blessures",
      "start": 1295,
