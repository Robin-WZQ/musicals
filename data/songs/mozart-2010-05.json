  "cues": [
    {
      "text": "Je suis une femme",
      "start": 1206,
      "duration": 3.488
    },
    {
      "text": "Mi-lune, mi-homme",
      "start": 1209.488,
      "duration": 2.989
    },
    {
      "text": "Une anagramme, un erratum",
      "start": 1212.477,
      "duration": 4.983
    },
    {
      "text": "On me dessine, on me façonne",
      "start": 1218,
      "duration": 5.0
    },
    {
      "text": "Je vous fascine, ça vous étonne",
      "start": 1223.0,
      "duration": 6.0
    },
    {
      "text": "J'ai le cœur qui syncope",
      "start": 1229,
      "duration": 3.688
    },
    {
      "text": "L'adrénaline me dope",
      "start": 1232.688,
      "duration": 2.95
    },
    {
      "text": "En battant la mesure",
      "start": 1235.638,
      "duration": 2.582
    },
    {
      "text": "Bim bam",
