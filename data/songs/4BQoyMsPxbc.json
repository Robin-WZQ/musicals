    {
      "text": "Mon maitre, mon sauveur",
      "start": 7340,
      "duration": 3.25
    },
    {
      "text": "Toi prêtre du Seigneur",
      "start": 7343.25,
      "duration": 3.25
    },
    {
      "text": "Tu avais donc un cœur",
      "start": 7347,
      "duration": 3.9
    },
    {
      "text": "Un cœur",
      "start": 7350.9,
      "duration": 1.3
    },
    {
      "text": "Un cœur qui peut aimer",
      "start": 7354,
      "duration": 3.5
    },
    {
      "text": "Un cœur qui peut pleurer",
      "start": 7357.5,
      "duration": 3.5
    },
    {
      "text": "Un cœur qui peut saigner",
      "start": 7361,
      "duration": 3.9
    },
    {
      "text": "Un cœur qui peut tuer",
      "start": 7364.9,
      "duration": 3.9
    },
    {
      "text": "Regarde-là!",
      "start": 7369,
      "duration": 1.95
    },
    {
      "text": "Ta belle Esméralda",
      "start": 7370.95,
      "duration": 3.9
    },
    {
      "text": "Rappelle-toi, Quasimodo",
      "start": 7374.85,
      "duration": 4.55
    },
    {
      "text": "Celle qui dansait sur là son tréteau",
      "start": 7380,
      "duration": 5.211
    },
    {
      "text": "C'est moi qui l'ai livrée à son bourreau",
      "start": 7385.211,
      "duration": 5.789
    },
    {
      "text": "Parce qu'elle n'a pas voulu de moi",
      "start": 7391,
      "duration": 5.2
    },
    {
      "text": "Tu as fait ça! Toi!",
      "start": 7396.2,
      "duration": 3.25
    },
    {
      "text": "Elle mourra comme un Jésus en croix",
      "start": 7406,
      "duration": 5.85
    },
    {
      "text": "Regarde là-bas",
      "start": 7411.85,
      "duration": 2.6
    },
    {
      "text": "Le gibet l'attend sur la place de Grève",
      "start": 7415,
