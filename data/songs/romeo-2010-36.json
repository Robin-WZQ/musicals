    {
      "text": "Que lui avez-vous fait, pour qu'elle s'en aille ?",
      "start": 7521,
      "duration": 5.278
    },
    {
      "text": "Que lui avez-vous fait, quelle bataille ?",
      "start": 7526.278,
      "duration": 4.722
    },
    {
      "text": "Avez-vous gagné, à nous séparer ?",
      "start": 7531,
      "duration": 9.0
    },
    {
      "text": "Que lui avez-vous dit, pour qu'elle choisisse",
      "start": 7540,
      "duration": 5.333
    },
    {
      "text": "De mourir loin de moi",
      "start": 7545.333,
      "duration": 2.667
    },
    {
      "text": "Sans que je puisse, la serrer dans mes bras ?",
      "start": 7548,
      "duration": 7.0
    },
    {
      "text": "Que lui avez-vous fait, pour qu'elle me laisse",
      "start": 7555,
      "duration": 8.581
    },
    {
      "text": "Le poids de vos regrets, de ma tristesse ?",
      "start": 7563.581,
      "duration": 5.419
    },
    {
      "text": "C'est fini, je m'en vais",
      "start": 7569,
      "duration": 3.36
    },
    {
      "text": "Je voulais savoir la vie, maintenant je sais",
      "start": 7572.36,
      "duration": 8.64
    },
    {
      "text": "Je suis si fatigué",
      "start": 7581,
      "duration": 3.2
    },
    {
      "text": "Je ne veux plus rien",
      "start": 7584.2,
      "duration": 2.8
    },
    {
      "text": "Simplement m'allonger, et lui prendre la main",
      "start": 7587,
      "duration": 5.6
    },
    {
      "text": "La poser sur mon cœur, oublier ma douleur",
      "start": 7592.6,
      "duration": 6.4
    },
    {
      "text": "C'est fini, je m'en vais",
      "start": 7599,
      "duration": 3.36
    },
    {
      "text": "Je voulais savoir la vie, maintenant je sais",
      "start": 7602.36,
      "duration": 8.64
    },
    {
      "text": "Le miel de ses baisers",
      "start": 7611,
      "duration": 2.667
    },
    {
      "text": "La douceur de ses yeux",
      "start": 7613.667,
      "duration": 3.333
    },
    {
      "text": "Je vais les emporter",
      "start": 7617,
      "duration": 2.8
    },
    {
      "text": "Et les donner à Dieu",
      "start": 7619.8,
      "duration": 3.2
    },
    {
      "text": "Adieu ma Juliette",
      "start": 7623,
      "duration": 5.4
    },
    {
      "text": "C'est l'éternité, qui nous attend",
      "start": 7628.4,
      "duration": 6.6
    },
    {
      "text": "C'est fini, je m'en vais",
      "start": 7635,
      "duration": 4.0
    },
    {
      "text": "Enfin trouver l'oubli, trouver la paix",
      "start": 7639.0,
      "duration": 8.0
    },
    {
      "text": "Je suis si fatigué",
      "start": 7647,
      "duration": 2.667
    },
    {
      "text": "Je ne veux plus rien savoir",
      "start": 7649.667,
      "duration": 3.333
    },
    {
      "text": "Simplement m’en aller,",
      "start": 7653,
      "duration": 2.769
    },
    {
      "text": "Traverser le miroir",
      "start": 7655.769,
      "duration": 3.231
    },
    {
