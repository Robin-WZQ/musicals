    },
    {
      "text": "Au corps et encore",
      "start": 3800,
      "duration": 3.803
    },
    {
      "text": "Que mes ruptures me retiennent",
      "start": 3803.803,
      "duration": 5.977
    },
    {
      "text": "Que mes blessures",
      "start": 3813,
      "duration": 3.31
    },
    {
      "text": "S'en souviennent",
      "start": 3816.31,
      "duration": 3.31
    },
    {
      "text": "Je cours à ma perte",
      "start": 3820,
      "duration": 3.5
    },
    {
      "text": "Mes démons me guettent",
      "start": 3823.5,
      "duration": 3.5
    },
    {
      "text": "Offerte, je me jette",
      "start": 3827,
      "duration": 4.518
    },
    {
      "text": "À l'eau",
      "start": 3831.518,
      "duration": 2.582
    },
    {
      "text": "Et si je défaille",
