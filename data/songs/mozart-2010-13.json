    },
    {
      "text": "Je finirai dans les griffes de ce mâle",
      "start": 3777,
      "duration": 3.688
    },
    {
      "text": "Et si je défaille",
      "start": 3780.688,
      "duration": 1.986
    },
    {
      "text": "Si elle défaille",
      "start": 3782.674,
      "duration": 1.986
    },
    {
      "text": "À coup sûr, j'aurai mal",
      "start": 3785,
      "duration": 3.39
    },
    {
      "text": "Faut que je m'en aille",
      "start": 3788.39,
      "duration": 3.39
    },
    {
      "text": "Bien avant qu'il ne me dévore, l'animal",
      "start": 3792,
      "duration": 4.0
    },
    {
      "text": "Au corps et encore",
