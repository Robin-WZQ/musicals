    },
    {
      "text": "Si elle défaille",
      "start": 3854.677,
      "duration": 2.083
    },
    {
      "text": "La peine sans trop de mal",
      "start": 3856.76,
      "duration": 2.38
    },
    {
      "text": "Un feu de paille",
      "start": 3860,
      "duration": 2.25
    },
    {
      "text": "Me porterait à coup sûr le coup fatal",
      "start": 3862.25,
      "duration": 4.5
    },
    {
      "text": "Au corps et encore",
      "start": 3866.75,
