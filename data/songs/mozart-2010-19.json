  "cues": [
    {
      "text": "Je me croyais l'élu",
      "start": 5994,
      "duration": 2.857
    },
    {
      "text": "En volant mon histoire",
      "start": 5996.857,
      "duration": 2.857
    },
    {
      "text": "Mais je me suis perdu pour gagner",
      "start": 5999.714,
      "duration": 4.286
    },
    {
      "text": "À vaincre sans vertu",
      "start": 6004,
      "duration": 1.647
    },
    {
      "text": "On triomphe sans gloire",
      "start": 6005.647,
      "duration": 1.882
    },
    {
      "text": "L'honneur vaut mieux que le trophée",
      "start": 6007.529,
      "duration": 3.295
    },
    {
      "text": "C'est ridicule",
      "start": 6010.824,
      "duration": 1.176
    },
    {
      "text": "Pas de scrupules, il faut triompher",
      "start": 6012,
      "duration": 2.538
    },
    {
      "text": "Si on t'adule, pas de scrupules",
      "start": 6014.538,
      "duration": 2.308
    },
    {
      "text": "Laisse-toi porter",
      "start": 6016.846,
      "duration": 1.616
    },
    {
      "text": "Mais le miroir fuit mon regard",
      "start": 6018.462,
      "duration": 2.538
    },
    {
      "text": "Pour ne pas voir que je suis victime de ma victoire",
      "start": 6021,
      "duration": 5.5
    },
    {
      "text": "Oui, je m'avoue vaincu par le goût du pouvoir",
      "start": 6026.5,
      "duration": 5.5
    },
    {
      "text": "Parvenu en haut sans m'élever",
      "start": 6032,
      "duration": 3.077
    },
    {
      "text": "Je suis prince incongru",
      "start": 6035.077,
      "duration": 2.461
    },
    {
      "text": "D'un talent dérisoire",
      "start": 6037.538,
      "duration": 2.462
    },
    {
      "text": "Me faire aimer des autres sans aimer",
      "start": 6040,
      "duration": 3.387
    },
    {
      "text": "C'est ridicule",
      "start": 6043.387,
      "duration": 1.129
    },
    {
      "text": "Pas de scrupules, il faut triompher",
      "start": 6044.516,
      "duration": 2.484
    },
    {
      "text": "Si on t'adule, pas de scrupules",
      "start": 6047,
      "duration": 2.171
    },
    {
      "text": "Laisse-toi porter",
      "start": 6049.171,
      "duration": 1.519
    },
    {
      "text": "Mais le miroir fuit mon regard",
      "start": 6050.69,
      "duration": 2.388
    },
    {
      "text": "Pour ne pas voir que je suis victime de ma victoire",
      "start": 6053.078,
      "duration": 4.342
    },
    {
      "text": "Victime de ma victoire",
      "start": 6059,
      "duration": 2.278
    },
    {
      "text": "Mieux vaut être victime d'une victoire que souverain d'un rêve",
      "start": 6061.278,
      "duration": 6.582
    },
    {
      "text": "illusoire, solitaire et déshonoré comme Mozart, ruiné par l'échec de son Don Juan de malheur.",
      "start": 6068,
      "duration": 8.0
    },
    {
      "text": "Réduit à composer un conte sur le bonheur.",
      "start": 6076,
      "duration": 2.87
    },
    {
      "text": "Oui,",
      "start": 6078.87,
      "duration": 0.575
    },
    {
      "text": "Le Pipeau bavard, je crois.",
      "start": 6079.445,
      "duration": 1.913
    },
    {
      "text": "Non, ça y est, ça me revient,",
      "start": 6081.358,
      "duration": 1.722
    },
    {
      "text": "La Flûte bouchée.",
      "start": 6083.08,
      "duration": 1.34
    },
    {
      "text": "Cessez vos moqueries, Rosenberg.",
      "start": 6085,
      "duration": 2.538
    },
    {
      "text": "C'est",
      "start": 6087.538,
      "duration": 0.231
    },
    {
      "text": "La Flûte enchantée, vous le savez bien.",
      "start": 6087.769,
      "duration": 3.231
    },
    {
      "text": "Oui, oui, oui, oui, oui!",
      "start": 6091,
      "duration": 3.14
    },
    {
      "text": "Une farce, pauvre farce de conteur pour artistes aphasiques et désenchantés.",
      "start": 6094.14,
      "duration": 5.86
    },
    {
      "text": "C'est comment?",
      "start": 6100,
      "duration": 1.62
    },
    {
      "text": "Le Pipeau bavard, c'est Mozart qu'on assassine!",
      "start": 6121,
      "duration": 3.66
    },
    {
      "text": "Victime de ma victoire",
      "start": 6132,
      "duration": 2.793
    },
    {
      "text": "Ma gloire est dérisoire",
      "start": 6134.793,
      "duration": 3.104
    },
    {
      "text": "C'est ridicule, pas de scrupules",
      "start": 6137.897,
      "duration": 3.103
    },
    {
      "text": "Il faut triompher",
      "start": 6141,
      "duration": 1.235
    },
    {
      "text": "Si on t'adule, pas de scrupules",
      "start": 6142.235,
      "duration": 2.059
    },
    {
      "text": "Laisse-toi porter",
      "start": 6144.294,
      "duration": 1.441
    },
    {
      "text": "Mais le miroir fuit mon regard",
      "start": 6145.735,
      "duration": 2.265
    },
    {
      "text": "Pour ne pas voir que je suis victime de ma victoire",
      "start": 6148,
      "duration": 5.263
    },
    {
      "text": "C'est ridicule, pas de scrupules",
      "start": 6153.263,
      "duration": 2.632
    },
    {
      "text": "Pourquoi triompher?",
      "start": 6155.895,
      "duration": 2.105
    },
    {
      "text": "Si on t'adule, pas de scrupules",
      "start": 6158,
      "duration": 2.222
    },
    {
      "text": "Pourquoi me porter?",
      "start": 6160.222,
      "duration": 1.778
    },
    {
      "text": "Mais mon orgueil porte le deuil",
      "start": 6162,
      "duration": 3.152
    },
    {
      "text": "Pour ne plus voir que je suis victime",
      "start": 6165.152,
      "duration": 3.393
    },
    {
      "text": "De ma victoire",
      "start": 6168.545,
      "duration": 1.455
    },
    {
      "text": "Victime de ma victoire",
      "start": 6170,
      "duration": 6.743
    },
    {
      "text": "J'ai perdu",
      "start": 6176.743,
      "duration": 2.997
    },
    {
      "text": "Pour l'Histoire",
      "start": 6180,
      "duration": 5.512
    },
    {
      "text": "Wolfgang, tu vas attraper froid.",
      "start": 6185.512,
      "duration": 8.268
    },
    {
      "text": "Voilà, je l'ai.",
      "start": 6194,
      "duration": 2.497
    },
    {
      "text": "Je l'ai.",
      "start": 6196.497,
      "duration": 1.249
    },
    {
      "text": "Notez, écrivez.",
      "start": 6197.746,
      "duration": 2.081
    },
    {
      "text": "Lacrimosa, mes larmes.",
      "start": 6199.827,
      "duration": 2.913
    },
    {
      "text": "Ré mineur, première mesure.",
      "start": 6205,
      "duration": 2.265
    },
    {
      "text": "Fa, do dièse, ré.",
      "start": 6207.265,
      "duration": 1.235
    },
    {
      "text": "Troisième mesure, l'entrée du thème legato.",
      "start": 6208.5,
      "duration": 3.5
    },
    {
      "text": "La, fa, ré, ré, do.",
      "start": 6212,
      "duration": 5.219
    },
    {
      "text": "3e mesure, enfin l'espoir, la montée des chœurs.",
      "start": 6218,
      "duration": 4.283
    },
    {
      "text": "Si et do naturels, tous par ton.",
      "start": 6222.283,
      "duration": 2.677
    },
    {
      "text": "Puis demi-ton.",
      "start": 6224.96,
      "duration": 1.339
    },
    {
      "text": "L'inaccessible.",
      "start": 6227,
      "duration": 1.667
    },
    {
      "text": "Ma musique me dépassera.",
      "start": 6228.667,
      "duration": 3.333
    },
    {
      "text": "Les cieux.",
      "start": 6232.0,
      "duration": 1.333
    },
    {
      "text": "La lumière...",
      "start": 6233.333,
      "duration": 1.667
    },
    {
      "text": "Maître?",
      "start": 6235.0,
      "duration": 1.0
    },
    {
      "text": "Pauvre Mozart, reclus chez lui, la santé déclinante.",
      "start": 6236,
      "duration": 4.98
    },
    {
      "text": "Il raconte partout que la",
      "start": 6242,
      "duration": 2.162
    },
    {
      "text": "Mort lui aurait passé commande d'un requiem pour ses propres funérailles.",
      "start": 6244.162,
      "duration": 5.838
    },
    {
      "text": "Pour ses propres funérailles?",
      "start": 6250,
      "duration": 2.222
    },
    {
      "text": "Quelle prétention!",
      "start": 6252.222,
      "duration": 1.556
    },
    {
      "text": "Vous ne trouvez pas, Da Ponte?",
      "start": 6253.778,
      "duration": 2.222
    },
    {
      "text": "Monsieur, tout ce qui touche Mozart me touche également, et le mépris avec lequel vous le traitez me répugne.",
      "start": 6256,
      "duration": 8.26
    },
    {
      "text": "Constance!",
      "start": 6265,
      "duration": 3.564
    },
    {
      "text": "Wolfgang!",
      "start": 6268.564,
      "duration": 2.376
    },
    {
      "text": "Que faites-vous là?",
      "start": 6373,
      "duration": 2.5
    },
    {
      "text": "Qui vous a dit d'entrer?",
      "start": 6375.5,
      "duration": 2.5
    },
    {
      "text": "Madame, j'ai appris la maladie de votre mari, et je voulais vous aider.",
      "start": 6378,
      "duration": 9.0
    },
    {
      "text": "Non, monsieur, rien.",
      "start": 6387,
      "duration": 2.032
    },
    {
      "text": "Après tout le mal que vous nous avez fait?",
      "start": 6389.032,
      "duration": 4.645
    },
    {
      "text": "Ah, c'est vous!",
      "start": 6393.677,
      "duration": 1.162
    },
    {
      "text": "Salieri!",
      "start": 6394.839,
      "duration": 1.161
    },
    {
      "text": "Comment allez-vous?",
      "start": 6396,
      "duration": 1.402
    },
    {
      "text": "Wolfgang, repose-toi.",
      "start": 6397.402,
      "duration": 1.636
    },
    {
      "text": "Partez.",
      "start": 6399.038,
      "duration": 0.467
    },
    {
      "text": "Partez, je vous en supplie.",
      "start": 6399.505,
      "duration": 2.103
    },
    {
      "text": "C'est pas le moment!",
      "start": 6401.608,
      "duration": 1.169
    },
    {
      "text": "Salieri!",
      "start": 6402.777,
      "duration": 0.935
    },
    {
      "text": "Partez!",
      "start": 6403.712,
      "duration": 0.467
    },
    {
      "text": "Vous savez, Salieri, je ne parviendrai jamais à le terminer, mon requiem.",
      "start": 6407,
      "duration": 8.0
    },
    {
      "text": "Mais si, Mozart.",
      "start": 6415,
      "duration": 2.0
    },
    {
      "text": "Vous guérirez.",
      "start": 6417.0,
      "duration": 2.4
    },
    {
      "text": "Non, mon ami.",
      "start": 6419.4,
      "duration": 1.6
    },
    {
      "text": "La mort est là.",
      "start": 6421,
      "duration": 1.032
    },
    {
      "text": "Wolfgang, ne dis pas ça, tu vas nous porter malheur!",
      "start": 6422.032,
      "duration": 3.871
    },
    {
      "text": "Je ramène le médecin.",
      "start": 6425.903,
      "duration": 2.065
    },
    {
      "text": "Non, Constance!",
      "start": 6427.968,
      "duration": 1.032
    },
    {
      "text": "Ça ne sert plus à rien.",
      "start": 6429,
      "duration": 1.333
    },
    {
      "text": "Je veux voir",
      "start": 6430.333,
      "duration": 0.953
    },
    {
      "text": "Süssmayer, il doit finir le requiem.",
      "start": 6431.286,
      "duration": 2.666
    },
    {
      "text": "Va, sur la table, il y a les notes, les esquisses.",
      "start": 6433.952,
      "duration": 3.048
    },
    {
      "text": "Va, maintenant.",
      "start": 6437,
      "duration": 1.786
    },
    {
      "text": "Va!",
      "start": 6438.786,
      "duration": 0.357
    },
    {
      "text": "Non.",
      "start": 6439.143,
      "duration": 0.357
    }
