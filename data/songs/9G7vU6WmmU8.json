  "description": "@yenjanw\r\nNotre Dame de Paris 鐘樓怪人",
  "captionSource": "editorial",
  "cues": [
    {
      "text": "Les cloches ne sonnent plus",
      "start": 4358,
      "duration": 3.25
    },
    {
      "text": "La cathédrale s'est tue.",
      "start": 4361.25,
      "duration": 3.9
    },
    {
      "text": "Quasimodo est malheureux",
      "start": 4367,
      "duration": 5.2
    },
    {
      "text": "Quasimodo est amoureux",
      "start": 4372.2,
      "duration": 5.2
    },
    {
      "text": "Il fait la grève des cloches",
      "start": 4378,
      "duration": 3.9
    },
    {
      "text": "depuis déjà trois jours",
      "start": 4381.9,
      "duration": 3.9
    },
    {
      "text": "Quasimodo est triste",
      "start": 4387,
      "duration": 3.9
    },
    {
      "text": "Quasimodo est fou",
      "start": 4390.9,
      "duration": 3.9
    },
    {
      "text": "Parce qu'il se meurt d'amour",
      "start": 4395,
      "duration": 5.2
    },
    {
      "text": "Les cloches que je sonne",
      "start": 4415,
      "duration": 5.0
    },
    {
      "text": "sont mes amours, sont mes amantes",
      "start": 4422,
      "duration": 5.2
    },
    {
      "text": "Je veux qu'elles claironnent",
      "start": 4429,
      "duration": 5.0
    },
    {
      "text": "qu'elles tambourinent et qu'elles chantent",
      "start": 4436,
      "duration": 5.0
    },
    {
      "text": "Qu'il grêle ou qu'il tonne",
      "start": 4443,
      "duration": 5.0
    },
    {
      "text": "ou qu'il pleuve ou qu'il vent",
      "start": 4450,
      "duration": 5.0
    },
    {
      "text": "Je veux qu'elles résonnent",
      "start": 4457,
      "duration": 5.0
    },
    {
      "text": "dans la joie comme dans la tourmente",
      "start": 4464,
      "duration": 5.2
    },
    {
      "text": "Celles qui sonnent quand on naît",
      "start": 4486,
      "duration": 2.25
    },
    {
      "text": "celles qui sonnent quand on meurt",
      "start": 4488.25,
      "duration": 2.25
    },
    {
      "text": "Celles qui sonnent tous les jours, toutes les nuits, toutes les heures",
      "start": 4490.5,
      "duration": 4.5
    },
    {
      "text": "Celles qui sonnent quand on prie, celles qui sonnent quand on pleure",
      "start": 4495,
      "duration": 2.667
    },
    {
      "text": "Celles qui sonnent pour le peuple qui se lève de bonne heure",
      "start": 4497.667,
      "duration": 2.666
    },
    {
      "text": "Pour la fête des Rameaux, pour la Quasimodo",
      "start": 4500.333,
      "duration": 2.667
    },
    {
      "text": "Pour le jour de Noël et le jour de la Toussaint",
      "start": 4503,
      "duration": 4.333
    },
    {
      "text": "Pour l'Annonciation, pour la Résurrection",
      "start": 4507.333,
      "duration": 3.667
    },
    {
      "text": "Pour la St-Valentin et pour le Vendredi Saint",
      "start": 4511,
      "duration": 3.64
    },
    {
      "text": "Pour les célébrations et pour les processions",
      "start": 4514.64,
      "duration": 3.36
    },
    {
      "text": "La plus belle, c'est celle qu'on appelle la Fête-Dieu",
      "start": 4518,
      "duration": 3.348
    },
    {
      "text": "Jour de l'An, jour des rois, jour de Pâques, jour de joie",
      "start": 4521.348,
      "duration": 3.652
    },
    {
      "text": "Jour de la Pentecôte avec ses langues de feu",
      "start": 4525,
      "duration": 3.348
    },
    {
      "text": "Pour les confirmations et pour les communions",
      "start": 4528.348,
      "duration": 3.652
    },
    {
      "text": "L'angélus et le glas, dies irae dies illa",
      "start": 4532,
      "duration": 3.5
    },
    {
      "text": "Le jour de l'Ascension, le jour de l'Assomption",
      "start": 4535.5,
      "duration": 3.5
    },
    {
      "text": "Pour tous les Hosanna et tous les alléluias",
      "start": 4539,
      "duration": 8.45
    },
    {
      "text": "Mais celle que je préfère, parmi toutes ces femmes de fer",
      "start": 4548,
      "duration": 8.0
    },
    {
      "text": "Ce sont les trois Maries qui sont mes meilleures amies",
      "start": 4556,
      "duration": 8.45
    },
    {
      "text": "Il y a la petite Marie pour les enfants qu'on met en terre",
      "start": 4566,
      "duration": 8.0
    },
    {
      "text": "Il y a la grande Marie pour les marins qui partent en mer",
      "start": 4574,
      "duration": 8.0
    },
    {
      "text": "Mais quand je sonne la grosse Marie pour les amants qui se marient",
      "start": 4582,
      "duration": 8.0
    },
    {
      "text": "C'est pas que j'aie le cœur à rire",
      "start": 4590,
      "duration": 5.2
    },
    {
      "text": "je l'aurais plutôt à mourir",
      "start": 4595.2,
      "duration": 5.2
    },
    {
      "text": "De les voir si joyeux, de les voir si heureux",
      "start": 4601,
      "duration": 3.231
    },
    {
      "text": "Moi qu'aucune femme ne regardera jamais dans les yeux",
      "start": 4604.231,
      "duration": 3.769
    },
    {
      "text": "De les voir convoler, de les voir s'envoler",
      "start": 4608,
      "duration": 3.652
    },
    {
      "text": "Au milieu des étoiles sous la voûte des cieux",
      "start": 4611.652,
      "duration": 3.348
    },
    {
      "text": "Toutes les cloches que je sonne, Kyrie Eleison",
      "start": 4615,
      "duration": 3.208
    },
    {
      "text": "Hosanna alléluia, dies irae dies illa",
      "start": 4618.208,
      "duration": 3.792
    },
    {
      "text": "Toutes ces cloches de malheur, toutes ces cloches de bonheur",
      "start": 4622,
      "duration": 7.8
    },
    {
      "text": "Toutes ces cloches qui n'ont jamais encore sonné pour moi",
      "start": 4629.8,
      "duration": 8.45
    },
    {
      "text": "Les cloches que je sonne sont mes amies, sont mes amantes",
      "start": 4653,
      "duration": 8.0
    },
    {
      "text": "Je veux qu'elles claironnent, si Esméralda est vivante",
      "start": 4661,
      "duration": 6.0
    },
    {
      "text": "Pour dire au monde que Quasimodo aime Esméralda.",
      "start": 4676,
      "duration": 9.1
    }
  ],
