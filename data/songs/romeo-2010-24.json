  "cues": [
    {
      "text": "Tybalt, Tybalt, tu vas mourir Tybalt, Tybalt, fini de rire",
      "start": 4775,
      "duration": 12.0
    },
    {
      "text": "Tu n'es qu'un fat, non, tu es pire",
      "start": 4787,
      "duration": 3.077
    },
    {
      "text": "Ton âme boite mais toi tu crois courir",
      "start": 4790.077,
      "duration": 4.923
    },
    {
      "text": "Le son de ta voix, ta façon de marcher",
      "start": 4795,
      "duration": 3.84
    },
    {
      "text": "Tout, en toi me donne la nausée",
      "start": 4798.84,
      "duration": 4.16
    },
    {
      "text": "Tybalt, Tybalt, je vais te tuer",
      "start": 4803,
      "duration": 3.226
    },
    {
      "text": "Mercutio, regarde-toi !",
      "start": 4806.226,
      "duration": 2.903
    },
    {
      "text": "Tu as de l'esprit mais tu n'as que ça !",
      "start": 4809.129,
      "duration": 3.871
    },
    {
      "text": "Tu n'es qu'un bouffon un poète raté,",
      "start": 4813,
      "duration": 3.343
    },
    {
      "text": "Et quand j'entends ton nom",
      "start": 4816.343,
      "duration": 1.8
    },
    {
      "text": "Je me bouche le nez",
      "start": 4818.143,
      "duration": 1.8
    },
    {
      "text": "Maintenant, c'est terminé",
      "start": 4819.943,
      "duration": 2.057
    },
    {
      "text": "Depuis notre enfance je n'ai qu'une idée",
      "start": 4822,
      "duration": 4.25
    },
    {
      "text": "Enfin ma patience va être récompensée",
      "start": 4826.25,
      "duration": 3.75
    },
    {
      "text": "Mercutio",
      "start": 4830,
      "duration": 1.5
    },
    {
      "text": "Ouais !?",
      "start": 4831.5,
      "duration": 1.5
    },
    {
      "text": "Je vais te tuer",
      "start": 4833,
      "duration": 1.111
    },
    {
      "text": "Arrêtez, vous êtes fous, vous n'avez pas le droit",
      "start": 4834.111,
      "duration": 3.148
    },
    {
      "text": "Roméo, non !",
      "start": 4837.259,
      "duration": 0.741
    },
    {
      "text": "En vous tuant, vous tuerez nos idées et nos lois",
      "start": 4838,
      "duration": 5.143
    },
    {
      "text": "Arrêtez !",
      "start": 4843.143,
      "duration": 0.857
    },
    {
      "text": "Vivre on veut tous vivre",
      "start": 4844,
      "duration": 4.0
    },
    {
      "text": "Sans se haïr sans en mourir",
      "start": 4848.0,
      "duration": 4.0
    },
    {
      "text": "Vivre, et se parler, se respecter, et même s'aimer",
      "start": 4852,
      "duration": 6.588
    },
    {
      "text": "Libres, on est tous libres, de ne pas suivre, de refuser",
      "start": 4858.588,
      "duration": 7.412
    },
    {
      "text": "Pour ceux qui vous aiment, vos mères, vos femmes",
      "start": 4866,
      "duration": 5.1
    },
    {
      "text": "Oubliez la haine, rangez vos armes",
      "start": 4871.1,
      "duration": 3.9
    },
    {
      "text": "Vivre et boire à la chance",
      "start": 4875,
      "duration": 3.5
    },
    {
      "text": "Ivres mais pas de vengeance",
      "start": 4878.5,
      "duration": 3.5
    },
    {
      "text": "Vivre on veut tous vivre",
      "start": 4882,
      "duration": 4.0
    },
    {
      "text": "Sans se haïr sans en mourir",
      "start": 4886.0,
      "duration": 4.0
    },
    {
      "text": "Vivre et se parler, se respecter et même s'aimer",
      "start": 4890,
      "duration": 8.0
    },
    {
      "text": "Arrêtez, vous êtes fous, vous n'avez pas le droit, non",
      "start": 4898,
      "duration": 6.0
    },
    {
      "text": "La mort attend son heure, attendez la vôtre",
      "start": 4904.0,
      "duration": 4.667
    },
    {
      "text": "Maintenant !",
      "start": 4908.667,
      "duration": 1.333
    },
    {
      "text": "Ne faites pas l'erreur, ne faites pas la faute",
      "start": 4910,
      "duration": 8.5
    },
    {
      "text": "Vivre pour se comprendre, vivre et vieillir ensemble, oh, oh, oh,...",
      "start": 4918.5,
      "duration": 10.5
    },
    {
      "text": "Il me hait tant, y a si longtemps, non, Roméo",
      "start": 4929,
      "duration": 4.968
    },
    {
      "text": "Sa grâce c'est trop, c'est comme un chien qui a la rage",
      "start": 4933.968,
      "duration": 6.032
    },
    {
      "text": "Un lâche !",
      "start": 4940,
      "duration": 0.75
    },
    {
      "text": "qui croit en son courage",
      "start": 4940.75,
      "duration": 2.5
    },
    {
      "text": "Qu'est-ce que tu crois",
      "start": 4943.25,
      "duration": 2.0
    },
    {
      "text": "Roméo !",
      "start": 4945.25,
      "duration": 0.75
    },
    {
      "text": "Tu n'es pas roi, non",
      "start": 4946,
      "duration": 1.8
    },
    {
      "text": "Tu es comme nous, même pire que nous",
      "start": 4947.8,
      "duration": 4.2
    },
    {
      "text": "Te voilà plein d'amour et tu pisses la tendresse",
      "start": 4952,
      "duration": 3.778
    },
    {
      "text": "Tu es comme les vautours qui attendent la faiblesse",
      "start": 4955.778,
      "duration": 4.222
    },
    {
      "text": "Vivre, vivre c'est se battre,",
      "start": 4960,
      "duration": 3.765
    },
    {
      "text": "La vie n'est pas un théâtre !",
      "start": 4963.765,
      "duration": 4.235
    },
    {
      "text": "Vivre, libre...",
      "start": 4968,
      "duration": 15.0
    },
    {
      "text": "Vivre, on veut tous vivre",
      "start": 4983,
      "duration": 2.483
    },
    {
      "text": "Sans se haïr, sans en mourir",
      "start": 4985.483,
      "duration": 2.483
    },
    {
      "text": "Aller Mercutio relève toi !",
      "start": 4987.966,
      "duration": 3.034
    },
    {
      "text": "Vivre et se parler, se respecter et même s'aimer...",
      "start": 4991,
      "duration": 8.0
    },
    {
      "text": "Vivre...",
      "start": 4999,
      "duration": 7.333
    },
    {
      "text": "Non !",
      "start": 5006.333,
      "duration": 3.667
    },
    {
      "text": "Roméo…",
      "start": 5010,
      "duration": 1.091
    },
    {
      "text": "Mercutio !",
      "start": 5011.091,
      "duration": 1.454
    },
    {
      "text": "Oh, Roméo…",
      "start": 5012.545,
      "duration": 1.455
    },
    {
      "text": "Mercutio, tu es blessé !",
      "start": 5014,
      "duration": 6.545
    },
    {
      "text": "Non.",
      "start": 5020.545,
      "duration": 0.819
    },
    {
      "text": "Non.",
      "start": 5021.364,
      "duration": 0.818
    },
    {
      "text": "Non !",
      "start": 5022.182,
      "duration": 0.818
    },
    {
      "text": "Qu'est-ce qui peut encore blesser Mercutio, non ?",
      "start": 5023,
      "duration": 5.514
    },
    {
      "text": "Mais la vie Roméo, regarde, elle s'échappe, elle s'en va !",
      "start": 5028.514,
      "duration": 6.486
    },
    {
      "text": "Mais tu saignes !",
      "start": 5035,
      "duration": 1.56
    },
    {
      "text": "Mais non !",
      "start": 5036.56,
      "duration": 0.78
    },
    {
      "text": "Tu as toujours été si maladroit Roméo.",
      "start": 5037.34,
      "duration": 4.16
    },
    {
      "text": "Pourquoi t'es-tu mis entre nous ?",
      "start": 5041.5,
      "duration": 3.12
    },
    {
      "text": "J'ai reçu le coup par-dessous ton bras.",
      "start": 5044.62,
      "duration": 3.38
    },
    {
      "text": "Oh Mercutio je suis si...",
      "start": 5048,
      "duration": 1.761
    },
    {
      "text": "Mais non ne t’excuses pas !",
      "start": 5049.761,
      "duration": 1.565
    },
    {
      "text": "Ce sont les enfants qui s’excusent !",
      "start": 5051.326,
      "duration": 1.957
    },
    {
      "text": "Et Juliette aime un homme !",
      "start": 5053.283,
      "duration": 2.152
    },
    {
      "text": "Mercutio, Mercutio…",
      "start": 5055.435,
      "duration": 1.565
    },
    {
      "text": "Non, non, non, Roméo.",
      "start": 5057,
      "duration": 1.116
    },
    {
      "text": "Ne pleure pas, aime Juliette de toutes tes forces.",
      "start": 5058.116,
      "duration": 3.535
    },
    {
      "text": "Aime la de toute ton âme.",
      "start": 5061.651,
      "duration": 2.047
    },
    {
      "text": "Aime la, Roméo !",
      "start": 5063.698,
      "duration": 1.302
    }
  ],
