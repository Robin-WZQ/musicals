  "cues": [
    {
      "text": "Ne la reconnais-tu pas?",
      "start": 2833,
      "duration": 7.0
    },
    {
      "text": "C'est la statue du Commandeur",
      "start": 2840,
      "duration": 2.406
    },
    {
      "text": "Un homme qui a perdu la vie",
      "start": 2842.406,
      "duration": 2.647
    },
    {
      "text": "Parce qu'il n'a pas eu assez peur",
      "start": 2845.053,
      "duration": 2.887
    },
    {
      "text": "C'est la statue d'un homme mort",
      "start": 2849,
      "duration": 2.1
    },
    {
      "text": "Pour avoir provoqué le sort",
      "start": 2851.1,
      "duration": 2.567
    },
    {
      "text": "Et avoir voulu un instant",
      "start": 2853.667,
      "duration": 2.333
    },
    {
      "text": "Croiser ton épée, Don Juan",
      "start": 2856,
      "duration": 4.635
    },
    {
      "text": "Fais attention, n'approche pas",
      "start": 2860.635,
      "duration": 4.635
    },
    {
      "text": "Tu es encore là?",
      "start": 2869,
      "duration": 2.027
    },
    {
      "text": "Je savais que tu reviendrais",
      "start": 2871.027,
      "duration": 4.053
    },
    {
      "text": "Alors raconte-moi comment on sait",
      "start": 2876,
      "duration": 7.271
    },
    {
      "text": "Dans l'au-delà",
      "start": 2883.271,
      "duration": 3.029
    },
    {
      "text": "Est-ce qu'il y en a beaucoup d'autres",
      "start": 2889,
      "duration": 3.155
    },
    {
      "text": "Ou est-ce qu'ils n'ont trouvé comme moi",
      "start": 2892.155,
      "duration": 2.945
    },
    {
      "text": "Pour leur faire expier leurs fautes",
      "start": 2897,
      "duration": 5.319
    },
    {
      "text": "Je me pardonne, ça suffira",
      "start": 2902.319,
      "duration": 3.191
    },
    {
      "text": "Tu blasphèmes, tu blasphèmes encore et toujours",
      "start": 2909,
      "duration": 8.96
    },
    {
      "text": "Tu ne sais pas ce qui t'attend",
