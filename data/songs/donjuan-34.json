  "cues": [
    {
      "text": "Quelle est sa chance contre toi",
      "start": 5873,
      "duration": 8.6
    },
    {
      "text": "Et son espoir de vivre encore",
      "start": 5883,
      "duration": 2.588
    },
    {
      "text": "Tu sais qu'à l'issue du combat",
      "start": 5885.588,
      "duration": 2.588
    },
    {
      "text": "Un seul de vous se tiendra droit",
      "start": 5888.176,
      "duration": 2.824
    },
    {
      "text": "Et que l'autre aura vu sa mort",
      "start": 5891,
      "duration": 2.909
    },
    {
      "text": "Tu sais très bien que contre toi",
      "start": 5893.909,
      "duration": 2.909
    },
    {
      "text": "Jamais il ne s'en sortira",
      "start": 5896.818,
      "duration": 2.182
    },
    {
      "text": "Laisse le vivre, je t'en conjure",
      "start": 5899,
      "duration": 2.75
    },
    {
      "text": "Demain à l'aube, n'y va pas",
      "start": 5901.75,
      "duration": 2.5
    },
    {
      "text": "Et ce sera toi qui vaincras",
      "start": 5904.25,
      "duration": 2.75
    },
    {
      "text": "Sans qu'il n'y ait la moindre blessure",
      "start": 5907,
      "duration": 3.434
    },
    {
      "text": "Sais-tu donc à qui tu t'adresses",
      "start": 5910.434,
      "duration": 2.906
    },
    {
      "text": "As-tu oublié qui je suis",
      "start": 5915,
      "duration": 2.378
    },
    {
      "text": "Jamais je n'aurai de faiblesses",
      "start": 5917.378,
      "duration": 2.811
    },
    {
      "text": "Pour celui qui jure et confesse",
      "start": 5920.189,
      "duration": 2.811
    },
    {
      "text": "Qu'il voudra me prendre la vie",
      "start": 5923,
      "duration": 2.588
    },
    {
      "text": "Jamais je ne laisserai d'insulte",
      "start": 5925.588,
      "duration": 3.059
    },
    {
      "text": "Impardonnés, tu le sais bien",
      "start": 5928.647,
      "duration": 2.353
    },
    {
      "text": "Et peu m'importe si demain",
      "start": 5931,
      "duration": 2.424
    },
    {
      "text": "Le monde me traitera de brute",
      "start": 5933.424,
      "duration": 2.667
    },
    {
      "text": "C'est pour mon honneur que je lutte",
      "start": 5936.091,
      "duration": 2.909
    },
    {
      "text": "Et pour la femme à qui je tiens",
      "start": 5939,
      "duration": 4.893
    },
    {
      "text": "Don Juan, Don Juan",
      "start": 5943.893,
      "duration": 2.447
    },
    {
      "text": "N'aura de pitié pour personne",
      "start": 5947,
      "duration": 4.667
    },
    {
      "text": "Don Juan, Don Juan",
      "start": 5951.667,
      "duration": 2.333
    },
    {
      "text": "Se fout de la chance qu'on te donne",
      "start": 5954,
      "duration": 4.68
    },
    {
      "text": "Don Juan, ne comprends-tu pas",
      "start": 5958.68,
      "duration": 3.12
    },
    {
      "text": "Que c'est ta seule chance de salut",
      "start": 5963,
      "duration": 2.667
    },
    {
      "text": "De laisser vivre l'homme qui viendra",
      "start": 5965.667,
      "duration": 2.889
    },
    {
      "text": "Demain à l'aube devant toi",
      "start": 5968.556,
      "duration": 2.444
    },
    {
      "text": "Cette aube qu'il ne reverra plus",
      "start": 5971,
      "duration": 3.097
    },
    {
      "text": "Si tu le laissais s'en aller",
      "start": 5974.097,
      "duration": 2.58
    },
    {
      "text": "Sans le toucher, sans le blesser",
      "start": 5976.677,
      "duration": 2.323
    },
    {
      "text": "Tu serais plus grand que le roi",
      "start": 5979,
      "duration": 2.933
    },
    {
      "text": "Et tu les verrais s'allumer",
      "start": 5981.933,
      "duration": 2.4
