  "cues": [
    {
      "text": "Etre Prince, être Roi",
      "start": 4074,
      "duration": 3.0
    },
    {
      "text": "Avoir tous les pouvoirs et tout les droits",
      "start": 4077.0,
      "duration": 6.0
    },
    {
      "text": "Etre prince ici-bas",
      "start": 4083,
      "duration": 4.812
    },
    {
      "text": "Vivre au-dessus des lois",
      "start": 4087.812,
      "duration": 6.188
    },
    {
      "text": "On m'envie mais de quoi ?",
      "start": 4094,
      "duration": 4.0
    },
    {
      "text": "On dit \"lui\" en parlant de moi",
      "start": 4098.0,
      "duration": 4.0
    },
    {
      "text": "On me craint on me croit",
      "start": 4102,
      "duration": 3.048
    },
    {
      "text": "Pour qu'ils aient chaud j'ai froid",
      "start": 4105.048,
      "duration": 4.952
    },
    {
      "text": "Et pourtant je l'avoue",
      "start": 4110,
      "duration": 5.0
    },
    {
      "text": "Je sacrifierais tout",
      "start": 4115.0,
      "duration": 5.0
    },
    {
      "text": "Pour garder sur vous",
      "start": 4120,
      "duration": 5.0
    },
    {
      "text": "Le pouvoir, le pouvoir, le pouvoir",
      "start": 4125,
      "duration": 4.821
    },
    {
      "text": "Qu'on soit riche, qu'on soit beau",
      "start": 4129.821,
      "duration": 4.179
    },
    {
      "text": "L'esprit jamais au repos",
      "start": 4134,
      "duration": 1.8
    },
    {
      "text": "Qu'on ait tout reçu des dieux",
      "start": 4135.8,
      "duration": 2.4
    },
    {
      "text": "Qu'on soit certain d'être heureux",
      "start": 4138.2,
      "duration": 2.6
    },
    {
      "text": "Qu'on soit le diable en enfer",
      "start": 4140.8,
      "duration": 2.2
    },
    {
      "text": "Le vent qui souffle sur les mers",
      "start": 4143,
      "duration": 2.308
    },
    {
      "text": "Je ne connais pas sur terre",
      "start": 4145.308,
      "duration": 2.077
    },
    {
      "text": "De douleur plus légère",
      "start": 4147.385,
      "duration": 2.077
    },
    {
      "text": "Quel plus grand plaisir qu'avoir",
      "start": 4149.462,
      "duration": 2.538
    },
    {
      "text": "Entre ses mains le pouvoir",
      "start": 4152,
      "duration": 2.174
    },
    {
      "text": "C'est mieux que l'or que l'ivoire",
      "start": 4154.174,
      "duration": 2.826
    },
    {
      "text": "Quand le monde est son miroir",
      "start": 4157,
      "duration": 3.5
    },
    {
      "text": "Le pouvoir, le pouvoir",
      "start": 4160.5,
      "duration": 3.5
    },
    {
      "text": "Le pouvoir on le savoure",
      "start": 4164,
      "duration": 2.619
    },
    {
      "text": "C'est bien plus fort que l'amour",
      "start": 4166.619,
      "duration": 2.381
    },
    {
      "text": "Bien plus doux que les velours",
      "start": 4169.0,
      "duration": 2.619
    },
    {
      "text": "Des femmes qui me font la cour",
      "start": 4171.619,
      "duration": 2.381
    },
    {
      "text": "Le pouvoir, c'est la jouissance",
      "start": 4174,
      "duration": 2.133
    },
    {
      "text": "Et je jouis de leur confiance",
      "start": 4176.133,
      "duration": 2.134
    },
    {
      "text": "Et quand je donne ma semence",
      "start": 4178.267,
      "duration": 1.777
    },
    {
      "text": "C'est à l'histoire que je pense",
      "start": 4180.044,
      "duration": 1.956
    },
    {
      "text": "Le pouvoir, c'est fantastique",
      "start": 4182,
      "duration": 2.5
    },
    {
      "text": "Je suis un homme mais public",
      "start": 4184.5,
      "duration": 2.273
    },
    {
      "text": "Dans ce monde où tout s'achète",
      "start": 4186.773,
      "duration": 2.5
    },
    {
      "text": "Je suis le seul à qui on prête",
      "start": 4189.273,
      "duration": 2.727
    },
    {
      "text": "Dans ce monde où tout se vend",
      "start": 4192,
      "duration": 2.647
    },
    {
      "text": "On me donne sinon je prends",
      "start": 4194.647,
      "duration": 2.118
    },
    {
      "text": "Des nains je suis le géant",
      "start": 4196.765,
      "duration": 2.382
    },
    {
      "text": "Et je mens, je mens, je mens",
      "start": 4199.147,
      "duration": 1.853
    },
    {
      "text": "Le pouvoir, ah !",
      "start": 4201,
      "duration": 1.459
    },
    {
      "text": "mes amis",
      "start": 4202.459,
      "duration": 0.73
    },
    {
      "text": "Si vous en saviez le prix",
      "start": 4203.189,
      "duration": 2.189
    },
    {
      "text": "C'est la mort qui vous sourit",
      "start": 4205.378,
      "duration": 2.433
    },
    {
      "text": "L'éternité dans une vie",
      "start": 4207.811,
      "duration": 2.189
    },
    {
      "text": "Et quand je rends la justice",
      "start": 4210,
      "duration": 2.432
    },
    {
      "text": "La vertu contre le vice",
      "start": 4212.432,
      "duration": 2.163
    },
    {
      "text": "C'est le père qui parle au fils",
      "start": 4214.595,
      "duration": 2.973
    },
    {
      "text": "Je commande, ils obéissent",
      "start": 4217.568,
      "duration": 2.432
    },
    {
      "text": "Le pouvoir, ça se mérite",
      "start": 4220,
      "duration": 2.051
    },
    {
      "text": "On le prend, ou on l'hérite",
      "start": 4222.051,
      "duration": 1.846
    },
    {
      "text": "Et le jour où on le quitte",
      "start": 4223.897,
      "duration": 2.257
    },
    {
      "text": "Alors on construit son mythe",
      "start": 4226.154,
      "duration": 1.846
    },
    {
      "text": "Le pouvoir ça brûle en vous",
      "start": 4228,
      "duration": 2.881
    },
    {
      "text": "Le pouvoir ça vous rend fou",
      "start": 4230.881,
      "duration": 2.881
    },
    {
      "text": "Le pouvoir on s'y cramponne",
      "start": 4233.762,
      "duration": 2.619
    },
    {
      "text": "Et quand il vous abandonne",
      "start": 4236.381,
      "duration": 2.619
    },
    {
      "text": "On en meurt",
      "start": 4239,
      "duration": 2.947
    },
    {
      "text": "Le pouvoir, le pouvoir, le pouvoir...",
      "start": 4241.947,
      "duration": 11.053
    },
    {
      "text": "Le pouvoir",
      "start": 4253,
      "duration": 6.0
    }
  ],
