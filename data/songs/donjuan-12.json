  "cues": [
    {
      "text": "Je veux le corps de femmes et la guitare des musiciens",
      "start": 1507,
      "duration": 4.341
    },
    {
      "text": "La peau d'une sultane encore humide sous mes mains",
      "start": 1511.341,
      "duration": 4.569
    },
    {
      "text": "Je veux sentir les flammes de leurs désirs jusqu'au matin",
      "start": 1516,
      "duration": 4.101
    },
    {
      "text": "Je veux que sous mon charme elles se sentent bien",
      "start": 1520.101,
      "duration": 3.669
    },
    {
      "text": "Je veux que l'on me serve encore des bouteilles de vin",
      "start": 1524,
      "duration": 4.615
    },
    {
      "text": "Versez les sur leurs corps que je les boive sur leurs seins",
      "start": 1528.615,
      "duration": 4.385
    },
    {
      "text": "Je veux rester la nuit, j'aurais pas besoin de dormir",
      "start": 1533,
      "duration": 4.222
    },
    {
      "text": "Tant qu'il y aura ici, des femmes et du plaisir",
      "start": 1537.222,
      "duration": 3.778
    },
    {
