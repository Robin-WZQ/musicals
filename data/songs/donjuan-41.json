  "cues": [
    {
      "text": "Je n'en veux à personne",
      "start": 7168,
      "duration": 2.747
    },
    {
      "text": "Il a vécu sa vie",
      "start": 7170.747,
      "duration": 2.404
    },
    {
      "text": "Et que dieu lui pardonne",
      "start": 7173.151,
      "duration": 3.778
    },
    {
      "text": "La mort qu'il a choisie",
      "start": 7176.929,
      "duration": 3.091
    },
    {
      "text": "Je ne dois à personne",
      "start": 7182,
      "duration": 2.838
    },
    {
      "text": "Toutes mes larmes de sang",
      "start": 7184.838,
      "duration": 2.839
    },
    {
      "text": "Même s'il était un homme",
      "start": 7187.677,
      "duration": 3.193
    },
    {
      "text": "Il était mon enfant",
      "start": 7191,
      "duration": 2.92
    },
    {
      "text": "Je garderai de lui son sourire et ses yeux",
      "start": 7193.92,
      "duration": 7.51
    },
    {
      "text": "Son envie d'être libre et se brûler au jeu",
      "start": 7203,
      "duration": 4.65
    },
    {
      "text": "Je garderai de lui une seule nuit de l'amour",
      "start": 7210,
      "duration": 5.49
    },
    {
      "text": "Qui brûlera mon corps et ma peau pour toujours",
      "start": 7217,
      "duration": 7.611
    },
    {
      "text": "Don Juan est mort, Don Juan s'en va",
      "start": 7224.611,
      "duration": 4.229
    },
    {
      "text": "On accepterait tout encore",
      "start": 7229,
      "duration": 3.348
    },
    {
      "text": "S'il pouvait toujours être là",
      "start": 7232.348,
      "duration": 3.652
    },
    {
      "text": "Don Juan est mort sans qu'on apprenne",
      "start": 7236,
      "duration": 6.42
    },
    {
      "text": "Si le mal qui brûlait son corps",
      "start": 7243,
      "duration": 3.233
    },
    {
      "text": "Était ou l'amour ou la haine",
      "start": 7246.233,
      "duration": 4.527
    },
    {
      "text": "Il était tout pour moi, mon ami et mon frère",
      "start": 7253,
      "duration": 5.23
    },
    {
      "text": "Et s'il avait parfois perdu tous ses repères",
      "start": 7260,
      "duration": 5.09
    },
    {
      "text": "Pour trouver des raisons de déchirer sa vie",
      "start": 7266,
      "duration": 5.81
    },
    {
      "text": "Je ne lui en veux plus un peu tard aujourd'hui",
      "start": 7273,
      "duration": 5.98
    },
    {
      "text": "Personne ne l'a compris, mais si je l'ai choisi",
      "start": 7280,
      "duration": 5.959
    },
    {
      "text": "Contre le monde entier c'est que j'ai vu en lui",
      "start": 7285.959,
      "duration": 6.331
    },
    {
      "text": "Ce qu'il avait caché tout au fond de son cœur",
      "start": 7294,
      "duration": 5.45
    },
    {
      "text": "Cette envie d'arrêter d'aimer tant la douleur",
      "start": 7301,
      "duration": 5.0
    },
    {
      "text": "Don Juan est mort mais pas pour moi",
      "start": 7306,
      "duration": 7.0
    },
    {
      "text": "Et quand il brûlera dans mon corps",
      "start": 7313,
      "duration": 3.182
    },
    {
      "text": "Je sais qu'il sera toujours là",
      "start": 7316.182,
      "duration": 3.818
    },
    {
      "text": "Don Juan est mort et tout s'en va",
      "start": 7320,
      "duration": 6.75
    },
    {
      "text": "Je sais qu'il n'y aura pas un jour",
      "start": 7327,
      "duration": 3.851
    },
    {
      "text": "Sans oublier qu'il était là",
      "start": 7330.851,
      "duration": 3.259
    },
    {
      "text": "Don Juan est mort, Don Juan s'en va",
      "start": 7344,
      "duration": 7.0
    },
    {
      "text": "Peut-être que tout le monde avait tort",
      "start": 7351,
      "duration": 3.75
    },
    {
      "text": "Peut-être qu'on n'avait pas le droit",
      "start": 7354.75,
      "duration": 3.25
    },
    {
      "text": "De le juger sans le comprendre",
      "start": 7358,
      "duration": 6.84
    },
    {
      "text": "Personne ne pourra jamais",
      "start": 7366,
      "duration": 2.609
    },
    {
      "text": "Donner ce qu'on voulait lui prendre",
      "start": 7368.609,
      "duration": 3.391
    },
