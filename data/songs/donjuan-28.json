  "cues": [
    {
      "text": "Toi qui reviens comme un soldat",
      "start": 4706,
      "duration": 4.174
    },
    {
      "text": "Fier de tes médailles, tes combats",
      "start": 4710.174,
      "duration": 3.826
    },
    {
      "text": "Toi qui reviens comme un héros",
      "start": 4714,
      "duration": 4.114
    },
    {
      "text": "Sais-tu ce qu'elle a fait sans toi",
      "start": 4718.114,
      "duration": 4.456
    },
    {
      "text": "Celle que tu aimes ne t'attend pas",
      "start": 4724,
      "duration": 3.84
    },
    {
      "text": "Toi qui avais mis ta confiance",
      "start": 4727.84,
      "duration": 4.16
    },
    {
      "text": "Dans les beaux yeux de Maria",
      "start": 4732,
      "duration": 4.5
    },
    {
      "text": "C'est avec un autre qu'elle danse",
      "start": 4736.5,
      "duration": 4.5
    },
    {
      "text": "Et elle dansera bien crois-moi",
      "start": 4741,
      "duration": 4.591
    },
    {
      "text": "Son cavalier était à moi",
      "start": 4745.591,
      "duration": 4.209
    },
    {
      "text": "Venge-nous, venge-toi",
      "start": 4750,
      "duration": 4.632
    },
    {
      "text": "Le prix de la trahison passe par-là",
      "start": 4754.632,
      "duration": 6.368
    },
    {
      "text": "Venge-toi, venge-nous",
      "start": 4761,
      "duration": 6.0
    },
    {
      "text": "Fais ça pour toi, fais ça pour nous",
      "start": 4767,
      "duration": 5.939
    },
    {
      "text": "Moi qui reviens de la guerre",
      "start": 4772.939,
      "duration": 5.091
    },
    {
      "text": "Je n'y ai pas vu de vipère",
      "start": 4779,
      "duration": 4.5
    },
    {
      "text": "Ayant un venin si violent",
      "start": 4783.5,
      "duration": 4.5
    },
    {
      "text": "Pour me faire tellement mal tellement",
      "start": 4788,
      "duration": 5.669
    },
    {
      "text": "Moi qui reviens de l'enfer",
      "start": 4793.669,
      "duration": 4.361
    },
    {
      "text": "Je n'y ai pas vu de panthère",
      "start": 4799,
      "duration": 3.81
    },
    {
      "text": "Aux griffes et aux crocs si tranchants",
      "start": 4802.81,
      "duration": 4.19
    },
    {
      "text": "Pour me faire tellement mal tellement",
      "start": 4807,
      "duration": 6.24
    },
    {
      "text": "Toi qui reviens comme un soldat",
      "start": 4813.24,
      "duration": 5.76
    },
    {
      "text": "Fier de tes médailles, tes combats",
      "start": 4819,
      "duration": 4.19
    },
    {
      "text": "Sais-tu qu'ils ont sali ton nom",
      "start": 4823.19,
      "duration": 3.81
    },
    {
      "text": "Et ton honneur à la fois",
      "start": 4827,
      "duration": 4.65
    },
    {
      "text": "Venge-toi, venge-moi",
      "start": 4832,
      "duration": 7.88
    },
    {
      "text": "La souffrance c'est une histoire pour nous",
      "start": 4840,
      "duration": 6.034
    },
    {
      "text": "La souffrance c'est une histoire de fous",
      "start": 4846.034,
      "duration": 5.656
    },
    {
      "text": "On ne sait plus ce qu'il faut faire après tout",
      "start": 4853,
      "duration": 6.99
    },
    {
      "text": "Se venger ou laisser faire la vie",
      "start": 4860,
      "duration": 5.39
    },
    {
      "text": "Oublier et pleurer seul tant pis",
      "start": 4867,
      "duration": 6.755
    },
    {
      "text": "C'est le dilemme",
      "start": 4873.755,
      "duration": 2.815
    },
    {
      "text": "Faut-il punir ceux qu'on aime",
      "start": 4877,
      "duration": 4.99
    }
