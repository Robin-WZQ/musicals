  "cues": [
    {
      "text": "Et je savais que tu étais là.",
      "start": 560,
      "duration": 5.31
    },
    {
      "text": "Entends-tu les hommes te haïr",
      "start": 568,
      "duration": 2.424
    },
    {
      "text": "Et les femmes te maudire?",
      "start": 570.424,
      "duration": 2.423
    },
    {
      "text": "Ne détourne pas les yeux.",
      "start": 572.847,
      "duration": 2.693
    },
    {
      "text": "Je ne viens pas te parler de moi mais de toi.",
      "start": 577,
      "duration": 4.27
    },
    {
      "text": "Don Juan, Don Juan",
      "start": 582,
      "duration": 1.655
    },
    {
      "text": "Ton nom sonne comme une menace",
      "start": 583.655,
      "duration": 3.035
    },
    {
      "text": "À chaque femme que tu enlaces",
      "start": 586.69,
      "duration": 3.31
    },
    {
      "text": "Don Juan",
      "start": 590,
      "duration": 0.92
    },
    {
      "text": "Mais qui pourra prendre une place",
      "start": 590.92,
      "duration": 3.989
    },
    {
      "text": "Dans ce cœur qui ne bat pas vraiment",
      "start": 594.909,
      "duration": 3.681
    },
    {
      "text": "Don Juan",
      "start": 599,
      "duration": 1.378
    },
    {
      "text": "Toi qui me fais encore souffrir",
      "start": 600.378,
      "duration": 5.972
    },
    {
      "text": "C'est pour toi que je crains le pire",
      "start": 607,
      "duration": 4.333
    },
    {
      "text": "Faut-il donc que tu les méprises",
      "start": 611.333,
      "duration": 3.667
    },
    {
      "text": "Toutes ces femmes qui t'ont aimé",
      "start": 615,
      "duration": 2.471
    },
    {
      "text": "Que la sueur sur ta chemise",
      "start": 617.471,
      "duration": 2.264
    },
    {
      "text": "Ne soit leur unique bûcher",
      "start": 619.735,
      "duration": 2.265
    },
    {
      "text": "N'as-tu jamais connu l'amour",
      "start": 622,
      "duration": 1.944
    },
    {
      "text": "N'as-tu pas peur de les manquer",
      "start": 623.944,
      "duration": 1.945
    },
    {
      "text": "Toutes ces femmes qui n'avaient qu'un jour",
      "start": 625.889,
      "duration": 3.111
    },
    {
      "text": "Contre une vie à te donner",
      "start": 629,
      "duration": 3.71
    },
    {
      "text": "Faut-il que tu cherches partout",
      "start": 651,
      "duration": 2.562
    },
    {
      "text": "Sans être sûr de le trouver",
      "start": 653.562,
      "duration": 2.097
    },
    {
      "text": "C'est pas parce qu'on aime beaucoup",
      "start": 655.659,
      "duration": 3.261
    },
    {
      "text": "Qu'on sera plus fort pour aimer",
      "start": 659,
      "duration": 2.265
    },
    {
      "text": "Ce n'est que sur un cœur de pierre",
      "start": 661.265,
      "duration": 2.47
    },
    {
      "text": "Que tu les serres tour à tour",
      "start": 663.735,
      "duration": 2.265
    },
    {
      "text": "Prends garde que ce ne soit l'enfer",
      "start": 666,
      "duration": 3.581
    },
    {
      "text": "La dernière ombre de l'amour",
      "start": 669.581,
      "duration": 3.582
    },
    {
      "text": "Et qu'il ne reste que le diable",
      "start": 673.163,
      "duration": 3.907
    },
    {
      "text": "Comme seul invité à ta table",
      "start": 678,
      "duration": 9.0
    }
  ],
