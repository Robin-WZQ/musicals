  "cues": [
    {
      "text": "Don Luis Tenorio,",
      "start": 864,
      "duration": 7.65
    },
    {
      "text": "Je vous en prie écoutez-moi",
      "start": 872,
      "duration": 3.5
    },
    {
      "text": "Je viens parler de mon bourreau",
      "start": 875.5,
      "duration": 3.5
    },
    {
      "text": "De votre fils, ce scélérat",
      "start": 879,
      "duration": 3.187
    },
    {
      "text": "Je vous respecte vous savez",
      "start": 882.187,
      "duration": 3.983
    },
    {
      "text": "Voyez ce qu'il a fait de moi",
      "start": 887,
      "duration": 3.0
    },
    {
      "text": "Une maîtresse, une poupée",
      "start": 890.0,
      "duration": 3.0
    },
    {
      "text": "Ce qu'il promet, il le tient pas",
      "start": 893,
      "duration": 5.52
    },
    {
      "text": "Je vous en prie, parlez-lui",
      "start": 898.52,
      "duration": 5.52
    },
    {
      "text": "Dites-lui qu'il y a une fille qui pleure",
      "start": 905,
      "duration": 3.839
    },
    {
      "text": "Qui a mal et qui prie et qui meurt",
      "start": 908.839,
      "duration": 3.161
    },
    {
      "text": "Dites-lui tout ce qu'il m'a promis",
      "start": 912,
      "duration": 3.258
    },
    {
      "text": "Lui qui m'a épousée et trahie.",
      "start": 915.258,
      "duration": 3.802
    },
    {
      "text": "Vous connaissez bien ma famille",
      "start": 920,
      "duration": 3.44
    },
    {
      "text": "Comment pourrais-je leur apprendre",
      "start": 923.44,
      "duration": 3.44
    },
    {
      "text": "Je suis la putain de Séville",
      "start": 927,
      "duration": 3.273
    },
    {
      "text": "Essayez de lui faire comprendre",
      "start": 930.273,
      "duration": 3.867
    },
    {
      "text": "Je vous en prie, parlez-lui",
      "start": 935,
