  "cues": [
    {
      "text": "Et qu'ils parlent de moi",
      "start": 687,
      "duration": 2.667
    },
    {
      "text": "Qu'est-ce que ça peut me faire",
      "start": 689.667,
      "duration": 4.0
    },
    {
      "text": "Quand ils seront le bois, moi",
      "start": 693.667,
      "duration": 3.333
    },
    {
      "text": "Je serai le fer",
      "start": 697,
      "duration": 2.04
    },
    {
      "text": "Et s'ils sont trop nombreux",
      "start": 699.04,
      "duration": 2.38
    },
    {
      "text": "Je deviendrai le feu",
      "start": 701.42,
      "duration": 3.06
    },
    {
      "text": "Mon nom se porte comme une peine",
      "start": 707,
      "duration": 2.087
    },
    {
      "text": "Comme une croix, comme un fardeau",
      "start": 709.087,
      "duration": 2.261
    },
    {
      "text": "Comme le vent qui se déchaîne",
      "start": 711.348,
      "duration": 1.913
    },
    {
      "text": "Sur le plus petit des bateaux",
      "start": 713.261,
      "duration": 1.739
    },
    {
      "text": "Mais il faut que tu te souviennes",
      "start": 715,
      "duration": 2.739
    },
    {
      "text": "Tant que je vis je reste fort",
      "start": 717.739,
      "duration": 1.761
    },
    {
      "text": "Tant que leur sang brûle mes veines",
      "start": 719.5,
      "duration": 2.348
    },
    {
      "text": "Les femmes me trouveront encore",
      "start": 721.848,
      "duration": 2.152
    },
    {
      "text": "Mon nom se porte comme un couteau",
      "start": 724,
      "duration": 2.261
    },
    {
      "text": "Qui transperce le cœur et l'âme",
      "start": 726.261,
      "duration": 1.913
    },
    {
      "text": "Et laisse gravée sur la peau",
      "start": 728.174,
      "duration": 2.087
    },
    {
      "text": "La marque brûlante des flammes",
      "start": 730.261,
      "duration": 1.739
    },
    {
      "text": "Mon nom traversera le temps",
      "start": 732,
      "duration": 1.895
    },
    {
      "text": "Même 1000 ans après ma mort",
      "start": 733.895,
      "duration": 1.658
    },
    {
      "text": "Et quand elles le voudront vraiment",
      "start": 735.553,
      "duration": 2.842
    },
    {
      "text": "Les femmes me trouveront encore",
      "start": 738.395,
      "duration": 2.605
    },
    {
      "text": "Mon nom se porte comme un signe",
      "start": 741,
      "duration": 1.818
    },
    {
      "text": "Pour celles qui rencontrent le diable",
      "start": 742.818,
      "duration": 2.364
    },
    {
      "text": "Un signe de croix invisible",
      "start": 745.182,
      "duration": 1.818
    },
    {
      "text": "Qui rend les puissants misérables",
      "start": 747.0,
      "duration": 2.0
    },
    {
      "text": "Mon nom est celui que j'entends",
      "start": 749,
      "duration": 2.143
    },
    {
      "text": "Sur les mots brûlants de leurs corps",
      "start": 751.143,
      "duration": 1.928
    },
    {
      "text": "Et quand elles le voudront vraiment",
      "start": 753.071,
      "duration": 2.572
    },
    {
      "text": "Les femmes me trouveront encore",
      "start": 755.643,
      "duration": 2.357
    },
    {
      "text": "Mon nom se porte comme un piège",
      "start": 758,
      "duration": 1.956
    },
    {
      "text": "Où les proies aiment à se donner",
      "start": 759.956,
      "duration": 2.311
    },
    {
      "text": "Comme une faute, un sacrilège",
      "start": 762.267,
      "duration": 2.133
    },
    {
      "text": "Un péché pour l'éternité",
      "start": 764.4,
      "duration": 1.6
    },
    {
      "text": "Mon nom sera une étincelle",
      "start": 766,
      "duration": 2.327
    },
    {
      "text": "Qui brillera de plus en plus fort",
      "start": 768.327,
      "duration": 2.326
    },
    {
      "text": "Et tant que l'amour est cruel",
      "start": 770.653,
      "duration": 2.327
    },
    {
      "text": "Les femmes me trouveront encore",
      "start": 773,
      "duration": 3.84
    },
    {
      "text": "Mon nom c'est le cri de l'amour",
      "start": 784,
      "duration": 1.674
    },
    {
      "text": "Quand il sera beaucoup trop tard",
      "start": 785.674,
      "duration": 2.233
    },
    {
      "text": "Le cri d'un appel au secours",
      "start": 787.907,
      "duration": 1.86
    },
    {
      "text": "Qui brûlera dans leurs mémoires",
      "start": 789.767,
      "duration": 2.233
    },
    {
      "text": "Mon nom est un feu immortel",
      "start": 792,
      "duration": 1.688
    },
    {
      "text": "Pour celle qui peut-être ont eu tort",
      "start": 793.688,
      "duration": 2.624
    },
    {
      "text": "Mais tant que leurs yeux me rappellent",
      "start": 796.312,
      "duration": 2.626
    },
    {
      "text": "Les femmes me trouveront encore",
      "start": 798.938,
      "duration": 2.062
