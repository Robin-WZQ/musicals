  "lyricsStorage": "user-provided",
  "cues": [
    {
      "text": "Tous ceux qui s'aiment",
      "start": 5543,
      "duration": 9.038
    },
    {
      "text": "Vive Figaro!",
      "start": 5552.038,
      "duration": 5.021
    },
    {
      "text": "Aloysia!",
      "start": 5559,
      "duration": 1.567
    },
    {
      "text": "Aloysia, jeune sœur.",
      "start": 5560.567,
      "duration": 3.133
    },
    {
      "text": "Faisons la noce",
      "start": 5565,
      "duration": 2.76
    },
    {
      "text": "Pour fêter Figaro",
      "start": 5567.76,
      "duration": 3.22
    },
    {
      "text": "Mozart est un génie",
      "start": 5573,
      "duration": 4.0
    },
    {
      "text": "Quel tour de force",
      "start": 5577.0,
      "duration": 4.0
    },
    {
      "text": "Sortir sous les bravos",
      "start": 5581,
      "duration": 4.846
    },
    {
      "text": "Devant tant d'ennemis",
      "start": 5585.846,
      "duration": 4.154
    },
    {
      "text": "Malgré les malfaisants, Mozart a réussi",
      "start": 5590,
      "duration": 3.171
    },
    {
      "text": "Malgré les intrigants, le triomphe est acquis",
      "start": 5593.171,
      "duration": 3.414
    },
    {
      "text": "Au nez des courtisans, il en ressort grandi",
      "start": 5596.585,
      "duration": 3.415
    },
    {
      "text": "La vipère Rosenberg est au tapis",
      "start": 5600,
      "duration": 4.165
    },
    {
      "text": "Vive Figaro!",
      "start": 5604.165,
      "duration": 1.735
    },
    {
      "text": "Youhou!",
      "start": 5613,
      "duration": 1.197
    },
    {
      "text": "Je peux m'amuser?",
      "start": 5614.197,
      "duration": 1.436
    },
    {
      "text": "J'aimerais apporter ma contribution à votre petite fête.",
      "start": 5615.633,
      "duration": 5.267
    },
    {
      "text": "Finies,",
      "start": 5621,
      "duration": 0.638
    },
    {
      "text": "Les Noces de Figaro!",
      "start": 5621.638,
      "duration": 1.49
    },
    {
      "text": "Retiré de l'affiche, sur ordre de",
      "start": 5623.128,
      "duration": 2.34
    },
    {
      "text": "Sa Majesté.",
      "start": 5625.468,
      "duration": 0.851
    },
    {
      "text": "Mais enfin, vous mentez.",
      "start": 5626.319,
      "duration": 1.702
    },
    {
      "text": "Jamais l'empereur trahirait mon mari!",
      "start": 5628.021,
      "duration": 2.979
    },
    {
      "text": "Vous l'avez monté contre Mozart",
      "start": 5631,
      "duration": 2.727
    },
    {
      "text": "avec vos calomnies!",
      "start": 5633.727,
      "duration": 1.909
    },
    {
      "text": "Psst!",
      "start": 5635.636,
      "duration": 0.273
    },
    {
      "text": "Wolfgang est le plus grand compositeur de Vienne!",
      "start": 5635.909,
      "duration": 4.091
    },
    {
      "text": "Ouais!",
      "start": 5640,
      "duration": 2.0
    },
    {
      "text": "Une furie!",
      "start": 5642,
      "duration": 0.957
    },
    {
      "text": "Vous direz à votre compositeur qu'il n'est plus rien!",
      "start": 5642.957,
      "duration": 3.447
    },
    {
      "text": "Toutes les portes lui seront fermées.",
      "start": 5646.404,
      "duration": 2.49
    },
    {
      "text": "Plus personne ne voudra de lui.",
      "start": 5648.894,
      "duration": 2.106
    },
    {
      "text": "Personne!",
      "start": 5651,
      "duration": 1.45
    },
    {
      "text": "Personne!",
      "start": 5652.45,
      "duration": 1.45
    },
    {
      "text": "Non, Mozart, cette fin ne va pas du tout.",
      "start": 5668,
      "duration": 3.0
    },
    {
      "text": "Don Juan englouti dans",
      "start": 5671,
      "duration": 1.524
    },
    {
      "text": "Les Enfers!",
      "start": 5672.524,
      "duration": 0.571
    },
    {
      "text": "On ne peut pas terminer ainsi, il nous faut une scène ultime, une note positive.",
      "start": 5673.095,
      "duration": 5.905
    },
    {
      "text": "Il faut absolument effacer l'effet désastreux des Noces de Figaro.",
      "start": 5679,
      "duration": 4.705
    },
    {
      "text": "Vous devez vous réconcilier avec votre public.",
      "start": 5683.705,
      "duration": 3.477
    },
    {
      "text": "Quel public?",
      "start": 5687.182,
      "duration": 0.818
    },
    {
      "text": "Celui qui vous célèbre un jour et qui vous abat le lendemain?",
      "start": 5688,
      "duration": 4.62
    },
    {
      "text": "Mais nous sommes à 3 mois du début des répétitions, et nous n'avons même pas un acte de prêt.",
      "start": 5695,
      "duration": 7.869
    },
    {
      "text": "Wolfgang, que se passe-t-il?",
      "start": 5702.869,
      "duration": 2.031
    },
    {
      "text": "Mon père est malade.",
      "start": 5705,
      "duration": 2.09
    },
    {
      "text": "J'ai un mauvais pressentiment.",
      "start": 5707.09,
      "duration": 3.283
    },
    {
      "text": "Alors, que faisons-nous?",
      "start": 5710.373,
      "duration": 2.687
    },
    {
      "text": "Moi, je pars pour Salzbourg.",
      "start": 5715,
      "duration": 1.909
    },
    {
      "text": "Je vais veiller sur lui.",
      "start": 5716.909,
      "duration": 1.909
    },
    {
      "text": "Il est trop tard, vous ne rattraperez pas le passé.",
      "start": 5718.818,
      "duration": 3.182
    },
    {
      "text": "Comment pouvez-vous dire cela?",
      "start": 5722,
      "duration": 2.256
    },
    {
      "text": "C'est mon père, je lui dois tout.",
      "start": 5724.256,
      "duration": 2.257
    },
    {
      "text": "Sûrement pas votre génie.",
      "start": 5726.513,
      "duration": 1.846
    },
    {
      "text": "Reprenons, s'il vous plaît.",
      "start": 5728.359,
      "duration": 1.641
    },
    {
      "text": "Le génie?",
      "start": 5730,
      "duration": 1.82
    },
    {
      "text": "Le génie, Da Ponte, c'est aussi l'amour qu'il m'a donné, ce sont les attentions auprès d'un enfant",
      "start": 5733,
      "duration": 6.0
    },
    {
      "text": "et sa passion pour la musique, dont il a fait toute ma vie.",
      "start": 5739,
      "duration": 5.0
    }
  ],
