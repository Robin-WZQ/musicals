  "cues": [
    {
      "text": "J'ai gardé peu de souvenirs de ma mère",
      "start": 25.364,
      "duration": 3.272
    },
    {
      "text": "Une voix apaisante, une image évanescente",
      "start": 28.636,
      "duration": 2.182
    },
    {
      "text": "Tapie dans un coin de mon imaginaire",
      "start": 30.818,
      "duration": 2.451
    },
    {
      "text": "De ma naissance, on m'a rien dit",
      "start": 33.269,
      "duration": 2.423
    },
    {
      "text": "Puis un jour ma mère m'a écrit",
      "start": 35.692,
      "duration": 2.154
    },
    {
      "text": "Elle m'a appris que j'étais l'illégitime enfant",
      "start": 37.846,
      "duration": 2.79
    },
    {
      "text": "D'une comédienne et d'un chambellan",
      "start": 40.636,
      "duration": 3.819
    },
    {
      "text": "Saura-t-elle un jour effacer",
      "start": 44.455,
      "duration": 6.116
    },
    {
      "text": "Les ombres et les fantômes du passé?",
      "start": 50.571,
      "duration": 7.858
    },
    {
      "text": "Pourra-t-elle un jour enfin me donner",
      "start": 58.429,
      "duration": 6.116
    },
    {
      "text": "L'amour dont elle m'a privé?",
      "start": 64.545,
      "duration": 5.741
    },
    {
      "text": "Pendant toutes ces années je n'ai cessé",
      "start": 70.286,
      "duration": 2.285
    },
    {
      "text": "De m'enquérir de ses nouvelles",
      "start": 72.571,
      "duration": 1.715
    },
    {
      "text": "On m'écrivait qu'Armande me ressemblait",
      "start": 74.286,
      "duration": 2.0
    },
    {
      "text": "Qu'elle était volontaire et rebelle",
      "start": 76.286,
      "duration": 1.714
    },
    {
      "text": "Quand elle devint suffisamment grande",
      "start": 78.0,
      "duration": 1.6
    },
    {
      "text": "En âge enfin de comprendre",
      "start": 79.6,
      "duration": 1.28
    },
    {
      "text": "Dans une longue lettre je lui ai tout raconté",
      "start": 80.88,
      "duration": 2.88
    },
    {
      "text": "En lui promettant de venir bientôt la chercher",
      "start": 83.76,
      "duration": 4.24
    },
    {
      "text": "Pourra-t-elle un jour me pardonner",
      "start": 88.0,
      "duration": 8.0
    },
    {
      "text": "De l'avoir abandonnée?",
      "start": 96.0,
      "duration": 2.0
    },
    {
      "text": "De n'avoir jamais pu lui donner",
      "start": 98.0,
      "duration": 11.167
    },
    {
      "text": "L'amour que je lui devais",
      "start": 109.167,
      "duration": 6.583
    },
    {
      "text": "L'amour dont elle m'a privé",
      "start": 115.75,
      "duration": 4.5
    },
    {
      "text": "Pendant toutes ces années",
      "start": 120.25,
      "duration": 3.0
    },
    {
      "text": "Et dans le plus grand des secrets",
      "start": 123.25,
      "duration": 2.528
    },
    {
      "text": "À la comédie je n'ai cessé de m'exercer",
      "start": 125.778,
      "duration": 2.963
    },
    {
      "text": "Je me suis juré d'en faire mon métier",
      "start": 128.741,
      "duration": 2.666
    },
    {
      "text": "Je me suis juré d'atteindre les sommets",
      "start": 131.407,
      "duration": 2.993
    },
    {
      "text": "Je me suis juré qu'un jour",
      "start": 134.4,
      "duration": 2.8
    },
    {
      "text": "Mon étoile brillera bien plus fort que celle de ma mère",
      "start": 137.2,
      "duration": 8.8
    }
  ],
