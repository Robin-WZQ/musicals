  "cues": [
    {
      "text": "Petit poltron",
      "start": 3221,
      "duration": 2.536
    },
    {
      "text": "Veut devenir grand",
      "start": 3223.536,
      "duration": 3.804
    },
    {
      "text": "Mais il reste",
      "start": 3229,
      "duration": 3.192
    },
    {
      "text": "Assis",
      "start": 3232.192,
      "duration": 1.276
    },
    {
      "text": "Petit bouffon",
      "start": 3233.468,
      "duration": 3.192
    },
    {
      "text": "Insulte le sultan",
      "start": 3237,
      "duration": 4.5
    },
    {
      "text": "Mais il est",
      "start": 3241.5,
      "duration": 3.0
    },
    {
      "text": "Puni",
      "start": 3244.5,
      "duration": 1.5
    },
    {
      "text": "La vie est injuste, mais ça dépend pour qui",
      "start": 3246,
      "duration": 3.339
    },
    {
      "text": "La vie est injuste, surtout pour les petits",
      "start": 3249.339,
      "duration": 3.13
    },
    {
      "text": "La vie est injuste, c'est pour ça qu'on rit",
      "start": 3252.469,
      "duration": 2.921
    },
    {
      "text": "Chez les grands, les puissants, les pourris rient",
      "start": 3256,
      "duration": 3.152
    },
    {
      "text": "Mon cher frère, je sais que ta vie à Vienne est un enfer.",
      "start": 3259.152,
      "duration": 4.848
    },
    {
      "text": "Mais tiens bon.",
      "start": 3264,
      "duration": 1.111
    },
    {
      "text": "Comment, monsieur Mozart, vous annulez nos répétitions?",
      "start": 3265.111,
      "duration": 4.222
    },
    {
      "text": "Je vous parle,",
      "start": 3269.333,
      "duration": 1.111
    },
    {
      "text": "Herr Mozart, est-il sourd?",
      "start": 3270.444,
      "duration": 1.556
    },
    {
      "text": "Il est sourd.",
      "start": 3272,
      "duration": 2.18
    },
    {
      "text": "Aimons-nous les uns, les autres",
      "start": 3275,
      "duration": 4.053
    },
    {
      "text": "Comédie, tragédie",
      "start": 3279.053,
      "duration": 2.947
    },
    {
      "text": "Tous les enfants sont les nôtres",
      "start": 3282,
      "duration": 3.43
    },
    {
      "text": "Comédie, tragédie",
      "start": 3285.43,
      "duration": 3.05
    },
    {
      "text": "Peu importe les coups",
      "start": 3288.48,
      "duration": 3.049
    },
    {
      "text": "Tu tendras l'autre joue",
      "start": 3292,
      "duration": 2.423
    },
    {
      "text": "Comédie, tragédie",
      "start": 3294.423,
      "duration": 2.154
    },
    {
      "text": "Heureux, les miséreux",
      "start": 3296.577,
      "duration": 2.423
    },
    {
      "text": "Élus au royaume des cieux",
      "start": 3299,
      "duration": 3.5
    },
    {
      "text": "Monsieur Mozart, qu'est-ce que j'apprends?",
      "start": 3302.5,
      "duration": 3.5
    },
    {
      "text": "Colloredo vous interdit de venir dans mes salons?",
      "start": 3306,
      "duration": 5.177
    },
    {
      "text": "Quel dommage!",
      "start": 3311.177,
      "duration": 1.618
    },
    {
      "text": "Quel dommage!",
      "start": 3312.795,
      "duration": 1.618
    },
    {
      "text": "Assez!",
      "start": 3314.413,
      "duration": 0.647
    },
    {
      "text": "Monsieur le mufti, seigneur des petits esprits, regardez-moi bien une dernière fois.",
      "start": 3317,
      "duration": 5.0
    },
    {
      "text": "Moi, Wolfgang Amadeus Mozart, je vous remets dès ce soir ma démission.",
      "start": 3322,
      "duration": 6.0
    },
    {
      "text": "Vous entendez?",
      "start": 3328.0,
      "duration": 1.25
    },
    {
      "text": "Je suis libre!",
      "start": 3329.25,
      "duration": 1.25
    },
    {
      "text": "Libre!",
      "start": 3330.5,
      "duration": 0.5
    }
  ],
