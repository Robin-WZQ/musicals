  "cues": [
    {
      "text": "Avoir 20 ans, c'est goûter au plaisir",
      "start": 8640,
      "duration": 4.0
    },
    {
      "text": "Les femmes, le vin, les hommes et même pire",
      "start": 8644.0,
      "duration": 4.0
    },
    {
      "text": "Avoir 20 ans, c'est jusqu'au matin",
      "start": 8648,
      "duration": 3.85
    },
    {
      "text": "Changer de corps, changer de mains",
      "start": 8651.85,
      "duration": 3.15
    },
    {
      "text": "Avoir 20 ans, c'est gratter sur des guitares",
      "start": 8655,
      "duration": 3.852
    },
    {
      "text": "Des accords faux qu'on oubliera plus tard",
      "start": 8658.852,
      "duration": 4.148
    },
    {
      "text": "Avoir 20 ans, c'est jusqu'au matin",
      "start": 8663,
      "duration": 3.385
    },
    {
      "text": "Refaire le monde même si ça change rien",
      "start": 8666.385,
      "duration": 4.615
    },
    {
      "text": "Avoir 20 ans, c'est rêver tout haut",
      "start": 8671,
      "duration": 2.75
    },
    {
      "text": "Que le monde est beau",
      "start": 8673.75,
      "duration": 2.25
    },
    {
      "text": "Même si on sait bien qu'c'est faux",
      "start": 8676.0,
      "duration": 3.0
    },
    {
      "text": "Nous, on n'a rien du tout,",
      "start": 8679,
      "duration": 2.4
    },
    {
      "text": "La vie devant nous,",
      "start": 8681.4,
      "duration": 1.867
    },
    {
      "text": "Oui mais on l'avoue,",
      "start": 8683.267,
      "duration": 2.666
    },
    {
      "text": "On s'en fout",
      "start": 8685.933,
      "duration": 1.067
    },
    {
      "text": "Nous, on veut pas d'médailles,",
      "start": 8687,
      "duration": 3.103
    },
    {
      "text": "Pas gagner d'batailles,",
      "start": 8690.103,
      "duration": 2.173
    },
    {
      "text": "Mais pour ce qu'on croit",
      "start": 8692.276,
      "duration": 2.793
    },
    {
      "text": "On s'battra",
      "start": 8695.069,
      "duration": 0.931
    },
    {
      "text": "A 20 ans, rien ne vous tue, mais tout vous blesse",
      "start": 8696,
      "duration": 4.935
    },
    {
      "text": "Vos trahisons, vos secrets, on vous les laisse",
      "start": 8700.935,
      "duration": 4.065
    },
    {
      "text": "Avoir 20 ans, c'est trembler de peur",
      "start": 8705,
      "duration": 3.81
    },
    {
      "text": "D'oser aimer, d'ouvrir son cœur",
      "start": 8708.81,
      "duration": 4.19
    },
    {
      "text": "Avoir 20 ans, c'est crier sa colère,",
      "start": 8713,
      "duration": 3.348
    },
    {
      "text": "Jurer d'jamais ressembler à son père",
      "start": 8716.348,
      "duration": 3.652
    },
    {
      "text": "Avoir 20 ans, c'est donner des coups,",
      "start": 8720,
      "duration": 3.333
    },
    {
      "text": "Ne croire en rien mais attendre tout",
