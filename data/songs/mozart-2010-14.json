  "cues": [
    {
      "text": "Mais d'où vient l'émotion étrange",
      "start": 4249,
      "duration": 2.476
    },
    {
      "text": "Qui me fascine autant qu'elle me dérange",
      "start": 4251.476,
      "duration": 3.048
    },
    {
      "text": "Je frissonne poignardé par le beau",
      "start": 4254.524,
      "duration": 2.476
    },
    {
      "text": "C'est comme dans l'âme le couteau",
      "start": 4257,
      "duration": 2.887
    },
    {
      "text": "La blessure traverse mon coeur",
      "start": 4259.887,
      "duration": 2.646
    },
    {
      "text": "Et j'ai la joie dans la douleur",
      "start": 4262.533,
      "duration": 3.127
    },
    {
      "text": "Je m'enivre de ce poison",
      "start": 4266,
      "duration": 2.375
    },
    {
      "text": "À en perdre la raison",
      "start": 4268.375,
      "duration": 2.11
    },
    {
      "text": "C'est le bien qui fait mal",
      "start": 4270.485,
      "duration": 2.375
    },
    {
      "text": "Quand tu aimes tout à fait normal",
      "start": 4274,
      "duration": 2.853
    },
    {
      "text": "Ta haine prend le plaisir",
      "start": 4276.853,
      "duration": 1.975
    },
    {
      "text": "C'est si bon de souffrir",
      "start": 4278.828,
      "duration": 1.536
    },
    {
      "text": "Succombe au charme",
      "start": 4280.364,
      "duration": 1.536
    },
    {
      "text": "Donne tes larmes",
      "start": 4282,
      "duration": 0.8
    },
    {
      "text": "C'est le bien qui fait mal",
      "start": 4282.8,
      "duration": 1.44
    },
    {
      "text": "Je me fais mal",
      "start": 4284.24,
      "duration": 0.8
    },
    {
      "text": "Quand tu aimes tout à fait banal",
      "start": 4285.04,
      "duration": 2.08
    },
    {
      "text": "Ce bien qui fait mal",
      "start": 4287.12,
      "duration": 1.28
    },
    {
      "text": "Ta peine, les vrais délices",
      "start": 4288.4,
      "duration": 1.6
    },
    {
      "text": "Passent par le supplice",
      "start": 4290,
      "duration": 1.878
    },
    {
      "text": "Baisse les armes",
      "start": 4291.878,
      "duration": 1.61
    },
    {
      "text": "Donne tes larmes",
      "start": 4293.488,
      "duration": 1.341
    },
    {
      "text": "Je ressens de violentes pulsions",
      "start": 4294.829,
      "duration": 2.951
    },
    {
      "text": "J'ai l'impression de glisser vers le fond",
      "start": 4298,
      "duration": 2.983
    },
    {
      "text": "Si j'ignore d'où vient ce fléau",
      "start": 4300.983,
      "duration": 2.983
    },
    {
      "text": "J'adore l'avoir dans la peau",
      "start": 4303.966,
      "duration": 2.734
    },
    {
      "text": "Envoûté par des idées folles",
      "start": 4307,
      "duration": 3.194
    },
    {
      "text": "Soudain mes envies s'envolent",
      "start": 4310.194,
      "duration": 3.193
    },
    {
      "text": "Le désir devient ma prison",
      "start": 4313.387,
      "duration": 2.613
    },
    {
      "text": "À en perdre la raison",
      "start": 4316,
      "duration": 1.851
