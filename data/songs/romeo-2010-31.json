    },
    {
      "text": "On prie.",
      "start": 6585.5,
      "duration": 3.5
    },
    {
      "text": "On prie pour nos parents pour nos frères.",
      "start": 6589,
      "duration": 5.652
    },
    {
      "text": "Dos courbé, genoux à terre.",
      "start": 6594.652,
      "duration": 4.348
    },
    {
      "text": "On te cherche et on se perd.",
      "start": 6599,
      "duration": 6.0
    },
    {
      "text": "Quand on vit loin du monde",
      "start": 6605,
      "duration": 3.818
    },
    {
      "text": "On croit qu'on vit en paix",
      "start": 6608.818,
      "duration": 3.818
    },
    {
      "text": "Mais quand la terre gronde...",
