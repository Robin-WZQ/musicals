  "cues": [
    {
      "text": "Le sourire qui s'allume",
      "start": 5744,
      "duration": 11.0
    },
    {
      "text": "Le regard qui s'embrume",
      "start": 5755,
      "duration": 4.4
    },
    {
      "text": "Et tu t'en vas danser au ciel",
      "start": 5759.4,
      "duration": 5.5
    },
    {
      "text": "Tu m'apaises, tu me mens",
      "start": 5766,
      "duration": 3.294
    },
    {
      "text": "Puis tu glisses doucement",
      "start": 5769.294,
      "duration": 3.706
    },
    {
      "text": "Vers le plus beau des sommeils",
      "start": 5773,
      "duration": 6.429
    },
    {
      "text": "Dors, mon ange",
      "start": 5779.429,
      "duration": 2.571
    },
    {
      "text": "Dans l'éternelle candeur",
      "start": 5782,
      "duration": 4.667
    },
    {
      "text": "Dors, mon ange",
      "start": 5786.667,
      "duration": 2.333
    },
    {
      "text": "Le ciel est ta demeure",
      "start": 5789,
      "duration": 4.765
    },
    {
      "text": "Vole, mon ange",
      "start": 5793.765,
      "duration": 2.647
    },
    {
      "text": "La vie",
      "start": 5796.412,
      "duration": 1.588
    },
    {
      "text": "Est plus douce ailleurs",
      "start": 5798,
      "duration": 9.0
    },
    {
      "text": "Dors",
      "start": 5807.0,
      "duration": 1.0
    },
    {
      "text": "Dors",
      "start": 5808,
      "duration": 1.0
    },
    {
      "text": "Dors",
      "start": 5809.0,
      "duration": 1.0
    },
    {
      "text": "Mon ange, dors",
      "start": 5810.0,
      "duration": 4.0
    },
    {
      "text": "Les cloches sonnent l'Angélus",
      "start": 5814,
      "duration": 6.384
    },
    {
      "text": "Vole",
      "start": 5820.384,
      "duration": 1.596
    },
    {
      "text": "Vole",
      "start": 5822,
      "duration": 0.947
    },
    {
      "text": "Vole",
      "start": 5822.947,
      "duration": 0.948
    },
    {
      "text": "C'est mon enfance qui s'envole",
      "start": 5823.895,
      "duration": 4.737
    },
    {
      "text": "Ce sont mes rêves",
      "start": 5828.632,
      "duration": 2.368
    },
    {
      "text": "Que l'on viole",
      "start": 5831,
      "duration": 3.429
    },
    {
      "text": "Je suis un funambule",
      "start": 5834.429,
      "duration": 4.571
    },
    {
      "text": "Suspendue dans la brume",
      "start": 5839,
      "duration": 4.075
    },
    {
      "text": "Je marche sur le fil de tes pas",
      "start": 5843.075,
      "duration": 4.585
    },
    {
      "text": "Je titube, je bascule",
      "start": 5850,
      "duration": 3.5
    },
    {
      "text": "Et je plonge dans l'écume",
      "start": 5853.5,
      "duration": 3.5
    },
    {
      "text": "Des jours qui me parlent de toi",
      "start": 5857,
      "duration": 7.333
    },
    {
      "text": "Dors, mon ange",
      "start": 5864.333,
      "duration": 2.667
    },
    {
      "text": "Dans l'éternelle candeur",
      "start": 5867,
      "duration": 4.633
    },
    {
      "text": "Dors, mon ange",
      "start": 5871.633,
      "duration": 2.317
    },
    {
      "text": "Le ciel est ta demeure",
      "start": 5874,
      "duration": 4.307
    },
    {
      "text": "Vole, mon ange",
      "start": 5878.307,
      "duration": 2.393
    },
    {
      "text": "Le temps pansera",
      "start": 5881,
      "duration": 4.45
    },
    {
      "text": "Ma douleur",
      "start": 5885.45,
      "duration": 4.45
    },
    {
      "text": "Da Ponte, mon père est mort.",
      "start": 5895,
      "duration": 3.5
    },
    {
      "text": "Monsieur Mozart?",
      "start": 5908,
      "duration": 3.429
    },
    {
      "text": "Que me voulez-vous?",
      "start": 5911.429,
      "duration": 4.571
    },
    {
      "text": "Ne posez pas de questions.",
      "start": 5916,
      "duration": 2.5
    },
    {
      "text": "L'homme qui m'envoie vous tient pour le plus talentueux des compositeurs.",
      "start": 5918.5,
      "duration": 7.5
    },
    {
      "text": "Qu'attend-il de moi?",
      "start": 5926,
      "duration": 2.0
    },
    {
      "text": "Que vous composiez une messe des morts.",
      "start": 5928,
      "duration": 6.54
    },
    {
      "text": "Un requiem?",
      "start": 5936,
      "duration": 1.852
    },
    {
      "text": "Mais pour qui?",
      "start": 5937.852,
      "duration": 2.222
    },
    {
      "text": "Ça n'est pas votre affaire.",
      "start": 5940.074,
      "duration": 3.333
    },
    {
      "text": "Voici 100 ducats.",
      "start": 5943.407,
      "duration": 1.852
    },
    {
      "text": "Vous en aurez autant à l'achèvement de la partition.",
      "start": 5946,
      "duration": 4.935
    },
    {
      "text": "Travaillez avec tout le soin possible.",
      "start": 5950.935,
      "duration": 3.455
    },
    {
      "text": "L'homme est connaisseur. 100 ducats, Wolfgang!",
      "start": 5956,
      "duration": 8.0
    },
    {
      "text": "Nous sommes sauvés.",
      "start": 5964,
      "duration": 1.759
    },
    {
      "text": "Non, Constance.",
      "start": 5965.759,
      "duration": 1.006
    },
    {
      "text": "Non.",
      "start": 5966.765,
      "duration": 0.251
    },
    {
      "text": "Cet homme est venu de l'au-delà pour m'annoncer la fin.",
      "start": 5967.016,
      "duration": 4.524
    },
    {
      "text": "Vous savez,",
      "start": 5973,
      "duration": 1.014
    },
    {
      "text": "Madame Rosenberg me dit",
      "start": 5974.014,
      "duration": 2.028
    },
    {
      "text": "Oh, mon ami, en parlant de moi, vous êtes un être merveilleux.",
      "start": 5976.042,
      "duration": 5.577
    },
    {
      "text": "Vous savez, j'adore rire.",
      "start": 5981.619,
      "duration": 2.281
    },
    {
      "text": "Dieu prête longue vie à celui que",
      "start": 5984,
      "duration": 2.554
    },
    {
      "text": "Sa Majesté a nommé maître de la",
      "start": 5986.554,
      "duration": 1.916
    },
    {
      "text": "Chapelle Impériale, notre ami et compositeur,",
      "start": 5988.47,
      "duration": 2.873
    },
    {
      "text": "Antonio Salieri!",
      "start": 5991.343,
      "duration": 1.277
    },
    {
      "text": "Bravo, maestro!",
      "start": 5993,
      "duration": 1.0
    }
  ],
