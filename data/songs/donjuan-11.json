  "cues": [
    {
      "text": "C'est si facile de faire le bien, pourquoi le mal",
      "start": 1341,
      "duration": 6.61
    },
    {
      "text": "N'auras-tu donc aucun chemin, aucun idéal",
      "start": 1351,
      "duration": 6.51
    },
    {
      "text": "N'auras-tu jamais, un peu de morale",
      "start": 1359,
      "duration": 6.22
    },
    {
      "text": "Les fleurs du mal, les fleurs de lys",
      "start": 1366,
      "duration": 3.2
    },
    {
      "text": "Perdent leurs pétales, c'est pareil, c'est pareil",
      "start": 1369.2,
      "duration": 4.8
    },
    {
      "text": "Les jeux du bal, les jeux du vice",
      "start": 1374,
      "duration": 3.648
    },
    {
      "text": "Ça m'est égal s'ils ne m'emmènent pas au ciel",
      "start": 1377.648,
      "duration": 4.642
    },
    {
      "text": "Un jour peut-être tu comprendras, le goût de l'amour",
      "start": 1384,
      "duration": 6.17
    },
    {
      "text": "Tu seras si bien dans les bras, d'une fille pour toujours",
      "start": 1393,
      "duration": 7.08
    },
    {
      "text": "Un jour heureux, si Dieu le veut",
      "start": 1401,
      "duration": 6.72
    },
    {
      "text": "Les fleurs du mal, les fleurs de lys",
      "start": 1408,
      "duration": 3.2
    },
    {
      "text": "Perdent leurs pétales, c'est pareil, c'est pareil",
      "start": 1411.2,
      "duration": 4.8
    },
    {
      "text": "Les jeux du bal, les jeux du vice",
      "start": 1416,
      "duration": 3.797
    },
    {
      "text": "Ça m'est égal s'ils ne m'emmènent pas au ciel",
      "start": 1419.797,
      "duration": 4.833
    },
    {
      "text": "Moi, je vois le bien partout",
      "start": 1425,
      "duration": 4.98
    },
    {
      "text": "Moi, j'aime les gens debout",
      "start": 1433,
      "duration": 5.19
    },
    {
      "text": "Toi, tu comprends jamais rien,",
      "start": 1440,
      "duration": 5.0
    },
    {
      "text": "Le seul plaisir qui reste",
      "start": 1445.0,
      "duration": 5.0
    },
    {
      "text": "C'est les femmes et le vin",
      "start": 1450,
      "duration": 3.294
    },
    {
      "text": "Les fleurs du mal, les fleurs de lys",
      "start": 1453.294,
      "duration": 4.706
