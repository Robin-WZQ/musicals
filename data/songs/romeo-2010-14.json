    },
    {
      "text": "Je dois cet amour dans ses yeux",
      "start": 2832.846,
      "duration": 4.154
    },
    {
      "text": "Que leur volonté soit faite",
      "start": 2837,
      "duration": 4.696
    },
    {
      "text": "Car Roméo aime Juliette",
      "start": 2841.696,
      "duration": 4.304
    },
    {
      "text": "S'il faut prier je prierais",
      "start": 2846,
      "duration": 4.286
    },
    {
      "text": "S'il faut se battre, je me battrai",
      "start": 2850.286,
      "duration": 4.714
    },
    {
      "text": "Mais pourquoi faut-il payer",
      "start": 2855,
      "duration": 5.318
    },
    {
      "text": "Le droit de nous aimer",
      "start": 2860.318,
      "duration": 3.682
    },
    {
      "text": "Et que nos pères se déchirent",
      "start": 2864,
      "duration": 5.0
    },
    {
      "text": "Leurs enfants eux se désirent",
      "start": 2869.0,
      "duration": 5.0
    },
    {
      "text": "On ne peut pas changer l'histoire",
      "start": 2874,
      "duration": 4.714
    },
    {
      "text": "La nôtre commencera ce soir",
      "start": 2878.714,
      "duration": 4.286
    },
    {
      "text": "Et tant pis si ça dérange",
      "start": 2883,
      "duration": 4.8
    },
    {
      "text": "Qu'une pucelle aime un ange",
      "start": 2887.8,
      "duration": 7.2
    },
    {
      "text": "À quelle étoile, à quel Dieu",
      "start": 2895,
      "duration": 4.846
    },
    {
      "text": "Je dois cet amour dans ses yeux",
      "start": 2899.846,
