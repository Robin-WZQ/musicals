    },
    {
      "text": "Que Juliette aime Roméo",
      "start": 2929.76,
      "duration": 6.24
    },
    {
      "text": "Roméo...",
      "start": 2936,
      "duration": 0.579
    },
    {
      "text": "Je t'ai tellement rêvé",
      "start": 2936.579,
      "duration": 1.544
    },
    {
      "text": "Je te cherche depuis si longtemps",
      "start": 2938.123,
      "duration": 1.93
    },
    {
      "text": "Es-tu vraiment celui que j’attendais ?",
      "start": 2940.053,
      "duration": 2.701
    },
    {
      "text": "Mais je le suis !",
      "start": 2942.754,
      "duration": 1.158
    },
    {
      "text": "Je le jure sur la lune qui brille pour nous !",
      "start": 2943.912,
      "duration": 3.088
    },
    {
      "text": "Oh, ne jure pas Roméo !",
      "start": 2947,
      "duration": 1.455
    },
    {
      "text": "Ne jure pas.",
      "start": 2948.455,
      "duration": 0.727
    },
    {
      "text": "Mais je t’aime tellement !",
      "start": 2949.182,
      "duration": 1.636
    },
    {
      "text": "Avant toi, ma vie n’était rien !",
      "start": 2950.818,
      "duration": 2.182
    },
    {
      "text": "Rien ?",
      "start": 2953,
      "duration": 0.621
    },
    {
      "text": "On raconte pourtant…",
      "start": 2953.621,
      "duration": 2.172
    },
    {
      "text": "Non Juliette, non.",
      "start": 2955.793,
      "duration": 1.862
    },
    {
      "text": "Moi aussi, j’attendais.",
      "start": 2957.655,
      "duration": 2.793
    },
    {
      "text": "Je t’attendais.",
      "start": 2960.448,
      "duration": 1.552
    },
    {
      "text": "Prouve-le-moi",
      "start": 2962,
      "duration": 1.263
    },
    {
      "text": "Epouse-moi",
      "start": 2963.263,
      "duration": 1.263
    },
    {
      "text": "Le mariage...",
      "start": 2964.526,
      "duration": 1.053
    },
    {
      "text": "Et à combien de filles avant moi as-tu dis \"épouse-moi\" ?",
      "start": 2965.579,
      "duration": 4.421
    },
    {
      "text": "Mais à personne ma Juliette, jamais.",
      "start": 2970,
      "duration": 2.053
    },
    {
      "text": "Écoute Roméo...",
      "start": 2972.053,
      "duration": 1.027
    },
    {
      "text": "Laisse la nuit mourir.",
      "start": 2973.08,
      "duration": 1.32
    },
    {
      "text": "Demain, je t'enverrai ma nourrice.",
      "start": 2974.4,
      "duration": 1.907
    },
    {
      "text": "Tu lui donneras cette rose, et tu lui diras l’heure de notre mariage chez",
      "start": 2976.307,
      "duration": 3.96
    },
    {
      "text": "Frère Laurent.",
      "start": 2980.267,
      "duration": 0.733
    },
    {
      "text": "Si tu veux toujours m’épouser.",
      "start": 2981,
      "duration": 6.4
    },
    {
      "text": "Oh je t’aime Juliette !",
      "start": 2987.4,
      "duration": 4.8
    },
    {
      "text": "Demain, Roméo.",
      "start": 2992.2,
      "duration": 3.2
    },
    {
      "text": "Demain.",
