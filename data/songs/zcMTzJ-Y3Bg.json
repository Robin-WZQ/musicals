  "cues": [
    {
      "text": "Jean-Baptiste, mon enfant, ton silence m'inquiète",
      "start": 7.0,
      "duration": 3.034
    },
    {
      "text": "Cela fait longtemps que je n'ai eu la moindre lettre",
      "start": 10.034,
      "duration": 4.173
    },
    {
      "text": "On dit que d'Épernon, la Guyenne s'est défaite",
      "start": 14.207,
      "duration": 3.793
    },
    {
      "text": "Mazarin l'a contraint à la retraite",
      "start": 18.0,
      "duration": 4.846
    },
    {
      "text": "Père, je vous supplie de ne pas vous tourmenter",
      "start": 22.846,
      "duration": 5.44
    },
    {
      "text": "Il n'y a aucune raison de vous inquiéter",
      "start": 28.286,
      "duration": 3.857
    },
    {
      "text": "Depuis qu'Épernon nous a libérés",
      "start": 32.143,
      "duration": 4.493
    },
    {
      "text": "Nous courons de succès en succès",
      "start": 36.636,
      "duration": 7.221
    },
    {
      "text": "Tu ne m'as jamais... (J'ai pourtant essayé)",
      "start": 43.857,
      "duration": 3.429
    },
    {
      "text": "J'aurais tant aimé... (Tu n'm'as pas écouté...)",
      "start": 47.286,
      "duration": 3.618
    },
    {
      "text": "Mais tu avais tant et tant",
      "start": 50.904,
      "duration": 2.25
    },
    {
      "text": "De rêves trop grands pour trouver le temps",
      "start": 53.154,
      "duration": 6.346
    },
    {
      "text": "De demander pardon",
      "start": 59.5,
      "duration": 4.5
    },
    {
      "text": "Non, je ne crois pas à ce que tu m'écris",
      "start": 64.0,
      "duration": 4.074
    },
    {
      "text": "Tu cours à l'échec tel que je l'ai prédit",
      "start": 68.074,
      "duration": 3.704
    },
    {
      "text": "Tu n'as jamais été capable de t'assumer",
      "start": 71.778,
      "duration": 3.508
    },
    {
      "text": "Renonce à tes chimères et viens me retrouver",
      "start": 75.286,
      "duration": 3.428
    },
    {
      "text": "J'aimerais tellement briser ta défiance",
      "start": 78.714,
      "duration": 2.377
    },
    {
      "text": "Te prouver que je mérite ta confiance",
      "start": 81.091,
      "duration": 4.364
    },
    {
      "text": "Mais tu m'as jamais donné l'occasion",
      "start": 85.455,
      "duration": 4.909
    },
    {
      "text": "De te révéler ma passion",
