    {
      "text": "Le Prince en te chassant,",
      "start": 5503,
      "duration": 3.267
    },
    {
      "text": "T'a sauvé, le sais-tu,",
      "start": 5506.267,
      "duration": 3.733
    },
    {
      "text": "On réclamait ton sang,",
      "start": 5510,
      "duration": 3.5
    },
    {
      "text": "Le sang d'un Montaigu,",
      "start": 5513.5,
      "duration": 3.5
    },
    {
      "text": "Et toi pauvre petit perdu,",
      "start": 5517,
      "duration": 4.118
    },
    {
      "text": "Toi tu ne comprends plus",
      "start": 5521.118,
      "duration": 2.882
    },
    {
      "text": "Oh Dieu, que les hommes, sont durs",
      "start": 5524,
      "duration": 6.05
    },
    {
      "text": "Que les hommes, sont sûrs d'eux",
      "start": 5530.05,
      "duration": 4.95
    },
    {
      "text": "Oh !",
      "start": 5535,
      "duration": 0.469
    },
    {
      "text": "Dieu, que les hommes, sont durs",
      "start": 5535.469,
      "duration": 4.687
    },
    {
      "text": "Que faut-il donc qu'on fasse",
      "start": 5540.156,
      "duration": 4.688
    },
    {
      "text": "Pour que tu accordes ta grâce ?",
      "start": 5544.844,
      "duration": 5.156
    },
    {
      "text": "Dieu toi qui nous a mis sur la terre",
      "start": 5550,
      "duration": 4.5
    },
    {
      "text": "Pourquoi nous forcer à nous taire",
      "start": 5554.5,
      "duration": 4.5
    },
    {
      "text": "Et regarder, mourir les hommes",
      "start": 5559,
      "duration": 6.0
    },
    {
      "text": "Les choses ne sont jamais,",
      "start": 5565,
      "duration": 2.909
    },
    {
      "text": "Ce que l'on voudrait qu'elles soient",
      "start": 5567.909,
      "duration": 5.091
    },
    {
      "text": "Juliette maintenant tu sais,",
      "start": 5573,
      "duration": 3.3
    },
    {
      "text": "Ce que je savais déjà",
      "start": 5576.3,
      "duration": 2.7
    },
    {
      "text": "Et tu pleures, tu pleures, ma fille, ma sœur,",
      "start": 5579,
      "duration": 5.217
    },
    {
