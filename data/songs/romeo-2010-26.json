      "start": 5474.0,
      "duration": 0.667
    },
    {
      "text": "Je suis banni.",
      "start": 5474.667,
      "duration": 1.666
    },
    {
      "text": "Je perds Juliette.",
      "start": 5476.333,
      "duration": 2.0
    },
    {
      "text": "Et moi je perds un fils.",
      "start": 5478.333,
      "duration": 2.334
    },
    {
      "text": "Je l’aime !",
      "start": 5480.667,
      "duration": 1.333
    },
    {
      "text": "Je t’aime autant qu’elle.",
      "start": 5482,
      "duration": 2.222
    },
    {
      "text": "Nous souffrons tous les deux.",
      "start": 5484.222,
      "duration": 2.222
    },
    {
      "text": "Comment vais-je faire pour vivre sans elle ?",
      "start": 5486.444,
      "duration": 3.334
    },
    {
      "text": "Vivre sans toi me sera fatal.",
      "start": 5489.778,
      "duration": 2.222
