  "cues": [
    {
      "text": "Toi, mon mari, ou étais tu quand Juliette grandissait ?",
      "start": 5225,
      "duration": 6.0
    },
    {
      "text": "Où étais-tu quand je vieillissais ?",
      "start": 5231,
      "duration": 3.649
    },
    {
      "text": "Où étais-tu quand il est mort ?",
      "start": 5234.649,
      "duration": 2.675
    },
    {
      "text": "Es-tu un homme ou une ombre ?",
      "start": 5237.324,
      "duration": 2.676
    },
    {
      "text": "Réclameras-tu vengeance pour lui ou dois-je le faire à ta place ?",
      "start": 5240,
      "duration": 4.062
    },
    {
      "text": "Réponds !",
      "start": 5244.062,
      "duration": 0.313
    },
    {
      "text": "Tais-toi !",
      "start": 5244.375,
      "duration": 0.625
    },
    {
      "text": "Quel est le prix",
      "start": 5245,
      "duration": 2.222
    },
    {
      "text": "Qu'on va nous payer pour sa vie",
      "start": 5247.222,
      "duration": 5.778
    },
    {
      "text": "Quel est le sort",
      "start": 5253,
      "duration": 2.778
    },
    {
      "text": "Qu'on donne à ceux qui donnent la mort",
      "start": 5255.778,
      "duration": 7.222
    },
    {
      "text": "Mon fils a tué",
      "start": 5263,
      "duration": 1.765
    },
    {
      "text": "Mais vous tous ici vous savez",
      "start": 5264.765,
      "duration": 4.235
    },
    {
      "text": "Que Tybalt avant",
      "start": 5269,
      "duration": 2.667
    },
    {
      "text": "Avait déjà fait couler le sang",
      "start": 5271.667,
      "duration": 5.333
    },
    {
      "text": "L'affaire est faite",
      "start": 5277,
      "duration": 2.783
    },
    {
      "text": "Mais maintenant pour que tout s'arrête",
      "start": 5279.783,
      "duration": 5.217
    },
    {
      "text": "Je dois vous croire",
      "start": 5285,
      "duration": 6.857
    },
    {
      "text": "Je dois savoir",
      "start": 5291.857,
      "duration": 5.143
    },
    {
      "text": "Je n'ai pas, je vous le jure",
      "start": 5297,
      "duration": 4.737
    },
    {
      "text": "Voulu ce qui s'est passé",
      "start": 5301.737,
      "duration": 4.263
    },
    {
      "text": "La vengeance n'est pas ma nature",
      "start": 5306,
      "duration": 3.208
    },
    {
      "text": "Mais pourtant oui, je l'ai vengé",
      "start": 5309.208,
      "duration": 3.792
    },
    {
      "text": "Faut-il donc, ne rien faire",
      "start": 5313,
      "duration": 5.714
    },
    {
      "text": "Quand on voit mourir, un frère",
      "start": 5318.714,
      "duration": 6.286
    },
    {
      "text": "Vous, qui vous détestez tant",
      "start": 5325,
      "duration": 3.81
    },
    {
      "text": "Comment pouvez-vous, nous juger",
      "start": 5328.81,
      "duration": 4.19
    },
    {
      "text": "Nous sommes tous les trois, vos enfants",
      "start": 5333,
      "duration": 3.84
    },
    {
      "text": "C'est vous les seuls, qui les avez tués",
      "start": 5336.84,
      "duration": 4.16
    },
    {
      "text": "Nous ne sommes, que des mimes",
