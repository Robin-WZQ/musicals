      "start": 7078.0,
      "duration": 6.0
    },
    {
      "text": "On voudrait partir mais on reste",
      "start": 7084,
      "duration": 5.0
    },
    {
      "text": "Ici c'est pas l'amour qui est roi",
      "start": 7089,
      "duration": 4.696
    },
    {
      "text": "Ici deux familles font la loi",
      "start": 7093.696,
      "duration": 4.304
    },
    {
      "text": "Pas besoin de choisir ton camp",
