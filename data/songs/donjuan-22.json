    {
      "text": "Quand j'ai envie de briser mes chaînes",
      "start": 3386,
      "duration": 5.122
    },
    {
      "text": "Et déchirer mes habits de soldat",
      "start": 3391.122,
      "duration": 3.658
    },
    {
      "text": "Sous les vents froids d'une morne plaine",
      "start": 3396,
      "duration": 5.013
    },
    {
      "text": "Combien de nous sont morts déjà",
      "start": 3401.013,
      "duration": 3.857
    },
    {
      "text": "Quand tous nos chants ne sont que prières",
      "start": 3406,
      "duration": 4.816
    },
    {
      "text": "Et que nos jeux sont des combats",
      "start": 3410.816,
      "duration": 3.704
    },
    {
      "text": "Quand de nos vies on sème la terre",
