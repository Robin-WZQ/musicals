  "cues": [
    {
      "text": "Mes erreurs, mes douleurs, mes pudeurs",
      "start": 1989,
      "duration": 2.15
    },
    {
      "text": "Mes regrets, mais pour quoi faire?",
      "start": 1991.15,
      "duration": 2.15
    },
    {
      "text": "Tu t'en moques, tu révoques tout en bloc",
      "start": 1994,
      "duration": 2.989
    },
    {
      "text": "Tu balayes tout d'un revers",
      "start": 1996.989,
      "duration": 2.135
    },
    {
      "text": "Ma mémoire, mon histoire, sans égard",
      "start": 1999.124,
      "duration": 2.776
    },
    {
      "text": "Mon passé que tu enterres",
      "start": 2002,
      "duration": 2.551
    },
    {
      "text": "Demain tu diras pourquoi n'ai-je",
      "start": 2004.551,
      "duration": 3.968
    },
    {
      "text": "Pas vu les pièges",
      "start": 2008.519,
      "duration": 1.701
    },
    {
      "text": "Emporté dans l'odieux manège",
      "start": 2011,
      "duration": 3.052
    },
    {
      "text": "Des rancoeurs, des frayeurs, des malheurs",
      "start": 2014.052,
      "duration": 3.884
    },
    {
      "text": "Au cœur de l'amour amer",
      "start": 2017.936,
      "duration": 2.774
    },
    {
      "text": "Des nuits noires, des déboires à la gloire",
      "start": 2021,
      "duration": 4.269
    },
    {
      "text": "Des plaisirs éphémères",
      "start": 2025.269,
      "duration": 2.134
    },
    {
      "text": "J'ai beau prêcher dans le désert",
      "start": 2027.403,
      "duration": 2.935
    },
    {
      "text": "Comment me taire?",
      "start": 2030.338,
      "duration": 1.601
    },
    {
      "text": "Tourne la terre comme les hommes",
      "start": 2033,
      "duration": 2.391
    },
    {
      "text": "À refaire encore les erreurs",
      "start": 2035.391,
      "duration": 2.609
    },
    {
      "text": "De nos pères",
      "start": 2038.0,
      "duration": 0.87
    },
    {
      "text": "On mord toujours la même pomme",
      "start": 2043,
      "duration": 3.197
    },
    {
      "text": "Et le serpent danse alors que l'on s'enferre",
      "start": 2046.197,
      "duration": 4.068
    },
    {
      "text": "Dans les erreurs d'hier",
      "start": 2050.265,
      "duration": 2.034
    },
    {
      "text": "Pour grandir, t'accomplir et sortir de la ronde séculaire",
      "start": 2061,
      "duration": 4.75
    },
    {
      "text": "Dans mon ombre, les décombres des jours sombres",
      "start": 2065.75,
      "duration": 3.25
    },
    {
      "text": "Tu trouveras la lumière",
      "start": 2069,
      "duration": 3.333
    },
    {
      "text": "Ce sont mes travers qui t'éclairent",
      "start": 2072.333,
      "duration": 3.667
    },
    {
      "text": "Comment me taire?",
      "start": 2076.0,
      "duration": 2.0
    },
    {
      "text": "Tourne la terre autour des hommes",
      "start": 2078,
      "duration": 2.688
    },
    {
      "text": "Nous sommes la somme des erreurs de nos pères",
      "start": 2080.688,
      "duration": 3.102
    },
    {
      "text": "On mord toujours la même pomme",
      "start": 2088,
      "duration": 3.071
    },
    {
      "text": "Et le serpent danse alors que l'on s'enferre",
      "start": 2091.071,
      "duration": 3.909
    },
    {
      "text": "Tourne la terre autour des hommes",
      "start": 2097,
      "duration": 2.937
    },
    {
      "text": "Il faut défaire ce que nous sommes",
      "start": 2099.937,
      "duration": 3.163
    },
    {
      "text": "En embrassant nos pères",
      "start": 2105,
      "duration": 2.491
    },
    {
      "text": "Wolfgang, reprends-toi.",
      "start": 2107.491,
      "duration": 2.135
    },
    {
      "text": "Abandonne cette Aloysia.",
      "start": 2109.626,
      "duration": 3.914
    },
    {
      "text": "Pars pour Paris, et vite.",
      "start": 2114,
      "duration": 1.764
    },
    {
      "text": "C'est à Paris que tu trouveras l'honneur et le succès.",
      "start": 2115.764,
      "duration": 3.97
    },
    {
      "text": "Fais reconnaître ton talent.",
      "start": 2119.734,
      "duration": 2.206
    },
    {
      "text": "Alors seulement, tu pourras revenir vers",
      "start": 2122,
      "duration": 2.79
    },
    {
      "text": "Mademoiselle Weber.",
      "start": 2124.79,
      "duration": 1.595
    },
    {
      "text": "Wolfgang, obéis-moi!",
      "start": 2126.385,
      "duration": 1.395
    },
    {
      "text": "Aloysia.",
      "start": 2132,
      "duration": 2.045
    },
    {
      "text": "Aloysia, je dois vous quitter.",
      "start": 2134.045,
      "duration": 5.319
    },
    {
      "text": "Me quitter?",
      "start": 2139.364,
      "duration": 1.636
    },
    {
      "text": "Oui, dès demain.",
      "start": 2141,
      "duration": 1.75
    },
    {
      "text": "Mais...",
      "start": 2142.75,
      "duration": 0.5
    },
    {
      "text": "Et nos concerts?",
      "start": 2143.25,
      "duration": 1.0
    },
    {
      "text": "Je ne sais pas.",
      "start": 2144.25,
      "duration": 1.25
    },
    {
      "text": "Vous chanterez sans moi.",
      "start": 2145.5,
      "duration": 2.0
    },
    {
      "text": "Wolfgang, qu'y a-t-il?",
      "start": 2147.5,
      "duration": 1.5
    },
    {
      "text": "Je dois quitter Mannheim pour Paris.",
      "start": 2149,
      "duration": 2.737
    },
    {
      "text": "Comme ça?",
      "start": 2151.737,
      "duration": 0.631
    },
    {
      "text": "Tout de suite?",
      "start": 2152.368,
      "duration": 1.264
    },
    {
      "text": "Réfléchissez.",
      "start": 2153.632,
      "duration": 0.842
    },
    {
      "text": "Et Aloysia et tous nos projets?",
      "start": 2154.474,
      "duration": 2.526
    },
    {
      "text": "Madame, expliquez-nous!",
      "start": 2157,
      "duration": 2.335
    },
    {
      "text": "Non, c'est tout.",
      "start": 2159.335,
      "duration": 1.038
    },
    {
      "text": "Je pars.",
      "start": 2160.373,
      "duration": 0.519
    },
    {
      "text": "Aloysia, je ne serai pas long.",
      "start": 2160.892,
      "duration": 3.114
    },
    {
      "text": "Tout au plus, quelques mois.",
      "start": 2164.006,
      "duration": 2.854
    },
    {
      "text": "Quelques mois?",
      "start": 2167,
      "duration": 1.312
    },
    {
      "text": "Mais enfin, c'est une éternité,",
      "start": 2168.312,
      "duration": 2.407
    },
    {
      "text": "une vie entière.",
      "start": 2170.719,
      "duration": 1.75
    },
    {
      "text": "Non.",
      "start": 2172.469,
      "duration": 0.219
    },
    {
      "text": "Non, ne partez pas.",
      "start": 2172.688,
      "duration": 1.093
    },
    {
      "text": "Ah!",
      "start": 2173.781,
      "duration": 0.219
    },
    {
      "text": "Cette fois-ci, c'est raté.",
      "start": 2174,
      "duration": 2.724
    },
    {
      "text": "Crétin, va!",
      "start": 2176.724,
      "duration": 1.021
    },
    {
      "text": "Aloysia, Aloysia, non.",
      "start": 2177.745,
      "duration": 3.745
    },
    {
      "text": "Mon père a raison.",
      "start": 2183,
      "duration": 1.105
    },
    {
      "text": "Aujourd'hui, je ne suis rien.",
      "start": 2184.105,
      "duration": 1.895
    },
    {
      "text": "À Paris, je ferai fortune pour être digne de vous.",
      "start": 2186.0,
      "duration": 3.0
    },
    {
      "text": "Je vous en supplie.",
      "start": 2189,
      "duration": 2.285
    },
    {
      "text": "Aloysia, je vous aime.",
      "start": 2191.285,
      "duration": 3.591
    },
    {
      "text": "Ne m'oubliez pas.",
      "start": 2194.876,
      "duration": 1.958
    },
    {
      "text": "Adieu.",
      "start": 2196.834,
      "duration": 1.306
    },
    {
      "text": "Adieu.",
      "start": 2199,
      "duration": 1.373
    },
    {
      "text": "Je vous déteste.",
      "start": 2200.373,
      "duration": 2.059
    },
    {
      "text": "Je vous déteste.",
      "start": 2202.432,
      "duration": 2.059
    },
    {
      "text": "Je vous déteste!",
      "start": 2204.491,
      "duration": 2.059
    }
