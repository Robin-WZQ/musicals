      "duration": 2.526
    },
    {
      "text": "Pour toi j'ai renoncé",
      "start": 8055,
      "duration": 2.571
    },
    {
      "text": "À la chair tendre des femmes",
      "start": 8057.571,
      "duration": 2.572
    },
    {
      "text": "J'ai cru en ta bonté",
      "start": 8060.143,
      "duration": 2.0
    },
    {
      "text": "Mais j'ai perdu la mienne",
      "start": 8062.143,
      "duration": 2.857
    },
    {
      "text": "Je ne peux plus aimer",
