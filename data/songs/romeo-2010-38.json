    },
    {
      "text": "Si je crois en l'homme ou si je crois plus",
      "start": 8031.6,
      "duration": 8.4
    },
    {
      "text": "Si Dieu est encore dans ma rue",
      "start": 8040,
      "duration": 5.143
    },
    {
      "text": "Oh, j'sais plus je suis perdu",
      "start": 8045.143,
      "duration": 3.857
    },
    {
      "text": "Pour toi j'ai tout laissé",
      "start": 8049,
      "duration": 3.474
    },
    {
      "text": "Je t'ai donné mon âme",
