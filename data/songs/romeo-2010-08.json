    {
      "text": "Les rois du monde vivent au sommet",
      "start": 1409,
      "duration": 4.0
    },
    {
      "text": "Ils ont la plus belle vue mais y'a un mais",
      "start": 1413.0,
      "duration": 5.0
    },
    {
      "text": "Ils ne savent pas ce qu'on pense d'eux en bas",
      "start": 1418,
