    },
    {
      "text": "Les enfants que l'on outrage",
      "start": 4875,
      "duration": 4.55
    },
    {
      "text": "Peuvent-ils encore aimer?",
      "start": 4879.55,
      "duration": 3.9
    },
    {
      "text": "J'étais comme une hirondelle",
      "start": 4884,
      "duration": 4.2
    },
    {
      "text": "J'arrivais avec le printemps",
      "start": 4888.2,
      "duration": 4.8
    },
    {
      "text": "Je courrais par les ruelles",
      "start": 4893,
      "duration": 4.55
    },
    {
      "text": "En chantant des chants gitans",
      "start": 4897.55,
      "duration": 4.55
    },
    {
      "text": "Où es-tu sonneur de cloches",
      "start": 4902.1,
      "duration": 4.55
    },
    {
      "text": "Où es-tu mon Quasimodo?",
      "start": 4907,
      "duration": 4.8
    },
    {
      "text": "Viens me sauver de la corde",
      "start": 4911.8,
      "duration": 4.2
    },
    {
      "text": "Viens écarter mes barreaux",
      "start": 4916,
      "duration": 4.55
    },
    {
      "text": "Où es-tu mon Esmeralda",
      "start": 4920.55,
      "duration": 4.55
    },
    {
      "text": "Où te caches-tu de moi?",
      "start": 4928,
      "duration": 3.857
    },
    {
      "text": "Voilà au moins trois jours déjà",
      "start": 4931.857,
      "duration": 5.143
    },
    {
      "text": "Qu'on ne te voit plus par là",
      "start": 4937,
      "duration": 4.5
    },
    {
      "text": "Es-tu partie en voyage",
      "start": 4941.5,
      "duration": 4.5
    },
    {
      "text": "Avec ton beau capitaine",
      "start": 4946,
      "duration": 4.55
    },
    {
      "text": "Sans fiançailles, sans mariage",
      "start": 4950.55,
      "duration": 3.9
    },
    {
      "text": "Comme à la mode païenne?",
      "start": 4955,
      "duration": 3.9
    },
    {
      "text": "Serais-tu morte peut-être",
      "start": 4958.9,
      "duration": 3.9
    },
    {
      "text": "Sans prière et sans couronne?",
      "start": 4964,
      "duration": 4.55
    },
    {
      "text": "Ne laisse jamais un prêtre",
      "start": 4968.55,
      "duration": 3.9
    },
    {
      "text": "S'approcher de ta personne",
      "start": 4973,
      "duration": 4.55
    },
    {
      "text": "Souviens-toi d'un jour de foire",
      "start": 4977.55,
      "duration": 4.55
    },
    {
      "text": "Où l'on m'avait mis à la roue",
      "start": 4983,
      "duration": 4.267
    },
    {
      "text": "Quand je t'ai donné à boire",
      "start": 4987.267,
      "duration": 3.733
    },
    {
      "text": "Je suis tombé à genoux",
      "start": 4991,
      "duration": 4.55
    },
    {
      "text": "On est devenus ce jour-là",
      "start": 4995.55,
      "duration": 4.55
    },
    {
      "text": "Amis à la vie à la mort",
      "start": 5001,
      "duration": 4.8
    },
    {
