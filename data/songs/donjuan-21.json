    },
    {
      "text": "Je me croyais de ceux",
      "start": 3136.882,
      "duration": 2.118
    },
    {
      "text": "Qui ne pleurent jamais",
      "start": 3139.0,
      "duration": 2.118
    },
    {
      "text": "Je m'écoutais d'abord",
      "start": 3141.118,
      "duration": 1.882
    },
    {
      "text": "Ce que disaient les autres",
      "start": 3143,
      "duration": 2.527
    },
    {
      "text": "N'avait pas d'intérêt",
      "start": 3145.527,
      "duration": 1.608
    },
    {
      "text": "Si je n'ai pas compris",
      "start": 3147.135,
      "duration": 1.608
    },
    {
      "text": "À son premier sourire",
      "start": 3148.743,
      "duration": 2.067
    },
    {
      "text": "C'est que j'ai pas appris",
      "start": 3151,
      "duration": 2.0
    },
    {
      "text": "Toute la différence",
      "start": 3153.0,
      "duration": 2.0
    },
    {
      "text": "Entre amour et plaisir",
      "start": 3155.0,
      "duration": 2.25
    },
    {
      "text": "Et désir et envie",
      "start": 3157.25,
      "duration": 1.75
    },
    {
      "text": "Je me croyais trop grand",
      "start": 3159,
