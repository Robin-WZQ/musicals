    {
      "text": "Je me croyais de ceux",
      "start": 3160.647,
      "duration": 1.853
    },
    {
      "text": "À qui tout réussit",
      "start": 3162.5,
      "duration": 1.647
    },
    {
      "text": "Dans les yeux d'une enfant",
      "start": 3164.147,
      "duration": 1.853
    },
    {
      "text": "Je me suis enfin vu",
      "start": 3166,
      "duration": 1.697
    },
    {
      "text": "Aussi laid que petit",
      "start": 3167.697,
      "duration": 2.182
    },
    {
      "text": "Dans les yeux d'une femme",
      "start": 3169.879,
      "duration": 2.182
    },
    {
      "text": "J'ai senti le tonnerre",
      "start": 3172.061,
      "duration": 1.939
    },
    {
      "text": "D'un million de tambours",
      "start": 3174,
      "duration": 2.007
    },
    {
      "text": "Qui frappaient dans mon âme",
      "start": 3176.007,
      "duration": 2.508
    },
    {
      "text": "Et mon cœur s'est ouvert",
      "start": 3178.515,
      "duration": 2.007
    },
    {
