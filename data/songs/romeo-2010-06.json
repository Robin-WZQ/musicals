      "duration": 2.189
    },
    {
      "text": "Ce regard qui vous juge",
      "start": 1116.189,
      "duration": 2.189
    },
    {
      "text": "Ces yeux qui vous fusillent",
      "start": 1118.378,
      "duration": 2.676
    },
    {
      "text": "Ce printemps qui s'insurge",
