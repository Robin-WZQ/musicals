  "cues": [
    {
      "text": "Ce n'était pas encore elle,",
      "start": 2661,
      "duration": 3.462
    },
    {
      "text": "La femme de ta vie",
      "start": 2664.462,
      "duration": 2.423
    },
    {
      "text": "Ni les putes ni les pucelles",
      "start": 2666.885,
      "duration": 3.115
    },
    {
      "text": "Ne t'auront appris",
      "start": 2670,
      "duration": 2.446
    },
    {
      "text": "Ni les larmes dans leurs yeux",
      "start": 2672.446,
      "duration": 4.078
    },
    {
      "text": "Ne t'auront ému",
      "start": 2676.524,
      "duration": 2.446
    },
    {
      "text": "Tant pis pour toutes celles ou ceux",
      "start": 2680,
      "duration": 3.456
    },
    {
      "text": "Qui t'auront cru",
      "start": 2683.456,
      "duration": 1.595
    },
    {
      "text": "Ce n'était pas encore elle",
      "start": 2685.051,
      "duration": 2.659
    },
    {
      "text": "Qu'est-ce que ça peut faire",
      "start": 2689,
      "duration": 2.87
    },
    {
      "text": "Et puis de quoi tu te mêles",
      "start": 2691.87,
      "duration": 2.87
    },
    {
      "text": "Elle a de quoi me plaire",
      "start": 2694.74,
      "duration": 2.87
    },
    {
      "text": "Pour un moment de plaisir",
      "start": 2699,
      "duration": 3.0
    },
    {
      "text": "Un instant seulement",
      "start": 2702.0,
      "duration": 2.333
    },
    {
      "text": "Je ne veux pas d'avenir",
      "start": 2704.333,
      "duration": 2.667
    },
    {
      "text": "Je reste un amant",
      "start": 2707,
      "duration": 3.797
    },
    {
      "text": "L'amour quand il vient,",
      "start": 2710.797,
      "duration": 5.063
    },
    {
      "text": "On ne l'attend pas",
      "start": 2716,
      "duration": 1.667
    },
    {
      "text": "Mais il est là",
      "start": 2717.667,
      "duration": 1.666
    },
    {
      "text": "C'est une histoire",
      "start": 2719.333,
      "duration": 2.334
    },
    {
      "text": "Entre elle et toi",
      "start": 2721.667,
      "duration": 2.333
    },
    {
      "text": "L'amour quand il vient,",
      "start": 2724,
      "duration": 3.368
    },
    {
      "text": "Il te délivre,",
      "start": 2727.368,
      "duration": 2.106
    },
    {
      "text": "Il fait de toi",
      "start": 2729.474,
      "duration": 2.526
    },
    {
      "text": "Comme un autre homme",
      "start": 2732,
      "duration": 2.851
    },
    {
      "text": "Que tu n'es pas",
      "start": 2734.851,
      "duration": 1.782
    },
    {
      "text": "Tu verras qu'un jour ou l'autre,",
      "start": 2736.633,
      "duration": 4.277
    },
    {
      "text": "Tu les paieras cher,",
      "start": 2742,
      "duration": 2.622
    },
    {
      "text": "Les plus terribles de tes fautes,",
      "start": 2744.622,
      "duration": 3.746
    },
    {
      "text": "De sang ou de chair",
      "start": 2748.368,
      "duration": 2.622
    },
    {
      "text": "Quand l'amour arrivera,",
      "start": 2752,
      "duration": 2.709
    },
    {
      "text": "Au lieu d'être beau",
      "start": 2754.709,
      "duration": 3.011
    },
    {
      "text": "Il ne sera fait pour toi,",
      "start": 2757.72,
      "duration": 3.01
    },
    {
      "text": "Que de peine et sanglots",
      "start": 2761,
      "duration": 2.807
    },
    {
      "text": "L'amour qu'est-ce que ça veut dire,",
      "start": 2763.807,
      "duration": 4.054
    },
    {
      "text": "Il n'existe pas",
      "start": 2767.861,
      "duration": 1.559
    },
