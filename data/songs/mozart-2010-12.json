    },
    {
      "text": "Oui, maman?",
      "start": 3657.761,
      "duration": 1.267
    },
    {
      "text": "Les chemise de",
      "start": 3659.028,
      "duration": 1.268
    },
    {
      "text": "Monsieur Arthur sont prêtes?",
      "start": 3660.296,
      "duration": 2.282
    },
    {
      "text": "J'arrive!",
      "start": 3662.578,
      "duration": 0.761
    },
    {
      "text": "Ben, dépêche-toi!",
      "start": 3663.339,
      "duration": 1.521
    },
    {
      "text": "Il attend pour partir.",
      "start": 3665,
      "duration": 2.074
    },
    {
      "text": "Ça nous fait... 2, 4, 6, 8.",
      "start": 3667.074,
      "duration": 1.482
    },
    {
      "text": "Voilà, le compte est bon.",
      "start": 3668.556,
      "duration": 2.37
    },
    {
      "text": "Alors, ces chemises, là?",
      "start": 3670.926,
      "duration": 2.074
    },
    {
      "text": "Tenez.",
      "start": 3673,
      "duration": 0.485
    },
    {
      "text": "Les voilà.",
      "start": 3673.485,
      "duration": 0.97
    },
    {
      "text": "Bon",
      "start": 3674.455,
      "duration": 0.242
    },
    {
      "text": "Allez, vous, disparaissez!",
      "start": 3674.697,
      "duration": 2.182
    },
    {
      "text": "Que fais-tu?",
      "start": 3676.879,
      "duration": 1.212
    },
    {
      "text": "Il y a du travail.",
      "start": 3678.091,
      "duration": 1.697
    },
    {
      "text": "J'en ai assez!",
      "start": 3679.788,
      "duration": 1.212
    },
    {
      "text": "Assez de trimer comme une boniche.",
      "start": 3681,
      "duration": 2.287
    },
    {
      "text": "Engage une gouvernante!",
      "start": 3683.287,
      "duration": 1.906
    },
    {
      "text": "Et l'argent pour la payer, il est où?",
      "start": 3685.193,
      "duration": 2.477
    },
    {
      "text": "Petite dinde!",
      "start": 3688,
      "duration": 0.957
    },
    {
      "text": "Depuis que ton père est mort, qu'Aloysia est mariée, je me tue à la tâche, et tu as des fatigues, des états d'âme!",
      "start": 3688.957,
      "duration": 8.043
    },
    {
      "text": "Je me demande quand tu auras du plomb dans la cervelle.",
      "start": 3697,
      "duration": 3.0
    }
