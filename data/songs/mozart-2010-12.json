      "duration": 7.678
    },
    {
      "text": "Bravo!",
      "start": 3478.678,
      "duration": 1.181
    },
    {
      "text": "Bravo, Mozart.",
      "start": 3483,
      "duration": 1.14
    },
    {
      "text": "Enfin, Stefani, un opéra en allemand, c'est une ineptie!",
      "start": 3495,
      "duration": 4.0
    },
    {
      "text": "Monsieur Rosenberg, je ne partage pas votre avis.",
      "start": 3499.0,
      "duration": 3.4
    },
    {
      "text": "Une hérésie, vous dis-je!",
      "start": 3502.4,
