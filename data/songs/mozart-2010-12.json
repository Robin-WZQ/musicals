    {
      "text": "Psst!",
      "start": 3504.4,
      "duration": 0.2
    },
    {
      "text": "Enfin!",
      "start": 3504.6,
      "duration": 0.4
    },
    {
      "text": "Des chanteurs de faubourgs, sur la scène du",
      "start": 3505,
      "duration": 3.008
    },
    {
      "text": "Théâtre impérial?",
      "start": 3508.008,
      "duration": 1.504
    },
    {
      "text": "Salieri, est-ce que vous imaginez, par exemple...",
      "start": 3509.512,
      "duration": 3.868
    },
    {
      "text": "Ça ne veut rien dire.",
      "start": 3521,
      "duration": 2.0
    },
    {
      "text": "Hum...",
      "start": 3523.0,
      "duration": 0.25
    },
    {
      "text": "Oui?",
      "start": 3523.25,
      "duration": 0.75
    },
    {
      "text": "Sa Majesté Joseph II, empereur d'Autriche, soleil du...",
      "start": 3524,
      "duration": 5.161
    },
    {
      "text": "C'est bon",
      "start": 3529.161,
      "duration": 0.516
    },
    {
      "text": "Messieurs, suivez-moi.",
      "start": 3529.677,
      "duration": 2.323
    },
    {
      "text": "Votre Majesté.",
      "start": 3532,
      "duration": 1.968
    },
    {
      "text": "Psst!",
      "start": 3533.968,
      "duration": 0.393
    },
    {
      "text": "Mademoiselle.",
      "start": 3534.361,
      "duration": 2.362
    },
    {
      "text": "Bien.",
      "start": 3536.723,
      "duration": 0.787
    },
    {
      "text": "Je vous écoute.",
      "start": 3538,
      "duration": 1.312
    },
    {
      "text": "Majesté, laissez-moi vous présenter",
      "start": 3539.312,
      "duration": 2.436
    },
    {
      "text": "Monsieur Stefani, qui vient vous remettre le livret de l'opéra commandé.",
      "start": 3541.748,
      "duration": 4.872
    },
    {
      "text": "En place.",
      "start": 3547,
      "duration": 0.707
    },
    {
      "text": "Ah, oui, pardon.",
      "start": 3547.707,
      "duration": 1.414
    },
    {
      "text": "Majesté...",
      "start": 3549.121,
      "duration": 0.707
    },
    {
      "text": "Psst!",
      "start": 3549.828,
      "duration": 0.235
    },
    {
      "text": "On se retire.",
      "start": 3550.063,
      "duration": 1.179
    },
    {
      "text": "Allez.",
      "start": 3551.242,
      "duration": 0.471
    },
    {
      "text": "Plus vite!",
      "start": 3551.713,
      "duration": 0.707
    },
    {
      "text": "L'Enlèvement au sérail.",
      "start": 3555,
      "duration": 2.559
    },
    {
      "text": "Oui, Majesté.",
      "start": 3557.559,
      "duration": 1.706
    },
    {
      "text": "Quel curieux titre!",
      "start": 3559.265,
      "duration": 2.275
    },
    {
      "text": "Il s'agit là d'un divertissement, d'une turquerie avec rebondissements.",
      "start": 3562,
      "duration": 5.458
    },
    {
      "text": "Fort bien!",
      "start": 3567.458,
      "duration": 0.682
    },
    {
      "text": "Et à qui comptez-vous confier la musique?",
      "start": 3570,
      "duration": 3.52
    },
    {
      "text": "J'ai fait appel à Wolfgang Mozart.",
      "start": 3573.52,
      "duration": 2.42
    },
    {
      "text": "Un jeune compositeur prometteur.",
      "start": 3575.94,
      "duration": 2.86
    },
    {
      "text": "Tout Vienne parle de lui.",
      "start": 3578.8,
      "duration": 2.2
    },
    {
      "text": "Un jeune écervelé,",
      "start": 3581,
      "duration": 1.6
    },
    {
      "text": "Votre Majesté, qui clame partout ne vouloir composer que pour l'allemand.",
      "start": 3582.6,
      "duration": 5.4
    },
    {
      "text": "Justement, je pensais que ce choix",
      "start": 3588,
      "duration": 2.887
    },
    {
      "text": "vous conviendrait...",
      "start": 3590.887,
      "duration": 1.684
    },
    {
      "text": "Dites, Salieri, qu'en pensez-vous?",
      "start": 3592.571,
      "duration": 2.887
    },
    {
      "text": "Alors ça!",
      "start": 3595.458,
      "duration": 0.722
    },
    {
      "text": "Écervelé... mais infiniment doué.",
      "start": 3598,
      "duration": 6.0
    },
    {
      "text": "Enfin, Salieri!",
      "start": 3604,
      "duration": 1.547
    },
    {
      "text": "Cependant, on ne peut nier sa jeunesse ni son inexpérience.",
      "start": 3605.547,
      "duration": 5.673
    },
    {
      "text": "Messieurs, la chose est entendue.",
      "start": 3621,
      "duration": 2.916
    },
    {
      "text": "Nous choisissons...",
      "start": 3623.916,
      "duration": 1.458
    },
    {
      "text": "Mozart!",
      "start": 3625.374,
      "duration": 0.486
    },
    {
      "text": "Merci.",
      "start": 3626,
      "duration": 0.399
    },
    {
      "text": "Rosenberg,",
      "start": 3626.399,
      "duration": 0.598
    },
    {
      "text": "vous suivrez cette affaire.",
      "start": 3626.997,
      "duration": 2.192
    },
    {
      "text": "Bien.",
      "start": 3629.189,
      "duration": 0.399
    },
    {
      "text": "Vous en serez le garant.",
      "start": 3629.588,
      "duration": 1.595
    },
    {
      "text": "Absolument.",
      "start": 3631.183,
      "duration": 0.797
    },
    {
      "text": "Et maintenant, fixons le jour de la première!",
      "start": 3632,
      "duration": 3.733
    },
    {
      "text": "Il a choisi Mozart!",
      "start": 3635.733,
      "duration": 1.634
    },
    {
      "text": "Il a choisi Mozart!",
      "start": 3637.367,
      "duration": 1.633
    },
    {
      "text": "Il a choisi Mozart!",
      "start": 3639,
      "duration": 1.468
    },
    {
      "text": "Ça y est?",
      "start": 3640.468,
      "duration": 0.629
    },
    {
      "text": "Elle a fini, la",
      "start": 3641.097,
      "duration": 1.259
    },
    {
      "text": "Castafiore?",
      "start": 3642.356,
      "duration": 1.049
    },
    {
      "text": "Pardon?",
      "start": 3643.405,
      "duration": 0.419
    },
    {
      "text": "Je vais le faire taire!",
      "start": 3643.824,
      "duration": 2.098
    },
    {
      "text": "Ça y est, c'est fini.",
      "start": 3645.922,
      "duration": 1.258
    },
    {
      "text": "Josepha!",
      "start": 3648,
      "duration": 0.5
    },
    {
      "text": "Oui?",
      "start": 3648.5,
      "duration": 0.5
    },
    {
      "text": "Tu changeras les draps",
      "start": 3649,
      "duration": 2.132
    },
    {
      "text": "de la chambre du 2e étage?",
      "start": 3651.132,
      "duration": 3.199
    },
    {
      "text": "Bien, maman.",
      "start": 3654.331,
      "duration": 1.422
    },
    {
      "text": "Constance?",
      "start": 3655.753,
      "duration": 1.066
    },
    {
      "text": "Constance!",
