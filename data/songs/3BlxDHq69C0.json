      "start": 5392.343,
      "duration": 1.828
    },
    {
      "text": "Viens leur crier la vérité",
      "start": 5394.171,
      "duration": 1.829
    },
    {
      "text": "Phoebus",
      "start": 5396,
      "duration": 1.3
    },
    {
      "text": "Dis-leur que je ne t'ai pas tué",
      "start": 5397.3,
      "duration": 5.85
    },
    {
      "text": "Phoebus",
      "start": 5405,
      "duration": 1.0
    },
    {
      "text": "Ce couteau que je possédais",
      "start": 5406.0,
      "duration": 4.0
    },
    {
      "text": "Je l'ai posé sur le plancher",
      "start": 5410.0,
