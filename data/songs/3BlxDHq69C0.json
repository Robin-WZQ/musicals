    },
    {
      "text": "Phoebus",
      "start": 5414,
      "duration": 0.889
    },
    {
      "text": "Cet homme en noir qui nous suivait",
      "start": 5414.889,
      "duration": 3.555
    },
    {
      "text": "Sur toi je l'ai vu se pencher",
      "start": 5418.444,
      "duration": 3.556
    },
    {
      "text": "Phoebus",
      "start": 5422,
      "duration": 1.3
    },
    {
      "text": "De mon couteau il t'a frappé",
