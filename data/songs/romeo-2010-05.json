  "cues": [
    {
      "text": "Être haï et trahi",
      "start": 871,
      "duration": 5.0
    },
    {
      "text": "Des amis, non, pas d’amis",
      "start": 876.0,
      "duration": 5.0
    },
    {
      "text": "Je suis seul, tant pis",
      "start": 881,
      "duration": 3.792
    },
    {
      "text": "Et ceux qui veulent être aimés à tout prix",
      "start": 884.792,
      "duration": 9.208
    },
    {
      "text": "Je les méprise, je les envie",
      "start": 894,
      "duration": 4.0
    },
    {
      "text": "Y’a que dans cette maison",
      "start": 898.0,
      "duration": 4.0
    },
    {
      "text": "Qu’j’ai le cœur tendre",
      "start": 902,
      "duration": 4.4
    },
    {
      "text": "Je n’ai que ce blason",
      "start": 906.4,
      "duration": 4.4
    },
    {
      "text": "À défendre",
      "start": 910.8,
      "duration": 2.2
    },
    {
      "text": "Tybalt, je suis Tybalt",
      "start": 913,
      "duration": 3.938
    },
    {
      "text": "On me déteste, on me craint",
      "start": 916.938,
      "duration": 5.062
    },
    {
      "text": "Mais au moins je suis quelqu’un Tybalt, je suis Tybalt",
      "start": 922,
      "duration": 6.875
    },
    {
      "text": "Je suis l’homme aux deux visages",
      "start": 928.875,
      "duration": 4.125
    },
    {
      "text": "Et quand je pleure",
      "start": 933,
      "duration": 8.909
    },
    {
      "text": "C’est de rage",
      "start": 941.909,
      "duration": 5.091
    },
    {
      "text": "Tybalt, je suis Tybalt",
      "start": 947,
      "duration": 3.938
    },
    {
      "text": "On me déteste, on me craint",
      "start": 950.938,
      "duration": 5.062
    },
    {
      "text": "Mais moi j’n’sens plus rien",
      "start": 956,
      "duration": 18.0
    },
    {
      "text": "Mais quand même,",
      "start": 974,
      "duration": 1.053
    },
    {
      "text": "Nourrice, me marier non mais quelle drôle d’idée !",
      "start": 975.053,
      "duration": 3.333
    },
    {
      "text": "Je suis trop jeune !",
      "start": 978.386,
      "duration": 1.228
    },
    {
      "text": "Jeune ?",
      "start": 979.614,
      "duration": 0.526
    },
    {
      "text": "Mais à ton âge, je faisais déjà crier mon mari de plaisir !",
      "start": 980.14,
      "duration": 3.86
    },
    {
      "text": "Tu étais mariée ?",
      "start": 984,
      "duration": 1.2
    },
    {
      "text": "Toi ?",
      "start": 985.2,
      "duration": 0.3
    },
    {
      "text": "Mais oui !",
      "start": 985.5,
      "duration": 0.75
    },
    {
      "text": "Oui mais tu l’aimais ton mari !",
      "start": 986.25,
      "duration": 1.95
    },
    {
      "text": "Mais Juliette, tu confonds tout !",
      "start": 988.2,
      "duration": 1.65
    },
    {
      "text": "L’amour n’est pas le mariage, et le mariage n’est pas l’amour !",
      "start": 989.85,
      "duration": 3.15
    },
    {
      "text": "Moi, je veux les deux !",
      "start": 993,
      "duration": 1.333
    },
    {
      "text": "Tu n’es qu’une enfant gâtée, hein ?",
      "start": 994.333,
      "duration": 2.0
    },
    {
      "text": "Oui, mais moi, je veux les deux !",
      "start": 996.333,
      "duration": 2.167
    },
    {
      "text": "Je veux, je veux",
      "start": 998.5,
      "duration": 1.0
    },
    {
      "text": "Laisse nous.",
      "start": 999.5,
      "duration": 0.833
    },
    {
      "text": "Juliette !",
      "start": 1000.333,
      "duration": 0.667
    },
    {
      "text": "Mère, je n’épouserai pas cet homme.",
      "start": 1001,
      "duration": 1.3
    },
    {
      "text": "Tu épouseras qui ton père te dira !",
      "start": 1002.3,
      "duration": 1.4
    },
    {
      "text": "Mais pourquoi me mettre dans le lit de ce sot bouffi d’orgueil ?",
      "start": 1003.7,
      "duration": 2.3
    },
    {
      "text": "Juliette, les femmes font depuis toujours ce que les hommes disent.",
      "start": 1006,
      "duration": 4.381
    },
    {
      "text": "C’est ainsi.",
      "start": 1010.381,
      "duration": 0.762
    },
    {
      "text": "Et que dois-je faire ?",
      "start": 1011.143,
      "duration": 1.714
    },
    {
      "text": "Obéir ?",
      "start": 1012.857,
      "duration": 0.572
    },
    {
      "text": "Oui !",
      "start": 1013.429,
      "duration": 0.571
    },
    {
      "text": "Et toi tu l’as fait ?",
      "start": 1014,
      "duration": 1.4
    },
    {
      "text": "Oui.",
      "start": 1015.4,
      "duration": 0.6
    }
