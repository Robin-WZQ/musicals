  "nativeCaptionAvailable": true,
  "isGenerated": false,
  "lyricsStorage": "user-provided",
  "cues": [
    {
      "text": "Trop de bruits pour trop de nuits qui pensent",
      "start": 2838,
      "duration": 12.74
    },
    {
      "text": "Quand valse l'absence",
      "start": 2852,
      "duration": 4.2
    },
    {
      "text": "Dans ce bal",
      "start": 2856.2,
      "duration": 1.8
    },
    {
      "text": "Ton silence est un cri qui fait mal",
      "start": 2858,
      "duration": 4.51
    },
    {
      "text": "Je devine",
      "start": 2862.51,
      "duration": 1.503
    },
    {
      "text": "Ton visage sur les ombres",
      "start": 2864.013,
      "duration": 3.007
    },
    {
      "text": "Mes souvenirs sombres",
      "start": 2868,
      "duration": 3.818
    },
    {
      "text": "M'assassinent",
      "start": 2871.818,
      "duration": 2.182
    },
    {
      "text": "Je dors sur des roses",
      "start": 2874,
      "duration": 3.692
    },
    {
      "text": "Qui signent ma croix",
      "start": 2877.692,
      "duration": 4.308
    },
    {
      "text": "La douleur s'impose",
      "start": 2882,
      "duration": 4.295
    },
    {
      "text": "Et je n'ose pas",
      "start": 2886.295,
      "duration": 2.685
    },
    {
      "text": "Manquer de toi",
      "start": 2890,
      "duration": 1.895
    },
    {
      "text": "Dans mes nuits",
      "start": 2891.895,
      "duration": 1.263
    },
    {
      "text": "Dans la pluie, dans les rires",
      "start": 2893.158,
      "duration": 2.842
    },
    {
      "text": "Dans le pire de ma vie",
      "start": 2896,
      "duration": 3.556
    },
    {
      "text": "Trop de bruit pour mon esprit qui tangue",
      "start": 2899.556,
      "duration": 6.223
    },
    {
      "text": "Sur mes rêves exsangues",
      "start": 2906,
      "duration": 4.295
    },
    {
      "text": "Drôle de danse",
      "start": 2910.295,
      "duration": 2.685
    },
    {
      "text": "La mémoire est un puits de souffrances",
      "start": 2913,
      "duration": 5.238
    },
    {
      "text": "Au-dessus de ton corps défendu",
      "start": 2918.238,
      "duration": 3.742
    },
    {
      "text": "Mon amour pendu",
      "start": 2922,
      "duration": 4.125
    },
    {
      "text": "Se balance",
      "start": 2926.125,
      "duration": 2.75
    },
    {
      "text": "Je dors sur des roses",
      "start": 2928.875,
      "duration": 4.125
    },
    {
      "text": "Qui signent ma croix",
      "start": 2933,
      "duration": 3.029
    },
    {
      "text": "La douleur s'impose",
      "start": 2936.029,
      "duration": 3.461
    },
    {
      "text": "Et je n'ose pas",
      "start": 2940,
      "duration": 2.917
    },
    {
      "text": "Effleurer les choses",
      "start": 2942.917,
      "duration": 4.083
    },
    {
      "text": "Écloses sans toi",
      "start": 2947,
      "duration": 4.788
    },
    {
      "text": "Ô ma rose",
      "start": 2951.788,
      "duration": 3.192
    },
    {
      "text": "Ne fane pas",
      "start": 2955,
      "duration": 2.133
    },
    {
      "text": "Je manque de toi",
      "start": 2957.133,
      "duration": 3.734
    },
    {
      "text": "Dans mes nuits",
      "start": 2960.867,
      "duration": 2.133
    },
    {
      "text": "Dans la pluie",
      "start": 2963,
      "duration": 1.947
    },
    {
      "text": "Dans les rires",
      "start": 2964.947,
      "duration": 1.558
    },
    {
      "text": "Dans le pire de ma vie",
      "start": 2966.505,
      "duration": 3.115
    },
    {
      "text": "Je hais les roses",
      "start": 3014,
      "duration": 3.334
    },
    {
      "text": "Autant",
      "start": 3017.334,
      "duration": 1.667
    },
    {
      "text": "Que mes sanglots",
      "start": 3019.001,
      "duration": 2.779
    },
    {
      "text": "La vie s'impose",
      "start": 3022,
      "duration": 2.744
    },
    {
      "text": "Je crois à nouveau",
      "start": 3024.744,
      "duration": 4.115
    },
    {
      "text": "À mes rêves défunts",
      "start": 3029,
      "duration": 4.364
    },
    {
      "text": "Je veux enfin",
      "start": 3033.364,
      "duration": 3.636
    },
    {
      "text": "Oser la fièvre",
      "start": 3037,
      "duration": 4.667
    },
    {
      "text": "Du parfum",
      "start": 3041.667,
      "duration": 2.333
    },
    {
      "text": "Des roses",
      "start": 3044,
      "duration": 50.46
    },
    {
      "text": "Alors, ça y est?",
      "start": 3120,
      "duration": 1.407
    },
    {
      "text": "C'est le départ.",
      "start": 3121.407,
      "duration": 1.126
    },
    {
      "text": "Oui, père.",
      "start": 3122.533,
      "duration": 1.407
    },
    {
      "text": "À Vienne, je vais enfin vivre parmi les musiciens, jouer dans les salons, composer.",
      "start": 3124,
      "duration": 6.0
    },
    {
      "text": "Non, Wolfgang, tu n'y vas pas pour ton plaisir, mais pour accompagner Colloredo au sacre du nouvel empereur.",
      "start": 3130,
      "duration": 7.87
    },
    {
      "text": "Contente-toi de lui obéir.",
      "start": 3139,
      "duration": 1.55
    },
    {
      "text": "Mais père, c'est ma nouvelle chance.",
      "start": 3143,
      "duration": 3.533
    },
    {
      "text": "Chance?",
      "start": 3146.533,
      "duration": 0.588
    },
    {
      "text": "Une chance!",
      "start": 3147.121,
      "duration": 1.178
    },
    {
      "text": "Mais tu as déjà eu toutes les chances.",
      "start": 3148.299,
      "duration": 4.121
    },
    {
      "text": "Et tu les as toutes ratées, tes voyages, tes rencontres, tout, jusqu'à ta mère.",
      "start": 3153,
      "duration": 4.765
    },
    {
      "text": "Tu l'as négligée!",
      "start": 3157.765,
      "duration": 1.059
    },
    {
      "text": "Non!",
      "start": 3158.824,
      "duration": 0.176
    },
    {
      "text": "Tu l'as laissée mourir.",
      "start": 3159,
      "duration": 1.875
    },
    {
      "text": "Tu m'as arraché la moitié de moi-même.",
      "start": 3160.875,
      "duration": 3.125
    },
    {
      "text": "Père, toute ma vie, j'ai travaillé dur pour que tu sois fier de moi.",
      "start": 3164,
      "duration": 7.5
    },
    {
      "text": "Et si je t'ai déçu, j'en suis désolé!",
      "start": 3172,
      "duration": 3.25
    },
    {
      "text": "Aujourd'hui, c'est fini.",
      "start": 3175.25,
      "duration": 2.25
    },
    {
      "text": "Wolfgang.",
      "start": 3177.5,
      "duration": 0.5
    },
    {
      "text": "Assez des brimades de ce tyran.",
      "start": 3178.0,
      "duration": 2.5
    },
    {
      "text": "Wolfgang!",
      "start": 3180.5,
      "duration": 0.5
    },
    {
      "text": "C'est fini!",
      "start": 3181,
      "duration": 0.957
    },
    {
      "text": "Cette fois, je vais à Vienne pour moi.",
      "start": 3181.957,
      "duration": 4.784
    },
    {
      "text": "Pour ma musique.",
      "start": 3186.741,
      "duration": 2.232
    },
    {
      "text": "Non, Mozart.",
      "start": 3188.973,
      "duration": 0.957
    },
    {
      "text": "Vous êtes à Vienne à mon service.",
      "start": 3190,
      "duration": 2.167
    },
    {
      "text": "Je vous interdis de vous produire ailleurs!",
      "start": 3192.167,
      "duration": 2.833
    },
    {
      "text": "Mais",
      "start": 3195,
      "duration": 0.548
    },
    {
      "text": "Votre Altesse, je voulais...",
      "start": 3195.548,
      "duration": 2.743
    },
    {
      "text": "À présent, retournez aux cuisines.",
      "start": 3198.291,
      "duration": 3.564
    },
    {
      "text": "Votre place est parmi les domestiques.",
      "start": 3201.855,
      "duration": 3.565
    },
    {
      "text": "Si le maestro veut bien s'asseoir!",
      "start": 3208,
      "duration": 3.128
    },
    {
      "text": "Le dîner est servi.",
      "start": 3211.128,
      "duration": 1.444
    },
    {
      "text": "Alors, tu n'apprécies pas notre compagnie?",
      "start": 3212.572,
      "duration": 3.368
    },
    {
      "text": "Qu'il est délicat, le musicien!",
      "start": 3216,
      "duration": 2.037
    },
    {
      "text": "Maintenant, tu vas boire à notre santé.",
      "start": 3218.037,
      "duration": 2.593
    },
    {
      "text": "Bois!",
      "start": 3220.63,
      "duration": 0.37
    }
  ],
