{
  "id": "mozart-2010-10",
  "title": "Je dors sur les roses",
  "titleZh": "我睡在玫瑰上",
  "titleOriginal": "Je dors sur les roses",
  "channel": "Hartwin",
  "channelId": "UCjgkRbhy8rPYbdeEV4637tg",
  "duration": 383,
  "musicalId": "mozart-opera-rock-2010",
  "trackNumber": 10,
