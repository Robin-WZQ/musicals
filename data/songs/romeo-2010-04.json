  "cues": [
    {
      "text": "Il a 30 ans, il est charmant",
      "start": 747,
      "duration": 3.684
    },
    {
      "text": "Aime votre enfant, donnez-la lui",
      "start": 750.684,
      "duration": 6.316
    },
    {
      "text": "Oui c’est un bon parti",
      "start": 757,
      "duration": 3.048
    },
    {
      "text": "A derrière lui, des princes, des rois",
      "start": 760.048,
      "duration": 4.952
    },
    {
      "text": "Il paiera vos dettes, et vous en avez",
      "start": 765,
      "duration": 4.667
    },
    {
      "text": "Il fera des fêtes, pour vous obliger",
      "start": 769.667,
      "duration": 4.333
    },
    {
      "text": "Mais à genoux je vous implore",
      "start": 774,
      "duration": 7.2
    },
    {
      "text": "Donnez-moi Juliette, car je l'adore",
      "start": 781.2,
      "duration": 7.8
    },
    {
      "text": "Cher ami, je suis surpris",
      "start": 789,
      "duration": 3.636
    },
    {
      "text": "Que votre amour soit aussi lourd",
      "start": 792.636,
      "duration": 6.364
    },
    {
      "text": "Lourde erreur prendre un cœur",
      "start": 799,
      "duration": 4.529
    },
    {
      "text": "Avant son heure",
      "start": 803.529,
      "duration": 2.471
    },
    {
      "text": "Je vous fais peur mais elle est si tendre",
      "start": 806,
      "duration": 4.091
    },
    {
      "text": "Il faudra attendre",
      "start": 810.091,
      "duration": 1.909
    },
    {
      "text": "Venez donc ce soir, vous pourrez la voir",
      "start": 812,
      "duration": 5.185
    },
    {
      "text": "Mais par pitié, au moins ayez",
      "start": 817.185,
      "duration": 4.815
    },
    {
      "text": "Un peu de patience, commencez par la danse",
      "start": 822,
      "duration": 6.207
    },
    {
      "text": "Mais moi, je pense, mais quand j'y pense",
      "start": 828.207,
      "duration": 5.793
    },
    {
      "text": "Lourde erreur, de prendre un cœur",
      "start": 834,
      "duration": 8.5
    },
    {
      "text": "Avant son heure, avant son heure",
      "start": 842.5,
      "duration": 8.5
    },
    {
      "text": "Tiens, Tybalt.",
      "start": 851,
      "duration": 0.947
    },
    {
      "text": "Encore toi !",
      "start": 851.947,
      "duration": 1.185
    },
    {
      "text": "Toujours là, chez moi !",
      "start": 853.132,
      "duration": 1.894
    },
    {
      "text": "Tu rôdes, tu épies, tu… tu t’ennuies Tybalt et tu m’ennuies !",
      "start": 855.026,
      "duration": 4.974
    },
    {
      "text": "Prends donc un peu de plaisir !",
      "start": 860,
      "duration": 3.462
    },
    {
      "text": "Le plaisir !",
      "start": 863.462,
      "duration": 1.538
    }
