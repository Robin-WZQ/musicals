  "cues": [
    {
      "text": "Don Juan...",
      "start": 369,
      "duration": 11.81
    },
    {
      "text": "Je le connais depuis longtemps.",
      "start": 382,
      "duration": 2.121
    },
    {
      "text": "Je le connais depuis toujours.",
      "start": 384.121,
      "duration": 2.546
    },
    {
      "text": "Qu'est-ce que je sais de lui?",
      "start": 386.667,
      "duration": 2.333
    },
    {
      "text": "Tout.",
      "start": 389,
      "duration": 1.405
    },
    {
      "text": "Rien.",
      "start": 390.405,
      "duration": 1.405
    },
    {
      "text": "S'il a souvent les yeux d'un ange",
      "start": 392,
      "duration": 3.742
    },
    {
      "text": "Il a le cœur noir du démon",
      "start": 395.742,
      "duration": 3.118
    },
    {
      "text": "Mais il a de façon étrange",
      "start": 400,
      "duration": 3.742
    },
    {
      "text": "Cette force de séduction",
      "start": 403.742,
      "duration": 3.368
    },
    {
      "text": "Cette assurance qui dérange",
      "start": 409,
      "duration": 2.948
    },
    {
      "text": "Cette envie qui ne veut pas mourir",
      "start": 411.948,
      "duration": 3.752
    },
    {
      "text": "Que tout doit lui appartenir",
      "start": 417,
      "duration": 3.84
    },
    {
      "text": "Je ne sais pas moi qui le connais",
      "start": 420.84,
      "duration": 4.16
    },
    {
      "text": "Si un cœur battait sous sa veste",
      "start": 425,
      "duration": 4.696
    },
    {
      "text": "Si ce n'est pas que je l'aimais",
      "start": 429.696,
      "duration": 4.304
    },
    {
      "text": "Il faudrait que je le déteste",
      "start": 434,
      "duration": 4.56
    },
    {
      "text": "Je ne pourrais pas l'oublier",
      "start": 438.56,
      "duration": 4.18
    },
    {
      "text": "Même si au fond je le voulais",
      "start": 443,
      "duration": 4.32
    },
    {
      "text": "Je l'aime autant que je le hais",
      "start": 447.32,
      "duration": 4.68
    },
    {
      "text": "L'homme qui a tout",
      "start": 452,
      "duration": 2.423
    },
    {
      "text": "Mais qui n'a rien",
      "start": 454.423,
      "duration": 2.423
    },
    {
      "text": "Celui qui veut tout posséder",
      "start": 456.846,
      "duration": 4.154
    },
    {
      "text": "Sans jamais pouvoir le garder",
      "start": 461,
      "duration": 3.418
    },
    {
      "text": "L'homme qui a tout",
      "start": 464.418,
      "duration": 2.175
    },
    {
      "text": "Mais qui ne voit rien",
      "start": 466.593,
      "duration": 2.797
    },
    {
      "text": "De l'amour qui passe à côté de lui",
      "start": 470,
      "duration": 4.0
    },
    {
      "text": "Sans jamais s'arrêter",
      "start": 474.0,
      "duration": 2.0
    },
    {
      "text": "S'il a souvent les yeux qui pleurent",
      "start": 476.0,
      "duration": 4.0
    },
    {
      "text": "Ce n'est jamais parce qu'il est triste",
      "start": 480,
      "duration": 4.174
    },
    {
      "text": "C'est que dans le rôle du menteur",
      "start": 484.174,
      "duration": 3.826
    },
    {
      "text": "Il est le meilleur des artistes",
      "start": 488,
      "duration": 3.826
    },
    {
      "text": "Mais même moi qui le connais",
      "start": 491.826,
      "duration": 4.174
    },
    {
      "text": "Je ne sais jamais où est l'acteur",
      "start": 496,
      "duration": 4.915
    },
    {
      "text": "Je l'aime autant que je le hais",
      "start": 500.915,
      "duration": 4.915
